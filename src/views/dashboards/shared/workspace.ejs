<span class="badge bad"><i class="fa-solid fa-triangle-exclamation"></i> Archive action</span>
<strong id="deleteText">Are you sure you want to archive this record?</strong>
<p style="margin:0;color:var(--muted);font-size:12px;font-weight:800;line-height:1.55">Soft delete keeps the record recoverable and writes the action to audit logs.</p>
<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end">
<button class="btn" data-close-modal>Cancel</button>
<form id="deleteForm" method="POST" action="" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn btnDanger" id="confirmDelete" type="submit"><i class="fa-solid fa-box-archive"></i> Archive</button></form>
</div>
</div>
</div>
</div>
</div>
<div class="toast" id="toast"><i class="fa-solid fa-circle-check"></i><span id="toastText">Done</span></div>
<%
const staticDashboardSectionIds = new Set([
'overview','analytics','bookings','partners','listings','routes','vehicles','schedules',
'company-profile','staff','seat-maps','hotel-rooms','manifests','checkins','reviews',
'revenue','settlement','payments','promoters','customers','support','ads','reports',
'audit','admins','kyc','refunds','handover','profile','notifications','archive','system','settings',
'ticket','saved','passengers','receipts','wallet','security',
'links','share','campaigns','performance','offline-sales','fraud','commissions','withdrawals','payouts',
'driver-ops','driver-manifest','driver-incidents',
'bus-dashboard','hotel-dashboard','flight-dashboard','taxi-dashboard',
'flight-setup','flight-routes','flight-seat-maps','flight-fares','flight-departures','flight-manifests','flight-operations',
'taxi-fleet','taxi-drivers','taxi-zones','taxi-fares','taxi-dispatch','taxi-operations','taxi-incidents',
'setup-guide','workflow-guide','blogs','verification',
'flight-agents','boda-riders','car-drivers','fleet-owners','mobility-companies',
'mobility-drivers','mobility-vehicles','mobility-dispatch','mobility-safety',
'flight-search','flight-quotes','flight-travelers','flight-tickets','flight-changes','flight-refunds',
'taxi-availability',
'customer-refunds','customer-support','customer-reviews','customer-notifications','customer-profile',
'promoter-support','promoter-profile',
'schedule','inventory','checkin','manifest','shift','shift-handover','my-profile','settlements'
]);
const seenDynamicDashboardPages = new Set();
const dynamicDashboardItems = [];
(shellGroups || []).forEach(function(group){
(group.items || []).forEach(function(item){
if (!item || !item.page || staticDashboardSectionIds.has(item.page) || seenDynamicDashboardPages.has(item.page)) return;
seenDynamicDashboardPages.add(item.page);
dynamicDashboardItems.push({
page: item.page,
label: item.label || item.page,
icon: item.icon || 'fa-circle',
group: group.label || 'Dashboard'
});
});
});
function dynamicActionHref(page){
const role = dashboardRoleKey || 'admin';
if (role === 'customer') {
if (page === 'ticket') return '/account/bookings';
if (page === 'saved') return '/search';
if (page === 'passengers') return '/account/passengers';
if (page === 'receipts') return '/account/reports/receipts.csv';
if (page === 'refunds') return '/account/refunds';
if (page === 'support') return '/account/support';
return '/account/' + page;
}
if (role === 'promoter') {
if (page === 'links') return '/promoter/links';
if (page === 'commissions') return '/promoter/commissions';
if (page === 'withdrawals') return '/promoter/withdrawals';
if (page === 'offline-sales') return '/promoter/offline-sales';
return '/promoter/' + page;
}
if (role === 'employee') return '/employee/dashboard/' + page;
if (role === 'driver') return '/driver/dashboard/' + page;
if (role === 'support') return '/support/dashboard/' + page;
if (role === 'finance') return '/finance/dashboard/' + page;
if (role === 'operations') return '/operations/dashboard/' + page;
return '#'+page;
}
%>
<% dynamicDashboardItems.filter(function(item){ return isActiveDashboardPage(item.page); }).forEach(function(item){ const employeeDynamicActions = { bookings:'booking', schedule:'delay notice', inventory:'inventory', payments:'payment', refunds:'refund', support:'support notice', handover:'handover', profile:'profile' }; const employeeDynamicAction = isEmployeeDashboard ? employeeDynamicActions[item.page] : ''; const employeeDynamicLabel = item.page === 'profile' ? 'Save profile' : item.page === 'handover' ? 'Create handover' : item.page === 'schedule' ? 'Send delay notice' : item.page === 'inventory' ? 'Update inventory' : item.page === 'payments' ? 'Record payment' : item.page === 'refunds' ? 'Request refund' : item.page === 'support' ? 'Create support notice' : 'Create booking'; %>
<%- include('sections/dynamic-page', Object.assign({}, sectionLocals, { item, employeeDynamicAction, employeeDynamicLabel, dynamicActionHref })) %>
<% }) %>
<script nonce="<%= cspNonce %>" id="dashboardWorkspaceBootstrap" type="application/json"><%- toScriptJson({ dashboardData: browserDashboardData || {}, shell: dashboardShell || {}, csrfToken: csrfToken || '', flashMessages: flashMessages || [], platformConfig: platformConfig || {}, countryMarkets: countryMarkets || [] }) %></script>
<script src="/js/pwa.js?v=20260727-3" defer></script>
<script src="/js/dashboard-workspace.js?v=1.6.7" defer></script>
</body>
</html>
