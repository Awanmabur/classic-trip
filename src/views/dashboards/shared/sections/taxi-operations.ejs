<%
  const taxiListings = dashboardData?.options?.taxiListings || [];
  const taxiZones = dashboardData?.taxiServiceZones || [];
  const taxiVehicles = dashboardData?.taxiVehicles || [];
  const taxiFares = dashboardData?.taxiFareRules || [];
  const taxiRides = dashboardData?.taxiRides || [];
  const staffOptions = dashboardData?.options?.staff || [];
  const activeRideStatuses = ['searching_driver','assigned','accepted','driver_arriving','arrived','in_progress'];
  const taxiPermissions = new Set(dashboardData?.permissions || []);
  const canConfigureTaxi = isCompanyDashboard;
  const canDispatchTaxi = isCompanyDashboard || taxiPermissions.has('*') || taxiPermissions.has('taxi.dispatch');
  const canUpdateTaxiRide = isCompanyDashboard || taxiPermissions.has('*') || taxiPermissions.has('taxi.ride.update');
  const canManageTaxiFleet = isCompanyDashboard || taxiPermissions.has('*') || taxiPermissions.has('taxi.fleet.manage');
  const taxiRouteBase = isEmployeeDashboard ? '/employee/taxi' : '/company/taxi';
%>
<section class="section" id="taxi-operations">
  <div class="card">
    <div class="cardHead"><div class="cardTitle"><span class="hotelSectionEyebrow"><i class="fa-solid fa-taxi"></i> Local taxi operations</span><h3>Zones, fleet, fares and secure dispatch</h3><p>Complete the connected setup in order: public listing → service zone → active vehicle and verified driver → fare rule → paid ride → dispatch → pickup PIN → completion.</p></div><% if (canDispatchTaxi) { %><form action="<%= taxiRouteBase %>/dispatch" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-satellite-dish"></i> Run dispatch now</button></form><% } %></div>
    <div class="hotelOpsNudge" style="padding:0 16px 16px"><div class="metricTile"><strong><%= taxiZones.length %></strong><span>Service zones</span></div><div class="metricTile"><strong><%= taxiVehicles.filter(function(row){return row.status==='active';}).length %></strong><span>Active vehicles</span></div><div class="metricTile"><strong><%= taxiFares.filter(function(row){return row.status==='active';}).length %></strong><span>Fare rules</span></div><div class="metricTile"><strong><%= taxiRides.filter(function(row){return activeRideStatuses.includes(row.status);}).length %></strong><span>Active rides</span></div></div>
  </div>

  <% if (canConfigureTaxi) { %>
  <div class="grid2" style="margin-top:16px;align-items:start">
    <div class="card"><div class="cardHead"><div class="cardTitle"><h3>Add service zone</h3><p>Use a radius for Kampala, Juba or another city; national and intercity zones can cover wider operations.</p></div></div><form class="cardPad" method="post" action="/company/taxi/zones"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="row2"><div class="field"><label>Zone name</label><div class="control"><i class="fa-solid fa-map"></i><input name="name" required placeholder="Kampala metro"></div></div><div class="field"><label>Zone type</label><div class="control"><i class="fa-solid fa-draw-polygon"></i><select name="zoneType"><option value="radius">Radius</option><option value="national">National</option><option value="intercity">Intercity</option></select></div></div></div><div class="row2"><div class="field"><label>Country</label><div class="control"><i class="fa-solid fa-earth-africa"></i><input name="country" required value="<%= dashboardData?.company?.country || 'Uganda' %>"></div></div><div class="field"><label>City / district</label><div class="control"><i class="fa-solid fa-location-dot"></i><input name="cityOrDistrict" required></div></div></div><div class="row2"><div class="field"><label>Center latitude</label><div class="control"><i class="fa-solid fa-map-pin"></i><input type="number" step="0.000001" name="centerLatitude"></div></div><div class="field"><label>Center longitude</label><div class="control"><i class="fa-solid fa-map-pin"></i><input type="number" step="0.000001" name="centerLongitude"></div></div></div><div class="row2"><div class="field"><label>Radius km</label><div class="control"><i class="fa-solid fa-ruler"></i><input type="number" min="0" step="0.1" name="radiusKm" value="30"></div></div><div class="field"><label>Airport codes</label><div class="control"><i class="fa-solid fa-plane"></i><input name="airportCodes" placeholder="EBB, KGL"></div></div></div><button class="btn btnBlue"><i class="fa-solid fa-plus"></i> Add zone</button></form></div>

    <div class="card"><div class="cardHead"><div class="cardTitle"><h3>Add taxi vehicle</h3><p>Only active, inspected and insured vehicles are eligible for dispatch.</p></div></div><form class="cardPad" method="post" action="/company/taxi/vehicles"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="row2"><div class="field"><label>Registration</label><div class="control"><i class="fa-solid fa-id-card"></i><input name="registrationNumber" required></div></div><div class="field"><label>Class</label><div class="control"><i class="fa-solid fa-car-side"></i><select name="vehicleClass"><option value="boda">Boda</option><option value="economy">Economy</option><option value="comfort">Comfort</option><option value="premium">Premium</option><option value="suv">SUV</option><option value="van">Van</option><option value="minibus">Minibus</option></select></div></div></div><div class="row2"><div class="field"><label>Make</label><div class="control"><i class="fa-solid fa-car"></i><input name="make" required></div></div><div class="field"><label>Model</label><div class="control"><i class="fa-solid fa-car-rear"></i><input name="modelName" required></div></div></div><div class="row2"><div class="field"><label>Year</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="number" min="1990" max="2100" name="year"></div></div><div class="field"><label>Color</label><div class="control"><i class="fa-solid fa-palette"></i><input name="color"></div></div></div><div class="row2"><div class="field"><label>Passengers</label><div class="control"><i class="fa-solid fa-users"></i><input type="number" min="1" max="30" name="passengerCapacity" value="4"></div></div><div class="field"><label>Luggage pieces</label><div class="control"><i class="fa-solid fa-suitcase"></i><input type="number" min="0" name="luggageCapacity" value="2"></div></div></div><div class="row2"><div class="field"><label>Inspection expires</label><div class="control"><i class="fa-solid fa-clipboard-check"></i><input type="date" name="inspectionExpiresAt"></div></div><div class="field"><label>Insurance expires</label><div class="control"><i class="fa-solid fa-shield-halved"></i><input type="date" name="insuranceExpiresAt"></div></div></div><div class="checkLine"><label><input type="checkbox" name="wheelchairAccessible"> Wheelchair accessible</label></div><div class="field"><label>Preferred verified driver</label><div class="control"><i class="fa-solid fa-user-tie"></i><select name="assignedDriverId"><option value="">Dispatch can choose automatically</option><% staffOptions.forEach(function(row){ %><option value="<%= row.id %>"><%= row.label %></option><% }) %></select></div></div><button class="btn btnBlue"><i class="fa-solid fa-plus"></i> Add vehicle</button></form></div>
  </div>

  <div class="card" style="margin-top:16px"><div class="cardHead"><div class="cardTitle"><h3>Add fare rule</h3><p>Traveler quotes are calculated again on the server from these rules, signed, and expire after ten minutes.</p></div></div><form class="cardPad" method="post" action="/company/taxi/fares"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="row2"><div class="field"><label>Public taxi listing</label><div class="control"><i class="fa-solid fa-layer-group"></i><select name="listingId" required><option value="">Choose listing</option><% taxiListings.forEach(function(row){ %><option value="<%= row.id %>"><%= row.label %></option><% }) %></select></div></div><div class="field"><label>Service zone</label><div class="control"><i class="fa-solid fa-map-location-dot"></i><select name="serviceZoneId"><option value="">No zone restriction</option><% taxiZones.filter(function(row){return row.status==='active';}).forEach(function(row){ %><option value="<%= row.id %>"><%= row.name %> · <%= row.cityOrDistrict %></option><% }) %></select></div></div></div><div class="row2"><div class="field"><label>Fare name</label><div class="control"><i class="fa-solid fa-tag"></i><input name="name" required placeholder="Kampala Economy"></div></div><div class="field"><label>Ride type</label><div class="control"><i class="fa-solid fa-route"></i><select name="serviceType"><option value="immediate">Immediate</option><option value="scheduled">Scheduled</option><option value="airport_transfer">Airport transfer</option><option value="intercity">Intercity</option><option value="hourly">Hourly hire</option></select></div></div></div><div class="row2"><div class="field"><label>Vehicle class</label><div class="control"><i class="fa-solid fa-car-side"></i><select name="vehicleClass"><option value="boda">Boda</option><option value="economy">Economy</option><option value="comfort">Comfort</option><option value="premium">Premium</option><option value="suv">SUV</option><option value="van">Van</option><option value="minibus">Minibus</option></select></div></div><div class="field"><label>Currency</label><div class="control"><i class="fa-solid fa-coins"></i><input name="currency" maxlength="3" value="<%= dashboardData?.company?.operatingCurrency || platformConfig.defaultCurrency %>" required></div></div></div><div class="row2"><div class="field"><label>Base fare</label><div class="control"><i class="fa-solid fa-money-bill"></i><input type="number" min="0" step="0.01" name="baseFare" required></div></div><div class="field"><label>Per kilometre</label><div class="control"><i class="fa-solid fa-road"></i><input type="number" min="0" step="0.01" name="perKilometre" required></div></div></div><div class="row2"><div class="field"><label>Per minute</label><div class="control"><i class="fa-solid fa-clock"></i><input type="number" min="0" step="0.01" name="perMinute" value="0"></div></div><div class="field"><label>Minimum fare</label><div class="control"><i class="fa-solid fa-scale-balanced"></i><input type="number" min="0" step="0.01" name="minimumFare" value="0"></div></div></div><div class="row2"><div class="field"><label>Booking fee</label><div class="control"><i class="fa-solid fa-receipt"></i><input type="number" min="0" step="0.01" name="bookingFee" value="0"></div></div><div class="field"><label>Airport surcharge</label><div class="control"><i class="fa-solid fa-plane"></i><input type="number" min="0" step="0.01" name="airportSurcharge" value="0"></div></div></div><div class="row2"><div class="field"><label>Night surcharge %</label><div class="control"><i class="fa-solid fa-moon"></i><input type="number" min="0" max="500" step="0.1" name="nightSurchargePercent" value="0"></div></div><div class="field"><label>Cancellation fee</label><div class="control"><i class="fa-solid fa-ban"></i><input type="number" min="0" step="0.01" name="cancellationFee" value="0"></div></div></div><button class="btn btnBlue"><i class="fa-solid fa-plus"></i> Add fare rule</button></form></div>

  <% } %>

  <div class="grid2" style="margin-top:16px;align-items:start"><div class="card"><div class="cardHead"><div class="cardTitle"><h3>Fleet</h3><p>Activation makes a vehicle available to atomic dispatch.</p></div></div><div class="tableWrap"><table><thead><tr><th>Vehicle</th><th>Class</th><th>Capacity</th><th>Driver</th><th>Status</th><th></th></tr></thead><tbody><% taxiVehicles.forEach(function(row){ const driver=staffOptions.find(function(item){return item.id===row.assignedDriverId;}); %><tr><td><strong><%= row.registrationNumber %></strong><br><small><%= row.make %> <%= row.modelName %></small></td><td><%= row.vehicleClass %></td><td><%= row.passengerCapacity %> pax · <%= row.luggageCapacity %> bags</td><td><%= driver?.label || 'Auto dispatch' %></td><td><span class="badge <%= row.status==='active'?'ok':'info' %>"><%= row.status %></span></td><td><% if (canManageTaxiFleet) { %><form method="post" action="<%= taxiRouteBase %>/vehicles/<%= encodeURIComponent(row.id) %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="status" value="<%= row.status==='active'?'maintenance':'active' %>"><button class="tinyBtn"><i class="fa-solid <%= row.status==='active'?'fa-screwdriver-wrench':'fa-circle-check' %>"></i></button></form><% } else { %><span class="muted">Read only</span><% } %></td></tr><% }) %><% if(!taxiVehicles.length){ %><tr><td colspan="6" class="empty">No taxi vehicles created.</td></tr><% } %></tbody></table></div></div><div class="card"><div class="cardHead"><div class="cardTitle"><h3>Fare rules</h3><p>One listing can have distinct rules per ride type and vehicle class.</p></div></div><div class="tableWrap"><table><thead><tr><th>Name</th><th>Service</th><th>Class</th><th>Base</th><th>Distance</th><th>Status</th></tr></thead><tbody><% taxiFares.forEach(function(row){ %><tr><td><strong><%= row.name %></strong></td><td><%= row.serviceType %></td><td><%= row.vehicleClass %></td><td><%= row.currency %> <%= Number(row.baseFare||0).toLocaleString() %></td><td><%= row.currency %> <%= Number(row.perKilometre||0).toLocaleString() %>/km</td><td><span class="badge ok"><%= row.status %></span></td></tr><% }) %><% if(!taxiFares.length){ %><tr><td colspan="6" class="empty">No fare rules created.</td></tr><% } %></tbody></table></div></div></div>

  <div class="card" style="margin-top:16px">
    <div class="cardHead"><div class="cardTitle"><h3>Ride dispatch board</h3><p>Only successfully paid rides enter dispatch. Capacity, accessibility and tenant ownership are checked again before atomic assignment. Every status change is audited.</p></div></div>
    <div class="tableWrap"><table>
      <thead><tr><th>Ride</th><th>Route</th><th>Pickup time</th><th>Requirements</th><th>Assignment</th><th>Fare</th><th>Status</th><th>Operation</th></tr></thead>
      <tbody>
      <% taxiRides.forEach(function(row){
        const pickup=(row.stops||[])[0]||{};
        const destination=(row.stops||[])[(row.stops||[]).length-1]||{};
        const driver=staffOptions.find(function(item){return item.id===row.assignedDriverId;});
        const vehicle=taxiVehicles.find(function(item){return item.id===row.assignedVehicleId;});
        const transitions = row.status === 'assigned' ? ['accepted','cancelled'] : row.status === 'accepted' ? ['driver_arriving','cancelled'] : row.status === 'driver_arriving' ? ['arrived','cancelled'] : row.status === 'arrived' ? ['in_progress','customer_no_show','cancelled'] : row.status === 'in_progress' ? ['completed','cancelled'] : [];
      %>
        <tr>
          <td><strong><%= row.rideRef %></strong><br><small><%= row.bookingRef %> · <%= row.serviceType %></small></td>
          <td><strong><%= pickup.address || '-' %></strong><br><small>to <%= destination.address || '-' %></small></td>
          <td><%= new Date(row.requestedPickupAt).toLocaleString() %><br><small><%= Number(row.estimatedDistanceKm||0).toFixed(1) %> km · <%= row.estimatedDurationMinutes || 0 %> min</small></td>
          <td><%= row.passengerCount || 1 %> pax · <%= row.luggageCount || 0 %> bags<br><small><%= row.wheelchairRequired ? 'Wheelchair vehicle required' : row.vehicleClass %><%= row.childSeatCount ? ` · ${row.childSeatCount} child seat(s)` : '' %></small></td>
          <td><%= driver?.label || 'Searching' %><br><small><%= vehicle?.registrationNumber || 'No vehicle yet' %></small></td>
          <td><%= row.pricing?.currency || '' %> <%= Number(row.pricing?.total||0).toLocaleString() %></td>
          <td><span class="badge <%= row.status==='completed'?'ok':row.status==='cancelled'?'danger':'info' %>"><%= row.status %></span></td>
          <td>
            <% if(canUpdateTaxiRide && transitions.length){ %>
              <form method="post" action="<%= taxiRouteBase %>/rides/<%= encodeURIComponent(row.rideRef) %>/status" class="inlineOpsForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
                <select name="status" required><option value="">Next state</option><% transitions.forEach(function(status){ %><option value="<%= status %>"><%= status.replaceAll('_',' ') %></option><% }) %></select>
                <% if(row.status==='arrived'){ %><input name="pickupPin" inputmode="numeric" minlength="4" maxlength="4" placeholder="Pickup PIN"><% } %>
                <input name="note" maxlength="500" placeholder="Operation note / cancellation reason">
                <button class="tinyBtn" type="submit"><i class="fa-solid fa-arrow-right"></i></button>
              </form>
            <% } else if(['requested','searching_driver'].includes(row.status)){ %><span class="muted">Awaiting dispatch</span><% } else { %><span class="muted">Final state</span><% } %>
          </td>
        </tr>
      <% }) %>
      <% if(!taxiRides.length){ %><tr><td colspan="8" class="empty">No rides yet. Paid traveler bookings will appear here automatically; unpaid or failed attempts are not retained as confirmed rides.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
</section>
