<%
  const adminCompanies = dashboardData?.companyRecords || [];
  const adminListings = dashboardData?.marketplaceListings || [];
  const adminAirports = dashboardData?.airports || [];
  const adminAgencyProfiles = dashboardData?.flightAgencyProfiles || [];
  const adminSupplierAccesses = dashboardData?.flightSupplierAccesses || [];
  const adminFlightSuppliers = dashboardData?.flightSuppliers || [];
  const adminFlightOffers = dashboardData?.flightDepartures || [];
  const adminTaxiVehicles = dashboardData?.taxiVehicles || [];
  const adminTaxiZones = dashboardData?.taxiServiceZones || [];
  const adminTaxiFares = dashboardData?.taxiFareRules || [];
  const adminTaxiRides = dashboardData?.taxiRides || [];
  const flightAgencyCompanies = adminCompanies.filter(function(row){ return String(row.companyType || row.serviceType || '').toLowerCase() === 'flight'; });
  const taxiFleetCompanies = adminCompanies.filter(function(row){ return String(row.companyType || row.serviceType || '').toLowerCase() === 'local_transport'; });
  const flightStorefronts = adminListings.filter(function(row){ return row.serviceType === 'flight' && row.listingKind === 'agency_storefront'; });
  const taxiMarketplaces = adminListings.filter(function(row){ return row.serviceType === 'local_transport' && row.listingKind === 'ride_hailing_marketplace' && String(row.companyId) === 'platform'; });
  const taxiFleetProfiles = adminListings.filter(function(row){ return row.serviceType === 'local_transport' && row.listingKind === 'fleet_partner_profile'; });
  const adminCompanyById = function(id){ return adminCompanies.find(function(row){ return String(row.id || row._id) === String(id); }) || {}; };
  const adminListingById = function(id){ return adminListings.find(function(row){ return String(row.id || row._id) === String(id); }) || {}; };
  const adminSupplierById = function(id){ return adminFlightSuppliers.find(function(row){ return String(row.id || row._id) === String(id); }) || {}; };
  const adminZoneById = function(id){ return adminTaxiZones.find(function(row){ return String(row.id || row._id) === String(id); }) || {}; };
  const pretty = function(value){ return String(value || '-').replaceAll('_', ' '); };
  const dateText = function(value){ if(!value) return '-'; const d = new Date(value); return Number.isNaN(d.getTime()) ? '-' : d.toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }); };
  const badgeTone = function(status){ const value = String(status || '').toLowerCase(); return ['approved','active','published','completed'].includes(value) ? 'ok' : ['rejected','suspended','cancelled','failed'].includes(value) ? 'danger' : ['changes_required','pending','submitted','under_review','pending_verification','dispatching','delayed'].includes(value) ? 'warn' : 'info'; };
%>

<section class="section" id="travel-marketplace">
  <div class="serviceAdminIntro">
    <div><span class="hotelSectionEyebrow"><i class="fa-solid fa-tower-broadcast"></i> Platform-owned marketplace control</span><h2>Flight agency and ride-hailing governance</h2><p>Centralise supplier contracts, agency permissions, taxi coverage, fare policy, safety approvals and dispatch intervention here. Provider dashboards receive only the authority required for their role.</p></div>
    <div class="serviceAdminIntroStats"><span><strong><%= flightAgencyCompanies.length %></strong> agencies</span><span><strong><%= taxiFleetCompanies.length %></strong> fleets</span><span><strong><%= adminTaxiRides.filter(function(row){ return ['dispatching','assigned','driver_arriving','arrived','in_progress'].includes(row.status); }).length %></strong> live rides</span></div>
  </div>

  <div class="serviceAdminColumns">
    <div class="serviceAdminColumn">
      <div class="card serviceWorkspaceCard">
        <div class="cardHead serviceWorkspaceHeader"><div class="cardTitle"><span class="hotelSectionEyebrow"><i class="fa-solid fa-plane"></i> Flight distribution</span><h3>Platform suppliers and agency authority</h3><p>Agents sell and service supplier-confirmed travel. They never act as operating airlines.</p></div><span class="badge info"><%= adminFlightSuppliers.length %> suppliers</span></div>

        <div class="serviceControlGrid cardPad">
          <form class="serviceControlPanel" method="post" action="/admin/travel-marketplace/flights/airports/bootstrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>East Africa airport catalogue</strong><span>Refresh the canonical airport records used by supplier offers.</span></div><span class="badge info"><%= adminAirports.length %> airports</span></div>
            <div class="serviceFormActions"><button class="btn" type="submit"><i class="fa-solid fa-rotate"></i> Refresh airport catalogue</button></div>
          </form>

          <form class="serviceControlPanel" method="post" action="/admin/travel-marketplace/flights/suppliers">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Create platform supplier</strong><span>External modes require a registered adapter and secret reference.</span></div><span class="badge warn">Platform only</span></div>
            <div class="formGrid">
              <div class="field"><label>Supplier name</label><div class="control"><i class="fa-solid fa-building-shield"></i><input name="name" maxlength="180" required></div></div>
              <div class="field"><label>Supplier code</label><div class="control"><i class="fa-solid fa-hashtag"></i><input name="supplierCode" maxlength="30" required></div></div>
              <div class="field"><label>Distribution mode</label><div class="control"><i class="fa-solid fa-plug"></i><select name="mode"><option value="contracted_allotment">Contracted allotment</option><option value="airline_api">Airline API</option><option value="gds">GDS</option><option value="ndc">NDC aggregator</option><option value="consolidator">Consolidator</option><option value="referral">Referral only</option></select></div></div>
              <div class="field"><label>Supplier category</label><div class="control"><i class="fa-solid fa-tags"></i><select name="supplierCategory"><option value="allotment_partner">Allotment partner</option><option value="airline">Airline</option><option value="gds">GDS</option><option value="ndc_aggregator">NDC aggregator</option><option value="consolidator">Consolidator</option></select></div></div>
              <div class="field"><label>Adapter key</label><div class="control"><i class="fa-solid fa-code-branch"></i><input name="adapterKey" maxlength="120" placeholder="Required for external modes"></div></div>
              <div class="field"><label>Secret reference</label><div class="control"><i class="fa-solid fa-vault"></i><input name="credentialsSecretRef" maxlength="240" placeholder="secrets/flight/supplier"></div></div>
              <div class="field"><label>Status</label><div class="control"><i class="fa-solid fa-toggle-on"></i><select name="status"><option value="active">Active</option><option value="pending_verification">Pending verification</option><option value="draft">Draft</option></select></div></div>
              <div class="field"><label>Internal notes</label><div class="control"><i class="fa-solid fa-note-sticky"></i><input name="notes" maxlength="1000"></div></div>
            </div>
            <label class="checkRow"><input type="checkbox" name="ticketingEnabled" checked> Supplier ticketing enabled</label>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-plus"></i> Create supplier</button></div>
          </form>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Supplier registry</h4><p>Credentials remain in the secrets manager; this table stores only the adapter reference and commercial state.</p></div></div>
          <div class="tableWrap"><table><thead><tr><th>Supplier</th><th>Mode</th><th>Category</th><th>Adapter</th><th>Ticketing</th><th>Status</th></tr></thead><tbody>
          <% if(adminFlightSuppliers.length){ adminFlightSuppliers.forEach(function(row){ %><tr><td><strong><%= row.name %></strong><small class="tableSub"><%= row.supplierCode %></small></td><td><%= pretty(row.mode) %></td><td><%= pretty(row.supplierCategory) %></td><td><%= row.adapterKey || (row.mode === 'contracted_allotment' ? 'Built-in allotment' : 'Not connected') %></td><td><span class="badge <%= row.ticketingEnabled ? 'ok' : 'warn' %>"><%= row.ticketingEnabled ? 'Enabled' : 'Disabled' %></span></td><td><span class="badge <%= badgeTone(row.status) %>"><%= pretty(row.status) %></span></td></tr><% }) } else { %><tr class="emptyTableRow"><td colspan="6"><div class="emptyTableState"><i class="fa-solid fa-building-circle-xmark"></i><div><strong>No platform supplier</strong><span>Create a contracted allotment or connect a certified supplier adapter before granting agency access.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>

        <div class="serviceControlGrid cardPad">
          <form class="serviceControlPanel" method="post" action="<%= flightAgencyCompanies.length ? '/admin/travel-marketplace/flights/agencies/' + (flightAgencyCompanies[0].id || flightAgencyCompanies[0]._id) + '/review' : '#' %>" data-action-template="/admin/travel-marketplace/flights/agencies/{companyId}/review" data-company-action-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Review agency compliance</strong><span>Company verification must already be approved.</span></div><span class="badge warn">Compliance</span></div>
            <div class="formGrid">
              <div class="field"><label>Flight agency</label><div class="control"><i class="fa-solid fa-building-user"></i><select name="companyId" required data-company-action-select><option value="">Select agency</option><% flightAgencyCompanies.forEach(function(row){ const profile = adminAgencyProfiles.find(function(item){ return String(item.companyId) === String(row.id || row._id); }) || {}; %><option value="<%= row.id || row._id %>"><%= row.name %> · <%= pretty(profile.status || 'profile missing') %></option><% }) %></select></div></div>
              <div class="field"><label>Decision</label><div class="control"><i class="fa-solid fa-gavel"></i><select name="status"><option value="approved">Approve</option><option value="changes_required">Changes required</option><option value="rejected">Reject</option><option value="suspended">Suspend</option></select></div></div>
              <div class="field fieldFull"><label>Review notes</label><div class="control"><i class="fa-solid fa-message"></i><input name="reviewNotes" maxlength="1000" required></div></div>
            </div>
            <div class="servicePermissionChecks"><label class="checkRow"><input type="checkbox" name="ticketingAuthorityApproved"> Ticketing authority</label><label class="checkRow"><input type="checkbox" name="canServiceChanges"> Change servicing</label><label class="checkRow"><input type="checkbox" name="canRequestRefunds" checked> Refund requests</label></div>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit" <%= flightAgencyCompanies.length ? '' : 'disabled' %>><i class="fa-solid fa-check-double"></i> Save agency decision</button></div>
          </form>

          <form class="serviceControlPanel" method="post" action="<%= flightAgencyCompanies.length ? '/admin/travel-marketplace/flights/agencies/' + (flightAgencyCompanies[0].id || flightAgencyCompanies[0]._id) + '/supplier-access' : '#' %>" data-action-template="/admin/travel-marketplace/flights/agencies/{companyId}/supplier-access" data-company-action-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Grant supplier access</strong><span>Apply least privilege per agency and supplier contract.</span></div><span class="badge info">RBAC + commercial scope</span></div>
            <div class="formGrid">
              <div class="field"><label>Approved agency</label><div class="control"><i class="fa-solid fa-building-user"></i><select name="companyId" required data-company-action-select><option value="">Select agency</option><% flightAgencyCompanies.forEach(function(row){ const profile = adminAgencyProfiles.find(function(item){ return String(item.companyId) === String(row.id || row._id); }) || {}; if(profile.status === 'approved'){ %><option value="<%= row.id || row._id %>"><%= row.name %></option><% } }) %></select></div></div>
              <div class="field"><label>Active supplier</label><div class="control"><i class="fa-solid fa-link"></i><select name="supplierId" required><option value="">Select supplier</option><% adminFlightSuppliers.filter(function(row){ return row.status === 'active'; }).forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.name %> · <%= pretty(row.mode) %></option><% }) %></select></div></div>
              <div class="field"><label>Commission %</label><div class="control"><i class="fa-solid fa-percent"></i><input type="number" name="commissionPercent" min="0" max="100" step="0.01" value="0"></div></div>
              <div class="field"><label>Markup cap %</label><div class="control"><i class="fa-solid fa-arrow-trend-up"></i><input type="number" name="markupCapPercent" min="0" max="100" step="0.01" value="0"></div></div>
              <div class="field"><label>Access expiry</label><div class="control"><i class="fa-regular fa-calendar-xmark"></i><input type="date" name="expiresAt"></div></div>
              <div class="field"><label>Status</label><div class="control"><i class="fa-solid fa-toggle-on"></i><select name="status"><option value="active">Active</option><option value="pending">Pending</option><option value="suspended">Suspended</option><option value="revoked">Revoked</option></select></div></div>
            </div>
            <div class="servicePermissionChecks"><label class="checkRow"><input type="checkbox" name="search" checked> Search</label><label class="checkRow"><input type="checkbox" name="book" checked> Book</label><label class="checkRow"><input type="checkbox" name="ticket"> Ticket</label><label class="checkRow"><input type="checkbox" name="exchange"> Exchange</label><label class="checkRow"><input type="checkbox" name="refund"> Refund</label></div>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-key"></i> Grant or update access</button></div>
          </form>
        </div>

        <div class="serviceControlGrid cardPad serviceControlGridTopless">
          <form class="serviceControlPanel serviceControlPanelWide" method="post" action="<%= flightAgencyCompanies.length ? '/admin/travel-marketplace/flights/agencies/' + (flightAgencyCompanies[0].id || flightAgencyCompanies[0]._id) + '/offers' : '#' %>" data-action-template="/admin/travel-marketplace/flights/agencies/{companyId}/offers" data-company-action-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Import authorised supplier offer</strong><span>Use the exact supplier reference. For external adapters this screen represents the normalised import boundary, not manual airline inventory creation.</span></div><span class="badge warn">Supplier snapshot</span></div>
            <div class="formGrid">
              <div class="field"><label>Agency</label><div class="control"><i class="fa-solid fa-building-user"></i><select name="companyId" required data-company-action-select><option value="">Select agency</option><% flightAgencyCompanies.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.name %></option><% }) %></select></div></div>
              <div class="field"><label>Agency storefront</label><div class="control"><i class="fa-solid fa-store"></i><select name="listingId" required><option value="">Select storefront</option><% flightStorefronts.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.title %> · <%= adminCompanyById(row.companyId).name || row.companyId %></option><% }) %></select></div></div>
              <div class="field"><label>Authorised supplier</label><div class="control"><i class="fa-solid fa-building-shield"></i><select name="supplierId" required><option value="">Select supplier</option><% adminFlightSuppliers.filter(function(row){ return row.status === 'active'; }).forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.name %></option><% }) %></select></div></div>
              <div class="field"><label>Supplier offer reference</label><div class="control"><i class="fa-solid fa-barcode"></i><input name="sourceOfferRef" maxlength="180" required></div></div>
              <div class="field"><label>Flight number</label><div class="control"><i class="fa-solid fa-hashtag"></i><input name="flightNumber" maxlength="30" required></div></div>
              <div class="field"><label>Operating airline</label><div class="control"><i class="fa-solid fa-plane"></i><input name="operatingAirline" maxlength="180" required></div></div>
              <div class="field"><label>Marketing airline</label><div class="control"><i class="fa-solid fa-plane-circle-check"></i><input name="marketingAirline" maxlength="180"></div></div>
              <div class="field"><label>Origin airport</label><div class="control"><i class="fa-solid fa-plane-departure"></i><select name="originAirportId" required><option value="">Select origin</option><% adminAirports.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.iataCode %> · <%= row.city %>, <%= row.country %></option><% }) %></select></div></div>
              <div class="field"><label>Destination airport</label><div class="control"><i class="fa-solid fa-plane-arrival"></i><select name="destinationAirportId" required><option value="">Select destination</option><% adminAirports.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.iataCode %> · <%= row.city %>, <%= row.country %></option><% }) %></select></div></div>
              <div class="field"><label>Departure</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="datetime-local" name="departAt" required></div></div>
              <div class="field"><label>Arrival</label><div class="control"><i class="fa-regular fa-calendar-check"></i><input type="datetime-local" name="arriveAt" required></div></div>
              <div class="field"><label>Cabin</label><div class="control"><i class="fa-solid fa-chair"></i><select name="cabinClass"><option value="economy">Economy</option><option value="premium_economy">Premium economy</option><option value="business">Business</option><option value="first">First</option></select></div></div>
              <div class="field"><label>Fare family</label><div class="control"><i class="fa-solid fa-tags"></i><input name="fareFamily" value="Standard" maxlength="120"></div></div>
              <div class="field"><label>Sellable allotment</label><div class="control"><i class="fa-solid fa-users"></i><input type="number" name="totalSeats" min="1" max="600" required></div></div>
              <div class="field"><label>Seat layout</label><div class="control"><i class="fa-solid fa-grip"></i><select name="seatMapLayout"><option value="3x3">3 × 3</option><option value="2x3">2 × 3</option><option value="2x2">2 × 2</option><option value="1x2">1 × 2</option></select></div></div>
              <div class="field"><label>Currency</label><div class="control"><i class="fa-solid fa-coins"></i><input name="currency" maxlength="8" value="<%= platformConfig.defaultCurrency %>" required></div></div>
              <div class="field"><label>Base fare</label><div class="control"><i class="fa-solid fa-money-bill"></i><input type="number" name="basePrice" min="1" step="0.01" required></div></div>
              <div class="field"><label>Taxes</label><div class="control"><i class="fa-solid fa-receipt"></i><input type="number" name="taxes" min="0" step="0.01" value="0"></div></div>
              <div class="field"><label>Aircraft (supplier information)</label><div class="control"><i class="fa-solid fa-plane-up"></i><input name="aircraftType" maxlength="120"></div></div>
              <div class="field"><label>Baggage</label><div class="control"><i class="fa-solid fa-suitcase"></i><input name="baggageAllowance" maxlength="300" value="Supplier rules apply"></div></div>
              <div class="field fieldFull"><label>Change rules</label><div class="control"><i class="fa-solid fa-arrows-rotate"></i><input name="changeRules" maxlength="1000"></div></div>
              <div class="field fieldFull"><label>Cancellation rules</label><div class="control"><i class="fa-solid fa-ban"></i><input name="cancellationRules" maxlength="1000"></div></div>
            </div>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-file-import"></i> Import supplier offer</button></div>
          </form>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Agency profiles and access</h4><p>Approval and access are separate records so suspension never requires changing supplier inventory.</p></div></div>
          <div class="tableWrap"><table><thead><tr><th>Agency</th><th>Profile</th><th>Licence</th><th>Ticket authority</th><th>Supplier access</th><th>Review</th></tr></thead><tbody>
          <% if(flightAgencyCompanies.length){ flightAgencyCompanies.forEach(function(company){ const companyId = company.id || company._id; const profile = adminAgencyProfiles.find(function(row){ return String(row.companyId) === String(companyId); }) || {}; const accessCount = adminSupplierAccesses.filter(function(row){ return String(row.companyId) === String(companyId) && row.status === 'active'; }).length; %>
          <tr><td><strong><%= company.name %></strong><small class="tableSub"><%= company.country || '-' %></small></td><td><span class="badge <%= badgeTone(profile.status) %>"><%= pretty(profile.status || 'missing') %></span></td><td><%= profile.businessLicenceNumber || '-' %><small class="tableSub"><%= profile.businessLicenceExpiresAt ? dateText(profile.businessLicenceExpiresAt) : 'No expiry recorded' %></small></td><td><%= profile.ticketingAuthorityApproved ? 'Approved' : 'Not approved' %></td><td><%= accessCount %> active</td><td><%= profile.reviewNotes || '-' %></td></tr>
          <% }) } else { %><tr class="emptyTableRow"><td colspan="6"><div class="emptyTableState"><i class="fa-solid fa-user-tie"></i><div><strong>No flight agency company</strong><span>Flight partner onboarding must create the company as a travel agency—not an airline operator.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Imported flight offers</h4><p>Publish or suspend only after supplier access, times, inventory and price are verified.</p></div><span class="badge info"><%= adminFlightOffers.length %> offers</span></div>
          <div class="tableWrap"><table><thead><tr><th>Agency / supplier</th><th>Flight</th><th>Departure</th><th>Inventory</th><th>Price</th><th>Status</th><th>Control</th></tr></thead><tbody>
          <% if(adminFlightOffers.length){ adminFlightOffers.forEach(function(row){ const agency = adminCompanyById(row.companyId); const supplier = adminSupplierById(row.supplierId); %>
          <tr><td><strong><%= agency.name || row.companyId %></strong><small class="tableSub"><%= supplier.name || row.supplierId %></small></td><td><%= row.flightNumber %><small class="tableSub"><%= row.operatingAirline %></small></td><td><%= dateText(row.departAt) %></td><td><%= row.availableSeats %> / <%= row.totalSeats %></td><td><%= row.currency %> <%= Number(row.basePrice || 0).toLocaleString('en-GB') %></td><td><span class="badge <%= badgeTone(row.status) %>"><%= pretty(row.status) %></span></td><td><div class="tableActions"><% if(row.status === 'draft'){ %><form method="post" action="/admin/travel-marketplace/flights/agencies/<%= row.companyId %>/offers/<%= row.id || row._id %>/publish"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn btnSm" type="submit">Publish</button></form><% } %><% if(['published','delayed'].includes(row.status)){ %><form method="post" action="/admin/travel-marketplace/flights/agencies/<%= row.companyId %>/offers/<%= row.id || row._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="status" value="cancelled"><button class="btn btnSm btnDanger" type="submit">Cancel</button></form><% } %></div></td></tr>
          <% }) } else { %><tr class="emptyTableRow"><td colspan="7"><div class="emptyTableState"><i class="fa-solid fa-plane-slash"></i><div><strong>No supplier offer imported</strong><span>Grant agency supplier access, then import an offer using the supplier’s source reference.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>
      </div>
    </div>

    <div class="serviceAdminColumn">
      <div class="card serviceWorkspaceCard">
        <div class="cardHead serviceWorkspaceHeader"><div class="cardTitle"><span class="hotelSectionEyebrow"><i class="fa-solid fa-taxi"></i> Ride-hailing control</span><h3>Marketplace, coverage, fares and safety</h3><p>Classic Trip owns the public taxi product and dispatch policy. Fleet partners contribute only approved drivers and vehicles.</p></div><span class="badge info"><%= adminTaxiRides.length %> rides</span></div>

        <div class="serviceControlGrid cardPad">
          <form class="serviceControlPanel" method="post" action="/admin/travel-marketplace/taxi/marketplaces">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Create or update ride marketplace</strong><span>One platform listing can serve a city or country with connected zones and fares.</span></div><span class="badge warn">Platform listing</span></div>
            <div class="formGrid">
              <div class="field"><label>Existing marketplace</label><div class="control"><i class="fa-solid fa-layer-group"></i><select name="id"><option value="">Create new</option><% taxiMarketplaces.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.title %></option><% }) %></select></div></div>
              <div class="field"><label>Marketplace title</label><div class="control"><i class="fa-solid fa-taxi"></i><input name="title" maxlength="180" required placeholder="Classic Trip Taxi Kampala"></div></div>
              <div class="field"><label>Country</label><div class="control"><i class="fa-solid fa-earth-africa"></i><input name="country" maxlength="100" required></div></div>
              <div class="field"><label>City</label><div class="control"><i class="fa-solid fa-city"></i><input name="city" maxlength="140" required></div></div>
              <div class="field"><label>Currency</label><div class="control"><i class="fa-solid fa-coins"></i><input name="currency" maxlength="8" value="<%= platformConfig.defaultCurrency %>" required></div></div>
              <div class="field"><label>Indicative from-price</label><div class="control"><i class="fa-solid fa-money-bill"></i><input type="number" name="priceFrom" min="0" step="0.01"></div></div>
              <div class="field fieldFull"><label>Public description</label><div class="control"><i class="fa-solid fa-align-left"></i><input name="sub" maxlength="2000" value="Request immediate, scheduled, office, airport and intercity rides from verified drivers."></div></div>
              <div class="field fieldFull"><label>Cancellation policy</label><div class="control"><i class="fa-solid fa-ban"></i><input name="cancellationRules" maxlength="2000"></div></div>
            </div>
            <label class="checkRow"><input type="checkbox" name="active"> Publish and make bookable after zones and fares are ready</label>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save marketplace</button></div>
          </form>

          <form class="serviceControlPanel" method="post" action="/admin/travel-marketplace/taxi/zones">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Create service area</strong><span>Coverage is a platform operational boundary, not a fleet preference.</span></div><span class="badge info">Geo policy</span></div>
            <div class="formGrid">
              <div class="field"><label>Marketplace</label><div class="control"><i class="fa-solid fa-layer-group"></i><select name="listingId" required><option value="">Select marketplace</option><% taxiMarketplaces.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.title %></option><% }) %></select></div></div>
              <div class="field"><label>Zone name</label><div class="control"><i class="fa-solid fa-location-dot"></i><input name="name" maxlength="180" required></div></div>
              <div class="field"><label>Country code</label><div class="control"><i class="fa-solid fa-flag"></i><input name="countryCode" maxlength="3" placeholder="UG"></div></div>
              <div class="field"><label>Dispatch region code</label><div class="control"><i class="fa-solid fa-map"></i><input name="dispatchRegionCode" maxlength="20" placeholder="KLA"></div></div>
              <div class="field"><label>Cities</label><div class="control"><i class="fa-solid fa-city"></i><input name="cities" maxlength="1000" placeholder="Kampala, Entebbe"></div></div>
              <div class="field"><label>Districts</label><div class="control"><i class="fa-solid fa-map-location-dot"></i><input name="districts" maxlength="1000"></div></div>
              <div class="field"><label>Airport codes</label><div class="control"><i class="fa-solid fa-plane"></i><input name="airportCodes" maxlength="300" placeholder="EBB"></div></div>
              <div class="field"><label>Radius km</label><div class="control"><i class="fa-solid fa-circle-dot"></i><input type="number" name="radiusKm" min="1" step="0.1"></div></div>
              <div class="field"><label>Centre latitude</label><div class="control"><i class="fa-solid fa-location-crosshairs"></i><input type="number" name="centerLatitude" step="0.000001"></div></div>
              <div class="field"><label>Centre longitude</label><div class="control"><i class="fa-solid fa-location-crosshairs"></i><input type="number" name="centerLongitude" step="0.000001"></div></div>
              <div class="field"><label>Dispatch priority</label><div class="control"><i class="fa-solid fa-arrow-down-1-9"></i><input type="number" name="dispatchPriority" min="1" max="10000" value="100"></div></div>
              <div class="field"><label>Status</label><div class="control"><i class="fa-solid fa-toggle-on"></i><select name="status"><option value="active">Active</option><option value="paused">Paused</option></select></div></div>
            </div>
            <div class="servicePermissionChecks"><label class="checkRow"><input type="checkbox" name="allowsIntercity" checked> Intercity</label><label class="checkRow"><input type="checkbox" name="allowsOfficeTrips" checked> Office trips</label><label class="checkRow"><input type="checkbox" name="allowsAirportTransfers" checked> Airport transfers</label></div>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-map-location-dot"></i> Create service area</button></div>
          </form>
        </div>

        <div class="serviceControlGrid cardPad serviceControlGridTopless">
          <form class="serviceControlPanel serviceControlPanelWide" method="post" action="/admin/travel-marketplace/taxi/fares">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="servicePanelHeading"><div><strong>Create server-authoritative fare rule</strong><span>The commission and driver payout must total 100%. Surge is capped and never set by a fleet partner.</span></div><span class="badge warn">Money control</span></div>
            <div class="formGrid">
              <div class="field"><label>Marketplace</label><div class="control"><i class="fa-solid fa-layer-group"></i><select name="listingId" required><option value="">Select marketplace</option><% taxiMarketplaces.forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.title %></option><% }) %></select></div></div>
              <div class="field"><label>Service area</label><div class="control"><i class="fa-solid fa-location-dot"></i><select name="zoneId"><option value="">All marketplace areas</option><% adminTaxiZones.filter(function(row){ return row.status === 'active'; }).forEach(function(row){ %><option value="<%= row.id || row._id %>"><%= row.name %></option><% }) %></select></div></div>
              <div class="field"><label>Vehicle class</label><div class="control"><i class="fa-solid fa-car"></i><select name="vehicleClass"><option value="boda">Boda</option><option value="economy">Economy</option><option value="comfort">Comfort</option><option value="premium">Premium</option><option value="suv">SUV</option><option value="van">Van</option><option value="shuttle">Shuttle</option></select></div></div>
              <div class="field"><label>Currency</label><div class="control"><i class="fa-solid fa-coins"></i><input name="currency" maxlength="8" value="<%= platformConfig.defaultCurrency %>" required></div></div>
              <div class="field"><label>Base fare</label><div class="control"><i class="fa-solid fa-money-bill"></i><input type="number" name="baseFare" min="0" step="0.01" required></div></div>
              <div class="field"><label>Per kilometre</label><div class="control"><i class="fa-solid fa-road"></i><input type="number" name="perKm" min="0.01" step="0.01" required></div></div>
              <div class="field"><label>Per minute</label><div class="control"><i class="fa-regular fa-clock"></i><input type="number" name="perMinute" min="0" step="0.01" value="0"></div></div>
              <div class="field"><label>Minimum fare</label><div class="control"><i class="fa-solid fa-money-check-dollar"></i><input type="number" name="minimumFare" min="0.01" step="0.01" required></div></div>
              <div class="field"><label>Booking fee</label><div class="control"><i class="fa-solid fa-receipt"></i><input type="number" name="bookingFee" min="0" step="0.01" value="0"></div></div>
              <div class="field"><label>Airport surcharge</label><div class="control"><i class="fa-solid fa-plane"></i><input type="number" name="airportSurcharge" min="0" step="0.01" value="0"></div></div>
              <div class="field"><label>Night surcharge %</label><div class="control"><i class="fa-solid fa-moon"></i><input type="number" name="nightSurchargePercent" min="0" max="100" step="0.01" value="0"></div></div>
              <div class="field"><label>Intercity multiplier</label><div class="control"><i class="fa-solid fa-route"></i><input type="number" name="intercityMultiplier" min="1" max="10" step="0.01" value="1"></div></div>
              <div class="field"><label>Waiting per minute</label><div class="control"><i class="fa-solid fa-hourglass-half"></i><input type="number" name="waitingPerMinute" min="0" step="0.01" value="0"></div></div>
              <div class="field"><label>Platform commission %</label><div class="control"><i class="fa-solid fa-percent"></i><input type="number" name="platformCommissionPercent" min="0" max="100" step="0.01" value="15" required></div></div>
              <div class="field"><label>Driver payout %</label><div class="control"><i class="fa-solid fa-hand-holding-dollar"></i><input type="number" name="driverPayoutPercent" min="0" max="100" step="0.01" value="85" required></div></div>
              <div class="field"><label>Maximum surge</label><div class="control"><i class="fa-solid fa-bolt"></i><input type="number" name="maxSurgeMultiplier" min="1" max="5" step="0.01" value="1"></div></div>
              <div class="field"><label>Status</label><div class="control"><i class="fa-solid fa-toggle-on"></i><select name="status"><option value="active">Active</option><option value="paused">Paused</option></select></div></div>
            </div>
            <label class="checkRow"><input type="checkbox" name="surgeEnabled"> Allow capped platform surge</label>
            <div class="serviceFormActions"><button class="btn btnBlue" type="submit"><i class="fa-solid fa-calculator"></i> Create fare rule</button></div>
          </form>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Coverage and fares</h4><p>These are the rules the customer quote engine and central dispatch use.</p></div></div>
          <div class="tableWrap"><table><thead><tr><th>Area / class</th><th>Marketplace</th><th>Rate</th><th>Minimum</th><th>Airport / night</th><th>Split</th><th>Status</th></tr></thead><tbody>
          <% if(adminTaxiFares.length){ adminTaxiFares.forEach(function(row){ const zone = adminZoneById(row.zoneId); const listing = adminListingById(row.listingId); %><tr><td><strong><%= zone.name || 'All areas' %></strong><small class="tableSub"><%= pretty(row.vehicleClass) %></small></td><td><%= listing.title || row.listingId %></td><td><%= row.currency %> <%= Number(row.baseFare || 0).toLocaleString('en-GB') %> + <%= Number(row.perKm || 0).toLocaleString('en-GB') %>/km</td><td><%= row.currency %> <%= Number(row.minimumFare || 0).toLocaleString('en-GB') %></td><td><%= Number(row.airportSurcharge || 0).toLocaleString('en-GB') %> / <%= Number(row.nightSurchargePercent || 0) %>%</td><td><%= Number(row.platformCommissionPercent || 0) %> platform · <%= Number(row.driverPayoutPercent || 0) %> payout</td><td><span class="badge <%= badgeTone(row.status) %>"><%= pretty(row.status) %></span></td></tr><% }) } else { %><tr class="emptyTableRow"><td colspan="7"><div class="emptyTableState"><i class="fa-solid fa-calculator"></i><div><strong>No fare rule</strong><span>Customers cannot receive a valid quote until an active platform fare exists for the selected marketplace and vehicle class.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Fleet compliance review</h4><p>Company approval, fleet profile approval and vehicle approval are independent controls.</p></div><span class="badge info"><%= taxiFleetCompanies.length %> fleets</span></div>
          <div class="tableWrap"><table><thead><tr><th>Fleet</th><th>Company verification</th><th>Fleet profile</th><th>Vehicles</th><th>Review control</th></tr></thead><tbody>
          <% if(taxiFleetCompanies.length){ taxiFleetCompanies.forEach(function(company){ const companyId = company.id || company._id; const profile = taxiFleetProfiles.find(function(row){ return String(row.companyId) === String(companyId); }) || {}; const vehicles = adminTaxiVehicles.filter(function(row){ return String(row.companyId) === String(companyId); }); %>
          <tr><td><strong><%= company.name %></strong><small class="tableSub"><%= company.country || '-' %></small></td><td><span class="badge <%= badgeTone(company.verificationStatus || company.status) %>"><%= pretty(company.verificationStatus || company.status) %></span></td><td><span class="badge <%= badgeTone(profile.complianceStatus) %>"><%= pretty(profile.complianceStatus || 'missing') %></span></td><td><%= vehicles.filter(function(row){ return row.verificationStatus === 'approved'; }).length %> approved / <%= vehicles.length %> submitted</td><td><form class="tableInlineForm" method="post" action="/admin/travel-marketplace/taxi/fleets/<%= companyId %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="status"><option value="approved">Approve</option><option value="changes_required">Changes required</option><option value="rejected">Reject</option><option value="suspended">Suspend</option></select><input name="reviewNotes" maxlength="1000" placeholder="Review note" required><button class="btn btnSm" type="submit">Save</button></form></td></tr>
          <% }) } else { %><tr class="emptyTableRow"><td colspan="5"><div class="emptyTableState"><i class="fa-solid fa-car-side"></i><div><strong>No taxi fleet partner</strong><span>Fleet onboarding creates private supply profiles; customers book the platform marketplace instead.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Vehicle safety review</h4><p>Approve only current inspection and insurance records.</p></div><span class="badge info"><%= adminTaxiVehicles.length %> vehicles</span></div>
          <div class="tableWrap"><table><thead><tr><th>Fleet / vehicle</th><th>Class</th><th>Documents</th><th>Status</th><th>Review control</th></tr></thead><tbody>
          <% if(adminTaxiVehicles.length){ adminTaxiVehicles.forEach(function(row){ const fleet = adminCompanyById(row.companyId); %>
          <tr><td><strong><%= fleet.name || row.companyId %></strong><small class="tableSub"><%= row.registrationNumber %> · <%= [row.make,row.model].filter(Boolean).join(' ') %></small></td><td><%= pretty(row.vehicleClass) %></td><td>Inspection: <%= dateText(row.inspectionExpiresAt) %><small class="tableSub">Insurance: <%= dateText(row.insuranceExpiresAt) %></small></td><td><span class="badge <%= badgeTone(row.verificationStatus) %>"><%= pretty(row.verificationStatus) %></span></td><td><form class="tableInlineForm" method="post" action="/admin/travel-marketplace/taxi/fleets/<%= row.companyId %>/vehicles/<%= row.id || row._id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="status"><option value="approved">Approve</option><option value="changes_required">Changes required</option><option value="rejected">Reject</option><option value="suspended">Suspend</option></select><input name="reviewNotes" maxlength="1000" placeholder="Review note"><button class="btn btnSm" type="submit">Save</button></form></td></tr>
          <% }) } else { %><tr class="emptyTableRow"><td colspan="5"><div class="emptyTableState"><i class="fa-solid fa-shield-car"></i><div><strong>No submitted vehicle</strong><span>Approved fleets submit vehicles from their own dashboard; they cannot self-activate them.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>

        <div class="serviceTableBlock">
          <div class="serviceBlockHeading"><div><h4>Central dispatch and intervention</h4><p>Normal dispatch is automatic across eligible fleets. Manual controls exist only for recovery, safety and cancellation.</p></div><span class="badge info"><%= adminTaxiRides.length %> rides</span></div>
          <div class="tableWrap"><table><thead><tr><th>Booking</th><th>Trip</th><th>Fleet / driver</th><th>Fare</th><th>Status</th><th>Platform control</th></tr></thead><tbody>
          <% if(adminTaxiRides.length){ adminTaxiRides.slice(0,150).forEach(function(row){ const fleet = adminCompanyById(row.providerCompanyId || row.companyId); %>
          <tr><td><strong><%= row.bookingRef %></strong><small class="tableSub"><%= pretty(row.rideType) %></small></td><td><%= row.pickup?.label || row.pickup?.address || 'Pickup' %> → <%= row.destination?.label || row.destination?.address || 'Destination' %></td><td><%= fleet.name || 'Awaiting assignment' %><small class="tableSub"><%= row.driverUserId || 'No driver' %></small></td><td><%= row.currency %> <%= Number(row.finalFare || row.quotedFare || 0).toLocaleString('en-GB') %></td><td><span class="badge <%= badgeTone(row.status) %>"><%= pretty(row.status) %></span></td><td><div class="tableActions"><% if(['scheduled','dispatching'].includes(row.status)){ %><form method="post" action="/admin/travel-marketplace/taxi/rides/<%= row.id || row._id %>/dispatch"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn btnSm" type="submit">Dispatch now</button></form><% } %><% if(!['completed','cancelled','refunded','failed'].includes(row.status)){ %><form method="post" action="/admin/travel-marketplace/taxi/rides/<%= row.id || row._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="status" value="cancelled"><input type="hidden" name="reason" value="Platform safety or operations intervention"><button class="btn btnSm btnDanger" type="submit">Cancel</button></form><% } %></div></td></tr>
          <% }) } else { %><tr class="emptyTableRow"><td colspan="6"><div class="emptyTableState"><i class="fa-solid fa-taxi"></i><div><strong>No ride request</strong><span>Paid immediate and scheduled ride requests enter central dispatch automatically.</span></div></div></td></tr><% } %>
          </tbody></table></div>
        </div>
      </div>
    </div>
  </div>
</section>
