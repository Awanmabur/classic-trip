          <div class="field"><label>Zone type</label><div class="control"><select name="zoneType"><option value="radius">Radius</option><option value="city">City</option><option value="district">District</option><option value="airport">Airport</option><option value="intercity_corridor">Intercity corridor</option><option value="national">National</option><option value="custom_polygon">Custom polygon</option></select></div></div>
