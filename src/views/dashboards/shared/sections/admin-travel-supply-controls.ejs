      <div class="cardHead"><div class="cardTitle"><h3>Aircraft and seat-map reference</h3><p>Used only for platform-managed inventory or supplier seat-map normalization.</p></div><span class="badge info"><%= (flightAdmin.aircraft || []).length %> aircraft</span></div>
      <form class="formPanel" method="POST" action="/admin/flights/aircraft"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="formGrid"><div class="field"><label>Airline</label><div class="control"><select name="airlineId" required><option value="">Select airline</option><% (flightAdmin.airlines || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.name %></option><% }) %></select></div></div><div class="field"><label>Aircraft type</label><div class="control"><select name="aircraftTypeId" required><option value="">Select type</option><% (flightAdmin.aircraftTypes || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.manufacturer %> <%= row.model %> · <%= row.defaultSeatCapacity || '' %> seats</option><% }) %></select></div></div><div class="field"><label>Registration</label><div class="control"><input name="registration" required></div></div><div class="field"><label>Display name</label><div class="control"><input name="name"></div></div><div class="field"><label>Seat capacity</label><div class="control"><input type="number" name="seatCapacity" min="1" max="1000" required></div></div><div class="field"><label>Cabins</label><div class="control"><input name="cabinClasses" value="economy"></div></div><div class="field"><label>Airworthiness expiry</label><div class="control"><input type="date" name="airworthinessExpiresAt"></div></div><div class="field"><label>Insurance expiry</label><div class="control"><input type="date" name="insuranceExpiresAt"></div></div></div><button class="btn btnPrimary" type="submit">Add aircraft reference</button></form>
      <form class="formPanel" method="POST" action="/admin/flights/seat-maps"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><h4>Create simple seat map version</h4><div class="formGrid"><div class="field"><label>Aircraft type</label><div class="control"><select name="aircraftTypeId"><option value="">Select type</option><% (flightAdmin.aircraftTypes || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.manufacturer %> <%= row.model %></option><% }) %></select></div></div><div class="field"><label>Map name</label><div class="control"><input name="name" placeholder="Economy 3-3" required></div></div><div class="field"><label>Seat count</label><div class="control"><input type="number" name="seatCount" min="1" max="1000" required></div></div><div class="field"><label>Columns</label><div class="control"><input name="columns" value="A,B,C,D,E,F"></div></div><div class="field"><label>Cabin</label><div class="control"><select name="cabinClass"><option value="economy">Economy</option><option value="premium_economy">Premium economy</option><option value="business">Business</option><option value="first">First</option></select></div></div><div class="field checkLine"><label><input type="checkbox" name="publish" value="true"> Publish immutable version now</label></div></div><button class="btn" type="submit">Create seat map version</button></form>
    </div>
  </div>

  <div class="grid2">
    <div class="card">
      <div class="cardHead"><div class="cardTitle"><h3>Route and fare family</h3><p>Connect verified airports, airline references and transparent fare policies.</p></div></div>
      <form class="formPanel" method="POST" action="/admin/flights/routes"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><h4>Add route</h4><input type="hidden" name="listingId" value="<%= flightAdmin.listing?.id || '' %>"><div class="formGrid"><div class="field"><label>Airline</label><div class="control"><select name="airlineId" required><option value="">Select airline</option><% (flightAdmin.airlines || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.name %></option><% }) %></select></div></div><div class="field"><label>Origin</label><div class="control"><select name="originAirportId" required><option value="">Select airport</option><% (flightAdmin.airports || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.iataCode %> · <%= row.city %></option><% }) %></select></div></div><div class="field"><label>Destination</label><div class="control"><select name="destinationAirportId" required><option value="">Select airport</option><% (flightAdmin.airports || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.iataCode %> · <%= row.city %></option><% }) %></select></div></div><div class="field"><label>Duration minutes</label><div class="control"><input type="number" name="defaultDurationMinutes" min="10" max="2000" required></div></div></div><button class="btn" type="submit">Add route</button></form>
      <form class="formPanel" method="POST" action="/admin/flights/fare-families"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><h4>Add fare family</h4><div class="formGrid"><div class="field"><label>Airline</label><div class="control"><select name="airlineId" required><option value="">Select airline</option><% (flightAdmin.airlines || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.name %></option><% }) %></select></div></div><div class="field"><label>Route</label><div class="control"><select name="routeId"><option value="">All airline routes</option><% (flightAdmin.routes || []).forEach(function(row){ %><option value="<%= row.id %>"><%= ctRoute(row.originAirportId, row.destinationAirportId) %></option><% }) %></select></div></div><div class="field"><label>Code</label><div class="control"><input name="code" placeholder="ECO-LITE" required></div></div><div class="field"><label>Name</label><div class="control"><input name="name" placeholder="Economy Light" required></div></div><div class="field"><label>Cabin</label><div class="control"><select name="cabinClass"><option value="economy">Economy</option><option value="premium_economy">Premium economy</option><option value="business">Business</option><option value="first">First</option></select></div></div><div class="field"><label>Base price</label><div class="control"><input type="number" name="basePrice" min="0" step="0.01" required></div></div><div class="field"><label>Checked baggage kg</label><div class="control"><input type="number" name="checkedBaggageKg" min="0" value="0"></div></div><div class="field"><label>Cabin baggage kg</label><div class="control"><input type="number" name="cabinBaggageKg" min="0" value="7"></div></div><div class="field checkLine"><label><input type="checkbox" name="mealIncluded" value="true"> Meal included</label></div><div class="field checkLine"><label><input type="checkbox" name="seatSelectionIncluded" value="true"> Seat selection included</label></div><div class="field checkLine"><label><input type="checkbox" name="changeable" value="true"> Changeable</label></div><div class="field checkLine"><label><input type="checkbox" name="refundable" value="true"> Refundable</label></div><div class="field full"><label>Fare terms</label><div class="control"><textarea name="terms"></textarea></div></div></div><button class="btn btnPrimary" type="submit">Add fare family</button></form>
    </div>

    <div class="card">
      <div class="cardHead"><div class="cardTitle"><h3>Dated departure and inventory</h3><p>Create, generate live seats, then publish. Agents only search the resulting offer.</p></div><span class="badge info"><%= (flightAdmin.departures || []).length %> departures</span></div>
      <form class="formPanel" method="POST" action="/admin/flights/departures"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="formGrid"><div class="field"><label>Route</label><div class="control"><select name="routeId" required><option value="">Select route</option><% (flightAdmin.routes || []).forEach(function(row){ %><option value="<%= row.id %>"><%= ctRoute(row.originAirportId, row.destinationAirportId) %></option><% }) %></select></div></div><div class="field"><label>Aircraft</label><div class="control"><select name="aircraftId" required><option value="">Select aircraft</option><% (flightAdmin.aircraft || []).forEach(function(row){ %><option value="<%= row.id %>"><%= row.registration %> · <%= row.name || row.aircraftTypeId %></option><% }) %></select></div></div><div class="field"><label>Published seat map</label><div class="control"><select name="seatMapVersionId" required><option value="">Select map</option><% (flightAdmin.seatMaps || []).filter(function(row){return row.status==='published';}).forEach(function(row){ %><option value="<%= row.id %>"><%= row.name %> v<%= row.version %> · <%= (row.seats||[]).length %> seats</option><% }) %></select></div></div><div class="field"><label>Supplier</label><div class="control"><select name="supplierId"><option value="">Platform-managed inventory</option><% (flightAdmin.suppliers || []).filter(function(row){return row.status==='active';}).forEach(function(row){ %><option value="<%= row.id %>"><%= row.name %></option><% }) %></select></div></div><div class="field"><label>Flight number</label><div class="control"><input name="flightNumber" required></div></div><div class="field"><label>Departure time</label><div class="control"><input type="datetime-local" name="departAt" required></div></div><div class="field"><label>Arrival time</label><div class="control"><input type="datetime-local" name="arriveAt" required></div></div><div class="field"><label>Departure terminal</label><div class="control"><input name="departureTerminal"></div></div><div class="field"><label>Arrival terminal</label><div class="control"><input name="arrivalTerminal"></div></div></div><button class="btn btnPrimary" type="submit">Create draft departure</button></form>
      <div class="tableWrap"><table><thead><tr><th>Flight</th><th>Route</th><th>Departure</th><th>Inventory</th><th>Status</th><th>Actions</th></tr></thead><tbody><% (flightAdmin.departures || []).slice(0,100).forEach(function(row){ %><tr><td><strong><%= row.flightNumber %></strong></td><td><%= ctRoute(row.originAirportId, row.destinationAirportId) %></td><td><%= adminDate(row.departAt) %></td><td><%= row.inventoryGeneratedAt ? 'Generated' : 'Not generated' %></td><td><span class="badge <%= adminStatusClass(row.publicationStatus) %>"><%= row.publicationStatus %></span></td><td><div class="travelActions"><button class="tinyBtn" type="button" data-modal="view" data-type="flight departure" data-label="<%= row.flightNumber %>" data-row-detail="<%= controlDetail('flight_departure', row, row.flightNumber) %>" title="View departure details"><i class="fa-regular fa-eye"></i></button><% if(!row.inventoryGeneratedAt){ %><form method="POST" action="/admin/flights/departures/<%= row.id %>/inventory"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="tinyBtn" type="submit" title="Generate seats"><i class="fa-solid fa-chair"></i></button></form><% } %><% if(row.inventoryGeneratedAt && row.publicationStatus!=='published'){ %><form method="POST" action="/admin/flights/departures/<%= row.id %>/publish"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="tinyBtn" type="submit" title="Publish departure"><i class="fa-solid fa-cloud-arrow-up"></i></button></form><% } %></div></td></tr><% }) %><% if(!(flightAdmin.departures || []).length){ %><tr><td colspan="6">No departures configured.</td></tr><% } %></tbody></table></div>
    </div>
  </div>

  <div class="grid2">
    <div class="card"><div class="cardHead"><div class="cardTitle"><h3>Agent quotes and sales</h3><p>Read-only commercial oversight. Agents cannot alter supplier prices, but administrators can inspect the complete quote snapshot and expiry state.</p></div><span class="badge info"><%= (flightAdmin.agentQuotes || []).length %> quotes</span></div><div class="tableWrap"><table><thead><tr><th>Quote</th><th>Agent</th><th>Customer</th><th>Total</th><th>Expires</th><th>Status</th><th>Actions</th></tr></thead><tbody><% (flightAdmin.agentQuotes || []).slice(0,100).forEach(function(row){ %><tr><td><%= row.quoteRef %></td><td><%= row.agentCompanyId %></td><td><%= row.customerName %><br><small><%= row.customerPhone || row.customerEmail %></small></td><td><%= controlMoney(row.totalPriceSnapshot?.total,row.totalPriceSnapshot?.currency) %></td><td><%= adminDate(row.expiresAt) %></td><td><span class="badge <%= adminStatusClass(row.status) %>"><%= row.status %></span></td><td><div class="travelActions"><button class="tinyBtn" type="button" data-modal="view" data-type="flight quote" data-label="<%= row.quoteRef %>" data-row-detail="<%= controlDetail('flight_quote', row, row.quoteRef) %>" title="View quote snapshot"><i class="fa-regular fa-eye"></i></button></div></td></tr><% }) %><% if(!(flightAdmin.agentQuotes || []).length){ %><tr><td colspan="7">No agent quotes yet.</td></tr><% } %></tbody></table></div></div>
    <div class="card"><div class="cardHead"><div class="cardTitle"><h3>Changes and refunds</h3><p>Super Admin coordinates supplier outcomes; agents submit requests for their own bookings.</p></div><span class="badge warn"><%= (flightAdmin.changeRequests || []).filter(function(row){return !['completed','cancelled','rejected'].includes(row.status);}).length + (flightAdmin.refundRequests || []).filter(function(row){return !['refunded','cancelled','rejected'].includes(row.status);}).length %> open</span></div><div class="tableWrap"><table><thead><tr><th>Request</th><th>Booking</th><th>Agent</th><th>Type / reason</th><th>Status</th><th>Review</th></tr></thead><tbody><% (flightAdmin.changeRequests || []).forEach(function(row){ %><tr><td><%= row.requestRef %></td><td><%= row.bookingRef %></td><td><%= row.agentCompanyId %></td><td><%= row.requestType %><br><small><%= row.details?.summary || '' %></small></td><td><span class="badge <%= adminStatusClass(row.status) %>"><%= row.status %></span></td><td><form method="POST" action="/admin/flights/change-requests/<%= row.id %>/status" class="inlineReviewForm"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="status"><option value="under_review">Under review</option><option value="quoted">Quoted</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select><input name="summary" placeholder="Supplier response"><button class="tinyBtn" type="submit"><i class="fa-solid fa-check"></i></button></form></td></tr><% }) %><% (flightAdmin.refundRequests || []).forEach(function(row){ %><tr><td><%= row.requestRef %></td><td><%= row.bookingRef %></td><td><%= row.agentCompanyId %></td><td>Refund<br><small><%= row.reason %></small></td><td><span class="badge <%= adminStatusClass(row.status) %>"><%= row.status %></span></td><td><form method="POST" action="/admin/flights/refund-requests/<%= row.id %>/status" class="inlineReviewForm"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="status"><option value="under_review">Under review</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="processing">Processing</option><option value="refunded">Refunded</option><option value="cancelled">Cancelled</option></select><input name="summary" placeholder="Supplier response"><button class="tinyBtn" type="submit"><i class="fa-solid fa-check"></i></button></form></td></tr><% }) %><% if(!(flightAdmin.changeRequests || []).length && !(flightAdmin.refundRequests || []).length){ %><tr><td colspan="6">No open requests.</td></tr><% } %></tbody></table></div></div>
  </div>
</div>
<% } %>

<script nonce="<%= cspNonce %>">
(function(){
  document.querySelectorAll('[data-scroll-target]').forEach(function(button){button.addEventListener('click',function(){var target=document.getElementById(button.dataset.scrollTarget);if(target)target.scrollIntoView({behavior:'smooth',block:'start'});});});
})();
</script>
