<% const ctRoute = typeof routeDisplay === 'function' ? routeDisplay : function(origin, destination, fallback){ const from = String(origin || '').trim(); const to = String(destination || '').trim(); if(from && to) return from + ' ⇄ ' + to; return String(fallback || from || to || '').trim().replace(/\s+(?:to|→|->|↔|⇄)\s+/gi, ' ⇄ '); }; %>
<%
  const travelSupply = dashboardData?.travelSupply || {};
  const mobilityAdmin = travelSupply.mobility || {};
  const flightAdmin = travelSupply.flight || {};
  const controlMoney = function(value, currency){ return `${currency || platformConfig.defaultCurrency || ''} ${Number(value || 0).toLocaleString('en-GB')}`.trim(); };
  const adminDate = function(value){ if(!value) return '-'; const d = new Date(value); return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString('en-GB'); };
  const adminStatusClass = function(value){ const s=String(value||'').toLowerCase(); return /active|verified|published|completed|approved|clear|refunded/.test(s)?'ok':/rejected|suspended|failed|cancelled|expired|critical/.test(s)?'bad':'warn'; };
  const controlDetail = function(entity, row, label){ return encodeURIComponent(JSON.stringify({ entity: entity, id: row?.id || row?.quoteRef || row?.flightNumber || '', label: label || row?.id || entity, record: row || {} })); };
%>

<% if(service.serviceType === 'local_transport'){ %>
