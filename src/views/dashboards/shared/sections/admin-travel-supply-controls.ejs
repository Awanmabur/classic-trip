      <div class="tableWrap"><table><thead><tr><th>Partner</th><th>Vehicle</th><th>Class</th><th>Compliance</th><th>Review</th></tr></thead><tbody>
        <% (mobilityAdmin.vehicles || []).forEach(function(row){ const klass=(mobilityAdmin.vehicleClasses||[]).find(function(item){return String(item.id)===String(row.vehicleClassId);}); %><tr><td><%= row.companyId %></td><td><strong><%= row.registrationNumber %></strong><br><small><%= row.make %> <%= row.model %> · <%= row.year || '-' %></small></td><td><%= klass?.name || row.vehicleClassId %></td><td>Insurance: <%= adminDate(row.insuranceExpiresAt) %><br><small>Inspection: <%= adminDate(row.inspectionExpiresAt) %></small></td><td><form method="POST" action="/admin/mobility/vehicles/<%= row.id %>/review" class="inlineReviewForm"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="verificationStatus"><option value="verified">Verify</option><option value="rejected">Reject</option><option value="expired">Expired</option></select><input name="reviewNotes" placeholder="Review note"><button class="tinyBtn" type="submit"><i class="fa-solid fa-check"></i></button></form></td></tr><% }) %>
