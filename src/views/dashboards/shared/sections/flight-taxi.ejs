ver<%= taxiDrivers.length===1?'':'s' %></span></div><div class="tableWrap"><table><thead><tr><th>Driver</th><th>Licence</th><th>Vehicle</th><th>Background</th><th>Verification</th><th>Availability</th><th>Actions</th></tr></thead><tbody><% taxiDrivers.forEach(function(row){ const vehicle=taxiVehicles.find(function(v){return String(v.id)===String(row.assignedVehicleId);}); %><tr><td><strong><%= row.driverNumber %></strong></td><td>••••<%= row.licenceNumberLast4 %><br><small><%= row.licenceClass || '-' %></small></td><td><%= vehicle?.registrationNumber || 'Not assigned' %></td><td><span class="badge <%= statusClass(row.backgroundCheckStatus) %>"><%= row.backgroundCheckStatus %></span></td><td><span class="badge <%= statusClass(row.verificationStatus) %>"><%= row.verificationStatus %></span></td><td><span class="badge <%= statusClass(row.availabilityStatus) %>"><%= row.availabilityStatus %></span></td><td><button class="tinyBtn" type="button" data-modal="view" data-type="taxi driver" data-label="<%= row.driverNumber %>" data-row-detail="<%= dashboardDetail('taxi_driver', row, row.driverNumber) %>" title="View driver details"><i class="fa-regular fa-eye"></i></button></td></tr><% }) %><% if(!taxiDrivers.length){ %><tr><td colspan="7">No driver submitted yet.</td></tr><% } %></tbody></table></div></div></div>
