<% if(shouldRenderTravelSection('taxi-availability')){ %>
<section class="section" id="taxi-availability">
  <div class="card"><div class="cardHead"><div class="cardTitle"><h3><i class="fa-solid fa-toggle-on"></i> Go online</h3><p>Verified drivers with verified vehicles can go online. Current location is used only for safe automatic dispatch and expires quickly.</p></div><span class="badge info">Automatic dispatch</span></div><div class="grid2"><% taxiDrivers.forEach(function(driver){ const vehicle=taxiVehicles.find(function(row){return String(row.id)===String(driver.assignedVehicleId);}); const available=taxiAvailability.find(function(row){return String(row.driverProfileId)===String(driver.id);}); %><div class="formPanel"><h4><%= driver.driverNumber %></h4><p class="muted"><%= vehicle?.registrationNumber || 'Assign an approved vehicle first' %> · <%= available?.status || driver.availabilityStatus || 'offline' %></p><div class="travelActions"><button class="btn btnPrimary" type="button" data-driver-online="<%= driver.id %>" data-vehicle="<%= vehicle?.id || '' %>" <%= driver.verificationStatus!=='verified'||!vehicle||vehicle.verificationStatus!=='verified'?'disabled':'' %>><i class="fa-solid fa-location-crosshairs"></i> Go online here</button><button class="btn btnGhost" type="button" data-driver-offline="<%= driver.id %>" data-vehicle="<%= vehicle?.id || '' %>">Go offline</button></div><div class="travelMessage" data-driver-message="<%= driver.id %>"></div></div><% }) %><% if(!taxiDrivers.length){ %><div class="notice">Submit and verify a driver before using availability.</div><% } %></div></div>
</section>
<% } %>

<% if(shouldRenderTravelSection('taxi-operations')){ %>
<section class="section" id="taxi-operations">
  <div class="card"><div class="cardHead"><div class="cardTitle"><h3><i class="fa-solid fa-route"></i> Assigned rides</h3><p>Rides are priced and dispatched automatically by the platform. You see only rides assigned to your verified driver or fleet.</p></div><span class="badge <%= taxiRides.length ? 'ok' : 'warn' %>"><%= taxiRides.length %> ride<%= taxiRides.length===1?'':'s' %></span></div><div class="tableWrap"><table><thead><tr><th>Ride</th><th>Pickup ⇄ destination</th><th>Pickup time</th><th>Driver / vehicle</th><th>Fare</th><th>Status</th><th>Permitted action</th></tr></thead><tbody><% taxiRides.forEach(function(row){ %><tr><td><strong><%= row.rideRef || row.bookingRef %></strong><br><small><%= row.serviceType %></small></td><td><%= ctRoute(row.pickup?.address || 'Pickup', row.destination?.address || 'Destination') %></td><td><%= fmtDate(row.scheduledPickupAt) %></td><td><%= row.driverProfileId || 'Pending assignment' %><br><small><%= row.vehicleId || '-' %></small></td><td><%= money(row.pricing?.total,row.pricing?.currency) %></td><td><span class="badge <%= statusClass(row.status) %>"><%= row.status %></span></td><td><div class="rowActions"><button class="tinyBtn" type="button" data-modal="view" data-type="taxi ride" data-label="<%= row.rideRef || row.bookingRef %>" data-row-detail="<%= dashboardDetail('taxi_ride', row, row.rideRef || row.bookingRef) %>" title="View ride details"><i class="fa-regular fa-eye"></i></button><% if(['scheduled','dispatch_pending','offering','assigned'].includes(row.status)){ %><form method="POST" action="/company/taxi/rides/<%= row.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="reason" value="Partner cannot fulfil this ride"><button class="tinyBtn" type="submit" title="Request cancellation"><i class="fa-solid fa-ban"></i></button></form><% } else { %><span class="muted">Driver app controls trip steps</span><% } %></div></td></tr><% }) %><% if(!taxiRides.length){ %><tr><td colspan="7">No rides have been assigned to this account.</td></tr><% } %></tbody></table></div></div>
</section>
<% } %>

<% if(shouldRenderTravelSection('taxi-incidents')){ %>
<section class="section" id="taxi-incidents">
  <div class="grid2"><div class="card"><div class="cardHead"><div class="cardTitle"><h3><i class="fa-solid fa-shield-halved"></i> Report a safety issue</h3><p>Critical reports place the ride into restricted platform review.</p></div></div><form class="formPanel" method="POST" action="/company/taxi/incidents"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="formGrid"><div class="field"><label>Ride</label><div class="control"><select name="rideId"><option value="">General account issue</option><% taxiRides.forEach(function(row){ %><option value="<%= row.id %>"><%= row.rideRef || row.bookingRef %></option><% }) %></select></div></div><div class="field"><label>Category</label><div class="control"><select name="category"><option value="safety">Safety</option><option value="collision">Collision</option><option value="harassment">Conduct or harassment</option><option value="lost_item">Lost item</option><option value="vehicle">Vehicle</option><option value="route">Route issue</option><option value="payment">Payment</option><option value="other">Other</option></select></div></div><div class="field"><label>Severity</label><div class="control"><select name="severity"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option><option value="critical">Critical</option></select></div></div><div class="field full"><label>Description</label><div class="control"><textarea name="description" required></textarea></div></div></div><button class="btn btnPrimary" type="submit">Submit protected report</button></form></div><div class="card"><div class="cardHead"><div class="cardTitle"><h3>My reports</h3><p>Only reports belonging to this account are shown.</p></div><span class="badge info"><%= taxiIncidents.length %></span></div><div class="tableWrap"><table><thead><tr><th>Case</th><th>Ride</th><th>Category</th><th>Severity</th><th>Status</th><th>Actions</th></tr></thead><tbody><% taxiIncidents.forEach(function(row){ %><tr><td><%= row.id %></td><td><%= row.rideId || '-' %></td><td><%= row.category %></td><td><span class="badge <%= /critical|high/.test(row.severity)?'bad':'warn' %>"><%= row.severity %></span></td><td><span class="badge <%= statusClass(row.status) %>"><%= row.status %></span></td><td><button class="tinyBtn" type="button" data-modal="view" data-type="taxi incident" data-label="<%= row.id %>" data-row-detail="<%= dashboardDetail('taxi_incident', row, row.id) %>" title="View incident details"><i class="fa-regular fa-eye"></i></button></td></tr><% }) %><% if(!taxiIncidents.length){ %><tr><td colspan="6">No incidents reported.</td></tr><% } %></tbody></table></div><div class="cardHead"><div class="cardTitle"><h3>Earnings</h3><p>Eligible earnings are created only after a paid ride is completed.</p></div><span class="badge ok"><%= taxiEarnings.length %></span></div></div></div>
</section>
<% } %>
<% } %>

<script nonce="<%= cspNonce %>">
(function(){
  var csrf=<%- toScriptJson(csrfToken || '') %>;
  function qs(s,r){return (r||document).querySelector(s);} function qsa(s,r){return Array.from((r||document).querySelectorAll(s));}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];});}
  function msg(el,text,kind){if(!el)return;el.textContent=text||'';el.className='travelMessage'+(text?' show '+(kind||'error'):'');}
  function uid(prefix){return prefix+'-'+Date.now()+'-'+Math.random().toString(36).slice(2);}
  async function api(url,options){var res=await fetch(url,Object.assign({headers:{'Content-Type':'application/json','Accept':'application/json','X-CSRF-Token':csrf}},options||{}));var data=await res.json().catch(function(){return{};});if(!res.ok)throw new Error(data.message||data.error||'Request failed');return data.result||data;}

  var searchForm=qs('#agentFlightSearchForm'); var lastSearchCustomer=null;
  if(searchForm){searchForm.addEventListener('submit',async function(event){event.preventDefault();var m=qs('#agentFlightSearchMessage');msg(m,'Searching current supplier fares…','success');var fd=new FormData(searchForm);var payload=Object.fromEntries(fd.entries());lastSearchCustomer={customerName:payload.customerName,customerPhone:payload.customerPhone,customerEmail:payload.customerEmail};delete payload.customerName;delete payload.customerPhone;delete payload.customerEmail;payload.adults=Number(payload.adults||1);payload.children=Number(payload.children||0);payload.infants=Number(payload.infants||0);if(!payload.returnDate)delete payload.returnDate;try{var result=await api('/company/flights/search',{method:'POST',body:JSON.stringify(payload)});var offers=(result.roundTrips&&result.roundTrips.length?result.roundTrips:result.outbound)||[];qs('#agentFlightOfferCount').textContent=offers.length+' offer'+(offers.length===1?'':'s');qs('#agentFlightOffers').innerHTML=offers.length?offers.map(function(o,i){return '<article class="formPanel"><div class="cardHead"><div class="cardTitle"><h3>'+esc(o.airline&&o.airline.name||'Flight')+'</h3><p>'+esc(o.origin&&o.origin.iataCode||'')+' ⇄ '+esc(o.destination&&o.destination.iataCode||'')+' · '+esc(o.fare&&o.fare.name||o.fare&&o.fare.cabinClass||'')+'</p></div><strong>'+esc(o.price&&o.price.currency||'')+' '+Number(o.price&&o.price.total||0).toLocaleString('en-GB')+'</strong></div><p class="muted">Baggage: '+Number(o.baggage&&o.baggage.checkedKg||o.baggage&&o.baggage.outbound&&o.baggage.outbound.checkedKg||0)+' kg checked · '+(o.policy&&o.policy.refundable?'Refundable':'Restrictions apply')+'</p><button class="btn btnPrimary" type="button" data-save-offer="'+i+'"><i class="fa-solid fa-file-circle-plus"></i> Save customer quote</button></article>';}).join(''):'<div class="notice">No current supplier offer matches this search.</div>';qsa('[data-save-offer]').forEach(function(button){button.addEventListener('click',async function(){button.disabled=true;try{var o=offers[Number(button.dataset.saveOffer)];var saved=await api('/company/flights/quotes',{method:'POST',body:JSON.stringify({offerId:o.offerId,offerToken:o.offerToken,customerName:lastSearchCustomer.customerName,customerPhone:lastSearchCustomer.customerPhone,customerEmail:lastSearchCustomer.customerEmail,sendNow:true})});var shareUrl=location.origin+(saved.sharePath||'');if(shareUrl&&navigator.clipboard){navigator.clipboard.writeText(shareUrl).catch(function(){});}msg(m,'Quote '+(saved.quote&&saved.quote.quoteRef||'')+' saved. The private customer link was copied. Open Customer quotes to copy it again.','success');setTimeout(function(){window.location.reload();},1800);}catch(error){msg(m,error.message);}finally{button.disabled=false;}});});msg(m,offers.length?'Current fares loaded. Choose an offer to save a protected quote.':'No matching live fare was found.',offers.length?'success':'error');}catch(error){msg(m,error.message);}});}

  var quoteSelect=qs('#agentQuoteSelect'), travelerRows=qs('#agentTravelerRows'), bookingForm=qs('#agentQuoteBookingForm');
  function renderTravelers(){if(!quoteSelect||!travelerRows)return;var option=quoteSelect.options[quoteSelect.selectedIndex];var count=Number(option&&option.dataset.count||0);if(bookingForm&&option){bookingForm.contactName.value=option.dataset.name||'';bookingForm.phone.value=option.dataset.phone||'';bookingForm.email.value=option.dataset.email||'';}travelerRows.innerHTML=count?Array.from({length:count},function(_,i){return '<section class="formPanel"><h4>Traveler '+(i+1)+'</h4><div class="formGrid"><div class="field"><label>Passenger type</label><div class="control"><select data-traveler="passengerType"><option value="adult">Adult</option><option value="child">Child</option><option value="infant">Infant</option></select></div></div><div class="field"><label>Title</label><div class="control"><select data-traveler="title"><option>Mr</option><option>Ms</option><option>Mrs</option><option>Miss</option><option>Dr</option></select></div></div><div class="field"><label>First name</label><div class="control"><input data-traveler="firstName" required></div></div><div class="field"><label>Last name</label><div class="control"><input data-traveler="lastName" required></div></div><div class="field"><label>Sex</label><div class="control"><select data-traveler="sex"><option value="male">Male</option><option value="female">Female</option><option value="unspecified">Prefer not to state</option></select></div></div><div class="field"><label>Nationality</label><div class="control"><input data-traveler="nationality" required></div></div><div class="field"><label>Document type</label><div class="control"><select data-traveler="documentType"><option value="passport">Passport</option><option value="national_id">National ID</option><option value="travel_document">Travel document</option></select></div></div><div class="field"><label>Document number</label><div class="control"><input data-traveler="documentNumber" required autocomplete="off"></div></div><div class="field"><label>Document expiry</label><div class="control"><input type="date" data-traveler="documentExpiry" required></div></div><div class="field"><label>Issuing country</label><div class="control"><input data-traveler="documentIssuingCountry" required></div></div></div></section>';}).join(''):'<div class="notice">Select a quote to enter traveler details.</div>';}
  function labelTravelerControls(){if(!travelerRows)return;qsa('.formPanel',travelerRows).forEach(function(row,index){qsa('[data-traveler]',row).forEach(function(control){var label=qs('label',control.closest('.field'));control.setAttribute('aria-label','Traveler '+(index+1)+' '+String(label&&label.textContent||control.dataset.traveler||'field').trim());});});}
  if(travelerRows){new MutationObserver(labelTravelerControls).observe(travelerRows,{childList:true,subtree:true});}
  if(quoteSelect){quoteSelect.addEventListener('change',renderTravelers);renderTravelers();}
  if(bookingForm){bookingForm.addEventListener('submit',async function(event){event.preventDefault();var m=qs('#agentQuoteBookingMessage');msg(m,'Creating protected flight order…','success');try{var travelers=qsa('#agentTravelerRows .formPanel').map(function(row){var out={};qsa('[data-traveler]',row).forEach(function(input){out[input.dataset.traveler]=input.value;});return out;});var idem=uid('agent-flight-order');var created=await api('/company/flights/quotes/'+encodeURIComponent(quoteSelect.value)+'/orders',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','X-CSRF-Token':csrf,'Idempotency-Key':idem},body:JSON.stringify({contactName:bookingForm.contactName.value,phone:bookingForm.phone.value,email:bookingForm.email.value,travelers:travelers,idempotencyKey:idem})});var ref=created.booking&&created.booking.bookingRef;var paymentIdem=uid('agent-flight-payment');var payment=await api('/company/flights/orders/'+encodeURIComponent(ref)+'/payment',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','X-CSRF-Token':csrf,'Idempotency-Key':paymentIdem},body:JSON.stringify({provider:bookingForm.provider.value,idempotencyKey:paymentIdem})});msg(m,'Booking '+ref+' created. '+(payment.checkoutUrl?'Opening secure payment…':'Payment initiated.'),'success');if(payment.checkoutUrl)window.location.assign(payment.checkoutUrl);else setTimeout(function(){window.location.reload();},800);}catch(error){msg(m,error.message);}});}

  qsa('[data-copy-quote-link]').forEach(function(button){button.addEventListener('click',async function(){var url=location.origin+button.dataset.copyQuoteLink;try{await navigator.clipboard.writeText(url);button.innerHTML='<i class="fa-solid fa-check"></i>';setTimeout(function(){button.innerHTML='<i class="fa-solid fa-link"></i>';},1200);}catch(error){window.prompt('Copy private quote link',url);}});});

  qsa('[data-agent-change-form],[data-agent-refund-form]').forEach(function(form){var select=qs('[data-request-order]',form);form.addEventListener('submit',function(event){if(!select.value){event.preventDefault();return;}form.action='/company/flights/orders/'+encodeURIComponent(select.value)+(form.hasAttribute('data-agent-change-form')?'/changes':'/refunds');});});

  qsa('[data-driver-online]').forEach(function(button){button.addEventListener('click',function(){var driver=button.dataset.driverOnline, vehicle=button.dataset.vehicle, target=qs('[data-driver-message="'+driver+'"]');if(!navigator.geolocation){return msg(target,'Location is not supported by this device.');}msg(target,'Getting your current location…','success');navigator.geolocation.getCurrentPosition(async function(pos){try{await api('/api/v1/taxi/driver/availability',{method:'POST',body:JSON.stringify({driverProfileId:driver,vehicleId:vehicle,status:'available'})});await api('/api/v1/taxi/driver/location',{method:'POST',body:JSON.stringify({driverProfileId:driver,latitude:pos.coords.latitude,longitude:pos.coords.longitude,accuracyMeters:pos.coords.accuracy})});msg(target,'You are online and ready for automatic dispatch.','success');setTimeout(function(){window.location.reload();},700);}catch(error){msg(target,error.message);}},function(){msg(target,'Allow location access to go online safely.');},{enableHighAccuracy:true,timeout:12000,maximumAge:30000});});});
  qsa('[data-driver-offline]').forEach(function(button){button.addEventListener('click',async function(){var driver=button.dataset.driverOffline,target=qs('[data-driver-message="'+driver+'"]');try{await api('/api/v1/taxi/driver/availability',{method:'POST',body:JSON.stringify({driverProfileId:driver,vehicleId:button.dataset.vehicle,status:'offline'})});msg(target,'You are offline.','success');setTimeout(function(){window.location.reload();},500);}catch(error){msg(target,error.message);}});});
})();
</script>
