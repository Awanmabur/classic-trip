<% const ctRoute = typeof routeDisplay === 'function' ? routeDisplay : function(origin, destination, fallback){ const from = String(origin || '').trim(); const to = String(destination || '').trim(); if(from && to) return from + ' ⇄ ' + to; return String(fallback || from || to || '').trim().replace(/\s+(?:to|→|->|↔|⇄)\s+/gi, ' ⇄ '); }; %>
<%
  const flightQuotes = dashboardData?.flightAgentQuotes || [];
  const flightOrders = dashboardData?.flightOrders || [];
  const flightTravelers = dashboardData?.flightTravelers || [];
  const flightTickets = dashboardData?.flightTickets || [];
  const flightChanges = dashboardData?.flightChangeRequests || [];
  const flightRefunds = dashboardData?.flightRefundRequests || [];
  const airports = dashboardData?.airports || [];
  const taxiClasses = dashboardData?.vehicleClasses || [];
  const taxiVehicles = dashboardData?.taxiVehicles || [];
  const taxiDrivers = dashboardData?.taxiDrivers || [];
  const taxiRides = dashboardData?.taxiRides || [];
  const taxiAvailability = dashboardData?.driverAvailabilities || [];
  const taxiIncidents = dashboardData?.taxiIncidents || [];
  const taxiEarnings = dashboardData?.driverEarnings || [];
  const mobilityDriverCandidates = dashboardData?.mobilityDriverCandidates || [];
  const partnerCategory = String(dashboardData?.company?.main?.partnerCategory || dashboardData?.serviceProfile?.partnerCategory || dashboardData?.company?.partnerCategory || dashboardData?.company?.settings?.partnerCategory || '').toLowerCase();
  const individualDriver = ['boda_rider','car_driver'].includes(partnerCategory);
  const fmtDate = function(value){ if(!value) return '-'; const d = new Date(value); return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString('en-GB'); };
  const money = function(value,currency){ return `${currency || dashboardData?.company?.main?.currency || dashboardData?.company?.defaultCurrency || platformConfig.defaultCurrency || ''} ${Number(value || 0).toLocaleString('en-GB')}`.trim(); };
  const statusClass = function(value){ const s=String(value||'').toLowerCase(); return /active|sent|accepted|converted|confirmed|ticketed|verified|available|completed|issued|refunded/.test(s) ? 'ok' : /failed|rejected|cancelled|expired|suspended|safety/.test(s) ? 'bad' : 'warn'; };
  const dashboardDetail = function(entity, row, label){ return encodeURIComponent(JSON.stringify({ entity: entity, id: row?.id || row?.bookingRef || row?.quoteRef || row?.ticketNumber || '', label: label || row?.bookingRef || row?.quoteRef || row?.id || entity, record: row || {} })); };
  const shouldRenderTravelSection = function(page){ return String(activeDashboardPage || '') === page; };
%>

