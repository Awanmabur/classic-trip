" <%= row.operationalStatus==='archived'?'selected':'' %>>Archived</option></select><button class="tinyBtn" type="submit" title="Save operating status"><i class="fa-solid fa-floppy-disk"></i></button></form></div></td></tr><% }) %><% if(!taxiVehicles.length){ %><tr><td colspan="6">No vehicle submitted yet.</td></tr><% } %></tbody></table></div></div></div>
