e="flight change request" data-label="<%= row.requestRef %>" data-row-detail="<%= dashboardDetail('flight_change_request', row, row.requestRef) %>" title="View change request"><i class="fa-regular fa-eye"></i></button></td></tr><% }) %><% if(!flightChanges.length){ %><tr><td colspan="5">No change requests.</td></tr><% } %></tbody></table></div></div></div>
