<%
  const network = dashboardData?.partnerNetwork || {};
  const flightAgents = network.flightAgents || [];
  const mobilityPartners = network.mobilityPartners || [];
  const mobilityDrivers = network.mobilityDrivers || [];
  const mobilityVehicles = network.mobilityVehicles || [];
  const mobilityDispatch = network.dispatch || [];
  const mobilitySafety = network.safetyIncidents || [];
  const networkDate = function(value){ if(!value) return '-'; const date = new Date(value); return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleDateString('en-GB'); };
  const networkStatus = function(value){ const status = String(value || '').toLowerCase(); return /active|verified|approved|available|completed|clear/.test(status) ? 'ok' : /rejected|failed|expired|suspended|critical|cancelled/.test(status) ? 'bad' : 'warn'; };
  const mobilityByCategory = function(category){ return mobilityPartners.filter(function(row){ return row.partnerCategory === category; }); };
%>

<section class="section" id="flight-agents">
  <div class="hero"><div class="heroGrid"><div class="welcome"><div><span class="badge info"><i class="fa-solid fa-plane-departure"></i> Agency network</span><h2>Flight agents</h2><p>Approve accredited agencies, control supplier access and monitor quotes, bookings, tickets, changes, refunds, commission and settlement without giving agents airline inventory controls.</p></div><div class="heroActions"><button class="btn btnPrimary" data-modal="create" data-type="partner"><i class="fa-solid fa-plus"></i> Add flight agent</button><a class="btn" href="/admin/flight-dashboard"><i class="fa-solid fa-sliders"></i> Flight supply</a></div></div><div class="livePanel"><div class="liveHeader"><strong>Agency controls</strong><span class="badge ok"><%= flightAgents.length %> agents</span></div><div class="liveList"><div class="liveItem"><span>Accreditation and licence</span><strong>Super Admin</strong></div><div class="liveItem"><span>Supplier access</span><strong>Permissioned</strong></div><div class="liveItem"><span>Fare and inventory ownership</span><strong>Platform / supplier</strong></div><div class="liveItem"><span>Agent role</span><strong>Search, quote, book, support</strong></div></div></div></div></div>
  <div class="card"><div class="cardHead"><div class="cardTitle"><h3>Verified agency pipeline</h3><p>Real agency records and operational counts from MongoDB.</p></div></div><div class="tableWrap"><table><thead><tr><th>Agency</th><th>Country / city</th><th>Licence</th><th>Staff</th><th>Quotes</th><th>Bookings</th><th>Currency</th><th>Status</th><th>Actions</th></tr></thead><tbody><% flightAgents.forEach(function(row){ %><tr><td><strong><%= row.name %></strong></td><td><%= row.country %> · <%= row.city %></td><td><%= row.licenceNumber %></td><td><%= row.staffCount %></td><td><%= row.quoteCount %></td><td><%= row.bookingCount %></td><td><%= row.currency %></td><td><span class="badge <%= networkStatus(row.verificationStatus) %>"><%= row.verificationStatus %></span></td><td><div class="travelActions"><a class="tinyBtn" href="/admin/kyc" title="Review agency verification"><i class="fa-solid fa-id-card"></i></a><a class="tinyBtn" href="/admin/flight-dashboard" title="Review supplier access"><i class="fa-solid fa-sliders"></i></a></div></td></tr><% }) %><% if(!flightAgents.length){ %><tr><td colspan="9">No flight-agent application has been submitted.</td></tr><% } %></tbody></table></div></div>
</section>

<% const categoryPages = [
  { id:'boda-riders', title:'Boda riders', category:'boda_rider', icon:'fa-motorcycle', description:'Individual motorcycle riders. They manage only their own approved boda, availability, assigned rides, safety reports, earnings and payouts.' },
  { id:'car-drivers', title:'Car drivers', category:'car_driver', icon:'fa-car-side', description:'Individual car drivers. They manage only their own approved car, availability, assigned rides, safety reports, earnings and payouts.' },
  { id:'fleet-owners', title:'Fleet & rental owners', category:'fleet_owner', icon:'fa-warehouse', description:'Owners of verified boda, taxi, rental-car or van fleets. They manage their own vehicles and approved drivers while platform pricing and dispatch remain central.' },
  { id:'mobility-companies', title:'Mobility companies', category:'taxi_company', icon:'fa-building', description:'Registered taxi, airport-transfer and local-mobility organisations with verified fleet, staff, drivers, compliance and settlement.' }
]; %>
<% categoryPages.forEach(function(page){ const rows = mobilityByCategory(page.category); %>
<section class="section" id="<%= page.id %>">
  <div class="hero"><div class="heroGrid"><div class="welcome"><div><span class="badge info"><i class="fa-solid <%= page.icon %>"></i> Local mobility</span><h2><%= page.title %></h2><p><%= page.description %></p></div><div class="heroActions"><button class="btn btnPrimary" data-modal="create" data-type="partner"><i class="fa-solid fa-user-plus"></i> Add / invite</button><a class="btn" href="/admin/mobility-drivers"><i class="fa-solid fa-id-card"></i> Driver verification</a><a class="btn" href="/admin/mobility-vehicles"><i class="fa-solid fa-car-on"></i> Vehicle compliance</a></div></div><div class="livePanel"><div class="liveHeader"><strong>Current network</strong><span class="badge <%= rows.length ? 'ok' : 'warn' %>"><%= rows.length %> account<%= rows.length===1?'':'s' %></span></div><div class="liveList"><div class="liveItem"><span>Pricing</span><strong>Platform controlled</strong></div><div class="liveItem"><span>Dispatch</span><strong>Automatic</strong></div><div class="liveItem"><span>Verification</span><strong>Super Admin</strong></div><div class="liveItem"><span>Partner data</span><strong>Tenant scoped</strong></div></div></div></div></div>
  <div class="card"><div class="tableWrap"><table><thead><tr><th>Partner</th><th>Country / city</th><th>Vehicles</th><th>Drivers</th><th>Online</th><th>Rides</th><th>Payout rule</th><th>Status</th><th>Actions</th></tr></thead><tbody><% rows.forEach(function(row){ %><tr><td><strong><%= row.name %></strong><br><small><%= row.partnerLabel %></small></td><td><%= row.country %> · <%= row.city %></td><td><%= row.vehicleCount %></td><td><%= row.driverCount %></td><td><%= row.activeDriverCount %></td><td><%= row.rideCount %></td><td><%= row.payoutPercent %>% driver/fleet share</td><td><span class="badge <%= networkStatus(row.verificationStatus) %>"><%= row.verificationStatus %></span></td><td><div class="travelActions"><a class="tinyBtn" href="/admin/kyc" title="Review partner verification"><i class="fa-solid fa-id-card"></i></a><a class="tinyBtn" href="/admin/mobility-drivers" title="Review drivers"><i class="fa-solid fa-user-check"></i></a><a class="tinyBtn" href="/admin/mobility-vehicles" title="Review vehicles"><i class="fa-solid fa-car-on"></i></a></div></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="9">No <%= page.title.toLowerCase() %> have been registered.</td></tr><% } %></tbody></table></div></div>
</section>
<% }) %>

<section class="section" id="mobility-drivers">
  <div class="hero"><div class="heroGrid"><div class="welcome"><div><span class="badge warn"><i class="fa-solid fa-id-card"></i> Restricted verification</span><h2>Driver and rider verification</h2><p>Review identity, licence validity, background checks, safety training, assigned vehicle and operational eligibility before a rider or driver may go online.</p></div></div><div class="livePanel"><div class="liveHeader"><strong>Verification rules</strong><span class="badge info"><%= mobilityDrivers.length %> profiles</span></div><div class="liveList"><div class="liveItem"><span>Identity</span><strong>Required</strong></div><div class="liveItem"><span>Background check</span><strong>Clear</strong></div><div class="liveItem"><span>Safety training</span><strong>Completed</strong></div><div class="liveItem"><span>Approved vehicle</span><strong>Required</strong></div></div></div></div></div>
  <div class="card"><div class="tableWrap"><table><thead><tr><th>Driver</th><th>Partner</th><th>Licence</th><th>Expiry</th><th>Vehicle</th><th>Identity</th><th>Background</th><th>Training</th><th>Status</th><th>Review</th></tr></thead><tbody><% mobilityDrivers.forEach(function(row){ %><tr><td><strong><%= row.driverNumber %></strong></td><td><%= row.partnerName %></td><td><%= row.licenceClass %> · ••••<%= row.licenceLast4 %></td><td><%= networkDate(row.licenceExpiresAt) %></td><td><%= row.vehicleRegistration %></td><td><span class="badge <%= row.identityVerified ? 'ok' : 'warn' %>"><%= row.identityVerified ? 'Verified' : 'Pending' %></span></td><td><span class="badge <%= networkStatus(row.backgroundCheckStatus) %>"><%= row.backgroundCheckStatus %></span></td><td><span class="badge <%= row.safetyTrainingCompletedAt ? 'ok' : 'warn' %>"><%= row.safetyTrainingCompletedAt ? 'Complete' : 'Pending' %></span></td><td><span class="badge <%= networkStatus(row.verificationStatus) %>"><%= row.verificationStatus %></span></td><td><form class="inlineReviewForm adminMobilityReview" method="POST" action="/admin/mobility/drivers/<%= row.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="verificationStatus" aria-label="Driver verification decision" required><option value="">Decision</option><option value="verified">Verify</option><option value="rejected">Reject</option><option value="suspended">Suspend</option><option value="expired">Mark expired</option></select><select name="assignedVehicleId" aria-label="Approved vehicle"><option value="">Approved vehicle</option><% mobilityVehicles.filter(function(vehicle){ return vehicle.companyId === row.companyId && vehicle.verificationStatus === 'verified'; }).forEach(function(vehicle){ %><option value="<%= vehicle.id %>" <%= row.assignedVehicleId === vehicle.id ? 'selected' : '' %>><%= vehicle.registrationNumber %> · <%= vehicle.makeModel %></option><% }) %></select><input type="hidden" name="identityVerified" value="true"><input type="hidden" name="backgroundCheckStatus" value="clear"><input type="hidden" name="safetyTrainingCompletedAt" value="<%= new Date().toISOString() %>"><input name="reviewNotes" placeholder="Required review note" required><button class="tinyBtn" type="submit" title="Save driver review"><i class="fa-solid fa-check"></i></button></form></td></tr><% }) %><% if(!mobilityDrivers.length){ %><tr><td colspan="10">No rider or driver profile is awaiting review.</td></tr><% } %></tbody></table></div></div>
</section>

<section class="section" id="mobility-vehicles">
  <div class="hero"><div class="heroGrid"><div class="welcome"><div><span class="badge warn"><i class="fa-solid fa-car-on"></i> Fleet compliance</span><h2>Vehicle compliance</h2><p>Review ownership, class, passenger capacity, insurance, inspection and registration expiry before a boda, car, taxi or rental vehicle may receive work.</p></div></div><div class="livePanel"><div class="liveHeader"><strong>Fleet records</strong><span class="badge info"><%= mobilityVehicles.length %> vehicles</span></div><div class="liveList"><div class="liveItem"><span>Insurance</span><strong>Valid</strong></div><div class="liveItem"><span>Inspection</span><strong>Valid</strong></div><div class="liveItem"><span>Registration</span><strong>Valid</strong></div><div class="liveItem"><span>Operational status</span><strong>Platform enforced</strong></div></div></div></div></div>
  <div class="card"><div class="tableWrap"><table><thead><tr><th>Vehicle</th><th>Partner</th><th>Make / model</th><th>Class</th><th>Capacity</th><th>Inspection</th><th>Insurance</th><th>Registration</th><th>Status</th><th>Review</th></tr></thead><tbody><% mobilityVehicles.forEach(function(row){ %><tr><td><strong><%= row.registrationNumber %></strong></td><td><%= row.partnerName %></td><td><%= row.makeModel %> · <%= row.year %></td><td><%= row.vehicleClassId %></td><td><%= row.passengerCapacity %></td><td><%= networkDate(row.inspectionExpiresAt) %></td><td><%= networkDate(row.insuranceExpiresAt) %></td><td><%= networkDate(row.registrationExpiresAt) %></td><td><span class="badge <%= networkStatus(row.verificationStatus) %>"><%= row.verificationStatus %> / <%= row.operationalStatus %></span></td><td><form class="inlineReviewForm adminMobilityReview" method="POST" action="/admin/mobility/vehicles/<%= row.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><select name="verificationStatus" aria-label="Vehicle verification decision" required><option value="">Decision</option><option value="verified">Verify</option><option value="rejected">Reject</option><option value="expired">Mark expired</option></select><input name="reviewNotes" placeholder="Required review note" required><button class="tinyBtn" type="submit" title="Save vehicle review"><i class="fa-solid fa-check"></i></button></form></td></tr><% }) %><% if(!mobilityVehicles.length){ %><tr><td colspan="10">No mobility vehicle has been submitted.</td></tr><% } %></tbody></table></div></div>
</section>

<section class="section" id="mobility-dispatch">
  <div class="hero"><div class="heroGrid"><div class="welcome"><div><span class="badge info"><i class="fa-solid fa-location-crosshairs"></i> Platform dispatch</span><h2>Dispatch and live rides</h2><p>Monitor scheduled and immediate rides, automatic driver assignment, pickup, trip state and operational exceptions. Partners cannot manually choose customer jobs or change the accepted fare.</p></div><div class="heroActions"><a class="btn btnPrimary" href="/admin/taxi-dashboard"><i class="fa-solid fa-sliders"></i> Mobility supply controls</a></div></div><div class="livePanel"><div class="liveHeader"><strong>Live operations</strong><span class="badge info"><%= mobilityDispatch.length %> rides</span></div><div class="liveList"><div class="liveItem"><span>Quote</span><strong>Server authoritative</strong></div><div class="liveItem"><span>Assignment</span><strong>Atomic</strong></div><div class="liveItem"><span>Pickup verification</span><strong>PIN protected</strong></div><div class="liveItem"><span>Customer tracking</span><strong>Private</strong></div></div></div></div></div>
  <div class="card"><div class="tableWrap"><table><thead><tr><th>Ride</th><th>Journey</th><th>Partner</th><th>Driver</th><th>Vehicle</th><th>Scheduled</th><th>Fare</th><th>Status</th><th>Action</th></tr></thead><tbody><% mobilityDispatch.forEach(function(row){ %><tr><td><strong><%= row.rideRef %></strong></td><td><%= row.pickup %> → <%= row.destination %></td><td><%= row.partnerName %></td><td><%= row.driverNumber %></td><td><%= row.vehicleRegistration %></td><td><%= networkDate(row.scheduledFor) %></td><td><%= row.currency %> <%= Number(row.amount || 0).toLocaleString('en-GB') %></td><td><span class="badge <%= networkStatus(row.status) %>"><%= row.status %></span></td><td><div class="travelActions"><% if(['paid','scheduled','dispatch_pending','offering'].includes(row.status)){ %><form method="POST" action="/admin/mobility/rides/<%= row.id %>/dispatch"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="tinyBtn" type="submit" title="Retry automatic dispatch"><i class="fa-solid fa-rotate"></i></button></form><% } %></div></td></tr><% }) %><% if(!mobilityDispatch.length){ %><tr><td colspan="9">No ride request has entered dispatch.</td></tr><% } %></tbody></table></div></div>
</section>

<section class="section" id="mobility-safety">
  <div class="hero"><div class="heroGrid"><div class="welcome"><div><span class="badge bad"><i class="fa-solid fa-shield-halved"></i> Restricted safety queue</span><h2>Safety and incidents</h2><p>Review collision, harassment, SOS, lost-item, vehicle, route and payment incidents with restricted access, audit history and clear ownership.</p></div></div><div class="livePanel"><div class="liveHeader"><strong>Open safety records</strong><span class="badge <%= mobilitySafety.length ? 'warn' : 'ok' %>"><%= mobilitySafety.length %> records</span></div><div class="liveList"><div class="liveItem"><span>Critical cases</span><strong>Immediate restriction</strong></div><div class="liveItem"><span>Evidence</span><strong>Private</strong></div><div class="liveItem"><span>Access</span><strong>Least privilege</strong></div><div class="liveItem"><span>Audit</span><strong>Immutable</strong></div></div></div></div></div>
  <div class="card"><div class="tableWrap"><table><thead><tr><th>Case</th><th>Ride</th><th>Partner</th><th>Category</th><th>Severity</th><th>Description</th><th>Reported</th><th>Status</th></tr></thead><tbody><% mobilitySafety.forEach(function(row){ %><tr><td><strong><%= row.id %></strong></td><td><%= row.rideId %></td><td><%= row.partnerName %></td><td><%= row.category %></td><td><span class="badge <%= networkStatus(row.severity) %>"><%= row.severity %></span></td><td><%= row.description %></td><td><%= networkDate(row.createdAt) %></td><td><span class="badge <%= networkStatus(row.status) %>"><%= row.status %></span></td></tr><% }) %><% if(!mobilitySafety.length){ %><tr><td colspan="8">No mobility safety incident has been reported.</td></tr><% } %></tbody></table></div></div>
</section>
