<section class="section" id="settings">
  <div class="grid2">
    <div class="card">
      <div class="cardHead"><div class="cardTitle"><h3>Platform settings</h3><p>Global fallback commercial terms, promoter funding, customer discounts, currencies, customer fees and inventory holds. Partner-specific agreements are managed from Payments.</p></div></div>
      <form class="formPanel" id="settingsForm" method="POST" action="/admin/settings">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <div class="formGrid">
          <div class="field"><label>Default earning model</label><div class="control"><i class="fa-solid fa-scale-balanced"></i><select name="commercialModel"><option value="percentage_commission" <%= platformConfig.commercialModel !== 'fixed_per_unit' ? 'selected' : '' %>>Percentage</option><option value="fixed_per_unit" <%= platformConfig.commercialModel === 'fixed_per_unit' ? 'selected' : '' %>>Fixed per unit</option></select></div></div>
          <div class="field"><label>Default Classic Trip %</label><div class="control"><i class="fa-solid fa-percent"></i><input type="number" min="0" max="100" step="0.01" name="partnerCommissionPercent" value="<%= platformConfig.partnerCommissionPercent %>"></div></div>
          <div class="field"><label>Default fixed amount</label><div class="control"><i class="fa-solid fa-coins"></i><input type="number" min="0" step="1" name="fixedPlatformAmount" value="<%= platformConfig.fixedPlatformAmount || 0 %>"></div></div>
          <div class="field"><label>Default fixed unit</label><div class="control"><select name="fixedUnitBasis"><% ['per_booking','per_passenger','per_ticket','per_room','per_room_night','per_item'].forEach(function(v){ %><option value="<%= v %>" <%= platformConfig.fixedUnitBasis === v ? 'selected' : '' %>><%= v.replace('per_','').replaceAll('_',' ') %></option><% }) %></select></div></div>
          <div class="field"><label>Default promoter reward model</label><div class="control"><select name="promoterRewardModel"><option value="none" <%= platformConfig.promoterRewardModel === 'none' ? 'selected' : '' %>>None</option><option value="fixed_amount" <%= platformConfig.promoterRewardModel === 'fixed_amount' ? 'selected' : '' %>>Fixed amount</option><option value="percentage_of_platform" <%= platformConfig.promoterRewardModel === 'percentage_of_platform' ? 'selected' : '' %>>% of Classic Trip share</option></select></div></div>
          <div class="field"><label>Default promoter fixed amount</label><div class="control"><input type="number" min="0" name="promoterFixedAmount" value="<%= platformConfig.promoterFixedAmount || 0 %>"></div></div>
          <div class="field"><label>Default promoter % of CT share</label><div class="control"><input type="number" min="0" max="100" step="0.01" name="promoterSharePercent" value="<%= platformConfig.promoterSharePercent || 0 %>"></div></div>
          <div class="field"><label>Default customer discount model</label><div class="control"><select name="customerDiscountModel"><option value="none" <%= platformConfig.customerDiscountModel === 'none' ? 'selected' : '' %>>None</option><option value="fixed_amount" <%= platformConfig.customerDiscountModel === 'fixed_amount' ? 'selected' : '' %>>Fixed amount</option><option value="percentage_of_platform" <%= platformConfig.customerDiscountModel === 'percentage_of_platform' ? 'selected' : '' %>>% of Classic Trip share</option></select></div></div>
          <div class="field"><label>Default customer discount amount</label><div class="control"><input type="number" min="0" name="customerDiscountFixedAmount" value="<%= platformConfig.customerDiscountFixedAmount || 0 %>"></div></div>
          <div class="field"><label>Default customer discount % of CT share</label><div class="control"><input type="number" min="0" max="100" step="0.01" name="customerDiscountSharePercent" value="<%= platformConfig.customerDiscountSharePercent || 0 %>"></div></div>
          <div class="field"><label>Customer service fee %</label><div class="control"><i class="fa-solid fa-percent"></i><input type="number" min="0" max="100" step="0.01" name="customerServiceFeePercent" value="<%= platformConfig.customerServiceFeePercent %>" required></div><small class="fieldHelp">Optional customer-facing fee shown before payment. Keep at 0 when the platform earns only from commission.</small></div>
          <div class="field"><label>Customer flat service fee</label><div class="control"><i class="fa-solid fa-coins"></i><input type="number" min="0" step="1" name="customerServiceFeeFlat" value="<%= platformConfig.customerServiceFeeFlat %>" required></div></div>
          <div class="field"><label>Customer tax %</label><div class="control"><i class="fa-solid fa-percent"></i><input type="number" min="0" max="100" step="0.01" name="customerTaxPercent" value="<%= platformConfig.customerTaxPercent %>" required></div></div>
          <div class="field"><label>Hold timer</label><div class="control"><i class="fa-regular fa-clock"></i><input type="number" min="1" max="180" name="holdMinutes" value="<%= platformConfig.holdMinutes %>" required></div></div>
          <div class="field"><label>Default currency</label><div class="control"><i class="fa-solid fa-coins"></i><select name="defaultCurrency" required><% platformConfig.supportedCurrencies.forEach(function(code){ %><option value="<%= code %>" <%= code === platformConfig.defaultCurrency ? 'selected' : '' %>><%= code %></option><% }) %></select></div></div>
          <div class="field"><label>Supported currencies</label><div class="control"><i class="fa-solid fa-coins"></i><input name="supportedCurrencies" value="<%= platformConfig.supportedCurrencies.join(', ') %>" required></div><small class="fieldHelp">Comma-separated ISO currency codes. All company and service forms reuse this list.</small></div>
          <div class="field full"><label>Support message</label><div class="control"><textarea name="supportMessage"><%= platformConfig.supportMessage %></textarea></div></div>
          <div class="field full"><div class="notice"><strong>Flexible agreements:</strong> Global values are fallback only. Super Admin can set a fixed amount or percentage for each partner, listing, bus fare plan/ticket class, or hotel room type. Promoter rewards and customer discounts come only from Classic Trip’s share.</div></div>
        </div>
        <button class="btn btnPrimary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save settings</button>
      </form>
    </div>
    <div class="card"><div class="cardHead"><div class="cardTitle"><h3>Security controls</h3><p>Admin and platform protection settings.</p></div></div><div class="splitGrid"><div class="splitItem"><div class="splitTop"><span>Admin 2FA</span><span class="badge <%= platformMfaEnabled ? 'ok' : 'warn' %>"><%= platformMfaEnabled ? 'Enabled' : 'Temporarily disabled' %></span></div></div><div class="splitItem"><div class="splitTop"><span>Partner KYC required</span><span class="badge ok">Enabled</span></div></div><div class="splitItem"><div class="splitTop"><span>Suspicious payout hold</span><span class="badge warn">Manual review</span></div></div><div class="splitItem"><div class="splitTop"><span>Audit log</span><span class="badge info">Active</span></div></div></div></div>
  </div>
</section>
