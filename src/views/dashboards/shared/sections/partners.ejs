<section class="section" id="partners">
  <div class="grid2">
    <div class="card">
      <div class="cardHead"><div class="cardTitle"><h3>Partner network</h3><p>Approve, suspend, verify, and monitor every provider model supported by Classic Trip.</p></div><button class="btn btnPrimary" data-modal="create" data-type="partner"><i class="fa-solid fa-building-circle-check"></i> Add partner</button></div>
      <div class="innerTabs" data-tab-group="partners-tabs">
        <button type="button" class="tabBtn is-on" data-tab-target="partners-all"><i class="fa-solid fa-building"></i> All</button>
        <button type="button" class="tabBtn" data-tab-target="partners-bus"><i class="fa-solid fa-bus"></i> Bus</button>
        <button type="button" class="tabBtn" data-tab-target="partners-hotel"><i class="fa-solid fa-hotel"></i> Hotel</button>
        <button type="button" class="tabBtn" data-tab-target="partners-flight"><i class="fa-solid fa-plane-departure"></i> Flight agents</button>
        <button type="button" class="tabBtn" data-tab-target="partners-boda"><i class="fa-solid fa-motorcycle"></i> Boda riders</button>
        <button type="button" class="tabBtn" data-tab-target="partners-car"><i class="fa-solid fa-car-side"></i> Car drivers</button>
        <button type="button" class="tabBtn" data-tab-target="partners-fleet"><i class="fa-solid fa-warehouse"></i> Fleet / rental</button>
        <button type="button" class="tabBtn" data-tab-target="partners-mobility-company"><i class="fa-solid fa-building"></i> Mobility companies</button>
        <button type="button" class="tabBtn" data-tab-target="partners-pending"><i class="fa-regular fa-hourglass-half"></i> Pending</button>
      </div>
      <% const partnerTabs = [
        ['partners-all','partnersTable'], ['partners-bus','partnersBusTable'], ['partners-hotel','partnersHotelTable'], ['partners-flight','partnersFlightTable'],
        ['partners-boda','partnersBodaTable'], ['partners-car','partnersCarTable'], ['partners-fleet','partnersFleetTable'], ['partners-mobility-company','partnersMobilityCompanyTable'], ['partners-pending','partnersPendingTable']
      ]; %>
      <% partnerTabs.forEach(function(tab, index){ %>
        <div class="tabPane <%= index === 0 ? 'is-open' : '' %>" id="<%= tab[0] %>"><div class="tableWrap"><table><thead><tr><th>Partner</th><th>Type</th><th>Country</th><th>Listings</th><th>Verification</th><th>Revenue</th><th>Commission</th><th></th></tr></thead><tbody id="<%= tab[1] %>"></tbody></table></div></div>
      <% }) %>
    </div>
    <% const partnerRows = Array.isArray(dashboardData?.partners) ? dashboardData.partners : []; const pendingPartnerRows = partnerRows.filter(function(row){ return /pending|review|submitted/.test((Array.isArray(row) ? row.join(' ') : String(row || '')).toLowerCase()); }); const networkCounts = dashboardData?.partnerNetwork?.serviceCounts || {}; %>
    <div class="card">
      <div class="cardHead"><div class="cardTitle"><h3>Partner onboarding</h3><p>Each account follows its own compliance path before publishing, receiving rides, selling flights, or receiving payouts.</p></div><span class="badge <%= pendingPartnerRows.length ? 'warn' : 'ok' %>"><%= pendingPartnerRows.length.toLocaleString() %> awaiting review</span></div>
      <div class="splitGrid">
        <div class="splitItem"><div class="splitTop"><span>Bus operators</span><strong><%= Number(networkCounts.bus || 0).toLocaleString() %></strong></div><p>Business licence, routes, vehicles, seat maps, operational drivers and dated departures.</p></div>
        <div class="splitItem"><div class="splitTop"><span>Hotel providers</span><strong><%= Number(networkCounts.hotel || 0).toLocaleString() %></strong></div><p>Property identity, licences, rooms, rate plans, dated inventory and payout ownership.</p></div>
        <div class="splitItem"><div class="splitTop"><span>Flight agents</span><strong><%= Number(networkCounts.flight || 0).toLocaleString() %></strong></div><p>Agency accreditation, offices, approved supplier access, staff and customer-support authority.</p></div>
        <div class="splitItem"><div class="splitTop"><span>Local mobility</span><strong><%= Number(networkCounts.localTransport || 0).toLocaleString() %></strong></div><p>Boda riders, car drivers, fleet/rental owners and mobility companies with driver and vehicle compliance.</p></div>
      </div>
      <div class="notice">Approval is evidence-based. Local mobility also requires valid driver identity, licence, background review, safety training, approved vehicle, insurance and inspection before going online.</div>
    </div>
  </div>
</section>
