<%- include('../partials/site-head', { seo }) %>
<%- include('../partials/site-header') %>
<%
  const safeListing = listing || { title: booking.serviceType || 'Classic Trip service' };
  const guest = booking.guestSnapshot || {};
  const passenger = (booking.passengers || [])[0] || {};
  const pricing = booking.pricing || { total: 0, currency: platformConfig.defaultCurrency };
  const reservation = booking.serviceReservation || {};
  const bookingAddons = (Array.isArray(booking.addons) && booking.addons.length)
    ? booking.addons
    : (Array.isArray(pricing.addons) ? pricing.addons : []);
  const addonTotal = Number(pricing.addonTotal || bookingAddons.reduce((sum, addon) => sum + Number(addon.total || addon.lineTotal || 0), 0));
  const tripTypeLabel = booking.tripType === 'round_trip' || (booking.bookingLegs || []).length > 1 ? 'Return ticket' : 'One-way ticket';
  const ticketLegRows = typeof ticketLegs !== 'undefined' ? ticketLegs : [];
  const legs = (ticketLegRows && ticketLegRows.length ? ticketLegRows : []).map(function(leg, index) {
    return Object.assign({ passenger: (booking.passengers || [])[Number(leg.passengerIndex || index)] || {} }, leg);
  });
  const serviceType = String(booking.serviceType || safeListing.serviceType || '').toLowerCase();
  const isBusTicket = serviceType === 'bus';
  const isHotelTicket = serviceType === 'hotel';
  const isFlightTicket = serviceType === 'flight';
  const isTaxiTicket = serviceType === 'local_transport';
  const isTourTicket = serviceType === 'tour';
  const isRentalTicket = serviceType === 'car_rental';
  const isCargoTicket = serviceType === 'cargo';
  const ready = typeof ticketReady !== 'undefined' ? Boolean(ticketReady) : booking.paymentStatus === 'successful';
  const documentLabels = { bus:'bus ticket', hotel:'stay voucher', flight:'flight e-ticket', local_transport:'ride receipt', tour:'tour voucher', car_rental:'rental voucher', cargo:'cargo receipt' };
  const documentLabel = documentLabels[serviceType] || 'booking document';
  const hotelStay = booking.hotelStay || {};
  const roomLabels = (booking.passengers || []).map(row => row.roomNumber || row.seatOrRoom || row.roomType).filter(Boolean);
  const guestCount = Number(hotelStay.adults || 0) + Number(hotelStay.children || 0);
  const firstLeg = (booking.bookingLegs || [])[0] || {};
  const formatInventoryLabel = (value) => {
    const raw = String(value || '').trim();
    if (!raw) return 'Selected inventory';
    if (!isBusTicket) return raw;
    const prefixed = raw.match(/^[A-Za-z](\d+)$/);
    const clean = prefixed ? prefixed[1] : raw.replace(/^Seat\s*(No\.?|Number)?\s*/i, '').trim();
    return `Seat No ${clean || raw}`;
  };
  const formatDate = (value) => value ? new Date(String(value).length === 10 ? value + 'T00:00:00Z' : value).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric', timeZone:'UTC' }) : 'Not set';
  const routePoint = (point) => typeof point === 'string' ? point : (point?.address || point?.name || point?.city || point?.district || point?.iataCode || 'Not set');
  const flightRoute = (booking.bookingLegs || []).map(leg => [leg.originAirportId || leg.origin, leg.destinationAirportId || leg.destination].filter(Boolean).join(' → ')).filter(Boolean).join(' / ');
  const detailLabels = {
    bus:'Passenger details', hotel:'Guest and stay details', flight:'Traveler and flight details', local_transport:'Passenger and ride details',
    tour:'Participant and tour details', car_rental:'Renter and vehicle details', cargo:'Sender and shipment details'
  };
  const verificationText = {
    bus:'Show this ticket to authorised staff at boarding. Staff check-in uses the protected scanner.',
    hotel:'Show this confirmed voucher to the stay host or reception. The provider verifies it against the protected reservation.',
    flight:'Present this e-ticket to the authorised agent and follow airline identification, check-in and boarding requirements.',
    local_transport:'Use this protected receipt to confirm the assigned ride. Do not share driver or booking details publicly.',
    tour:'Present this voucher to the tour operator on the booked date for the listed participants.',
    car_rental:'Present this voucher and valid identification to the rental partner at vehicle handover.',
    cargo:'Present this receipt when handing over the shipment. The partner verifies the package, sender and recipient details.',
  };
  const statusBadge = {
    confirmed: 'badgeOk', pending: 'badgeWarn', pending_payment: 'badgeWarn', cancelled: 'badgeHot',
    refunded: 'badgeInfo', partially_refunded: 'badgeInfo'
  }[booking.bookingStatus] || '';
%>
<main class="container ticketPage" style="padding:16px 0 30px">

  <section class="card heroCard" style="margin-bottom:16px">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <div>
        <span class="badge <%= ready ? 'badgeInfo' : 'badgeWarn' %>"><i class="fa-solid <%= ready ? 'fa-ticket' : 'fa-clock' %>"></i> Classic Trip <%= ready ? documentLabel : 'booking status' %></span>
        <h1 class="heroTitle" style="margin:10px 0 6px;font-size:clamp(22px,3vw,32px)"><%= booking.bookingRef %></h1>
        <p class="heroSub" style="margin:0"><%= safeListing.title %><% if (safeListing.origin && safeListing.destination) { %> &nbsp;&bull;&nbsp; <%= safeListing.origin %> &rarr; <%= safeListing.destination %><% } %></p>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
        <span class="badge <%= statusBadge %>"><%= booking.bookingStatus %></span>
        <span class="ticketCode"><%= booking.paymentStatus %></span>
      </div>
    </div>
    <div class="actions" style="margin-top:14px">
      <% if (ready && booking.publicTicketPdfUrl) { %><a class="btn btnPrimary" href="<%= booking.publicTicketPdfUrl %>"><i class="fa-solid fa-file-pdf"></i> Download PDF</a><% } %>
      <a class="btn btnGhost" href="/tickets"><i class="fa-solid fa-magnifying-glass"></i> Find another ticket</a>
      <% if (currentUser) { %><a class="btn btnGhost" href="/booking"><i class="fa-solid fa-list"></i> My bookings</a><% } %>
    </div>
  </section>

  <div class="ticketSplit" style="gap:16px;align-items:start">
    <section class="card" style="padding:20px;display:grid;gap:14px">
      <div class="badge badgeInfo" style="width:max-content"><i class="fa-regular fa-user"></i> <%= detailLabels[serviceType] || 'Customer and service details' %></div>
      <div class="kv">
        <div><span><%= isCargoTicket ? 'Sender' : isRentalTicket ? 'Renter' : isHotelTicket ? 'Lead guest' : isTourTicket ? 'Lead participant' : 'Passenger' %></span><b><%= guest.fullName || passenger.fullName || 'Guest' %></b></div>
        <div><span>Email</span><b><%= guest.email || passenger.email || 'Not provided' %></b></div>
        <div><span>Phone</span><b><%= guest.phone || passenger.phone || 'Not provided' %></b></div>
        <div><span>Service type</span><b><%= documentLabel %></b></div>

        <% if (isBusTicket) { %>
          <div><span>Seat</span><b><%= formatInventoryLabel(passenger.seatOrRoom || passenger.seatNumber) %></b></div>
          <div><span>Trip type</span><b><%= tripTypeLabel %></b></div>
        <% } else if (isHotelTicket) { %>
          <div><span>Room / inventory</span><b><%= roomLabels.join(', ') || formatInventoryLabel(passenger.seatOrRoom) %></b></div>
          <div><span>Check-in</span><b><%= formatDate(hotelStay.checkIn) %></b></div>
          <div><span>Check-out</span><b><%= formatDate(hotelStay.checkOut) %></b></div>
          <div><span>Rooms</span><b><%= Number(hotelStay.roomCount || roomLabels.length || 1) %><%= roomLabels.length ? ' · ' + roomLabels.join(', ') : '' %></b></div>
          <div><span>Guests</span><b><%= guestCount || (booking.passengers || []).length || 1 %></b></div>
          <% if (hotelStay.specialRequests) { %><div><span>Stay requests</span><b><%= hotelStay.specialRequests %></b></div><% } %>
        <% } else if (isFlightTicket) { %>
          <div><span>Travelers</span><b><%= (booking.passengers || []).length || 1 %></b></div>
          <div><span>Itinerary</span><b><%= flightRoute || [safeListing.origin, safeListing.destination].filter(Boolean).join(' → ') || 'Agent itinerary' %></b></div>
          <div><span>Flight</span><b><%= firstLeg.flightNumber || safeListing.flightNumber || 'Agent confirmation' %></b></div>
          <div><span>Departure</span><b><%= firstLeg.departAt ? new Date(firstLeg.departAt).toLocaleString('en-GB') : 'See itinerary' %></b></div>
        <% } else if (isTaxiTicket) { %>
          <div><span>Pickup</span><b><%= routePoint(firstLeg.pickup || firstLeg.origin || reservation.pickupLocation) %></b></div>
          <div><span>Destination</span><b><%= routePoint(firstLeg.destination || reservation.deliveryLocation) %></b></div>
          <div><span>Pickup time</span><b><%= firstLeg.scheduledPickupAt ? new Date(firstLeg.scheduledPickupAt).toLocaleString('en-GB') : (reservation.pickupDate || 'As booked') %></b></div>
          <div><span>Ride type</span><b><%= firstLeg.serviceType || passenger.seatOrRoom || safeListing.vehicleCategory || 'Private ride' %></b></div>
        <% } else if (isTourTicket) { %>
          <div><span>Tour date</span><b><%= formatDate(reservation.serviceDate) %></b></div>
          <div><span>Participants</span><b><%= Number(reservation.participantCount || (booking.passengers || []).length || 1) %></b></div>
          <div><span>Meeting point</span><b><%= reservation.meetingPoint || reservation.pickupLocation || safeListing.address || 'See operator instructions' %></b></div>
          <% if (reservation.language) { %><div><span>Language</span><b><%= reservation.language %></b></div><% } %>
        <% } else if (isRentalTicket) { %>
          <div><span>Vehicle</span><b><%= reservation.vehicleCategory || safeListing.vehicleCategory || 'Reserved vehicle' %></b></div>
          <div><span>Pickup</span><b><%= formatDate(reservation.pickupDate) %><%= reservation.pickupTime ? ' · ' + reservation.pickupTime : '' %></b></div>
          <div><span>Return</span><b><%= formatDate(reservation.returnDate) %><%= reservation.returnTime ? ' · ' + reservation.returnTime : '' %></b></div>
          <div><span>Rental period</span><b><%= Number(reservation.rentalDays || 1) %> day(s)</b></div>
          <div><span>Locations</span><b><%= reservation.pickupLocation || 'Not set' %> → <%= reservation.returnLocation || 'Not set' %></b></div>
          <div><span>Driver option</span><b><%= String(reservation.driverOption || 'self_drive').replace(/_/g, ' ') %></b></div>
        <% } else if (isCargoTicket) { %>
          <div><span>Pickup date</span><b><%= formatDate(reservation.pickupDate) %></b></div>
          <div><span>Route</span><b><%= reservation.pickupLocation || 'Not set' %> → <%= reservation.deliveryLocation || 'Not set' %></b></div>
          <div><span>Shipment</span><b><%= Number(reservation.packageCount || 1) %> package(s) · <%= Number(reservation.weightKg || 0) %> kg · <%= reservation.cargoType || 'Cargo' %></b></div>
          <div><span>Recipient</span><b><%= reservation.recipientName || 'Not set' %><%= reservation.recipientPhone ? ' · ' + reservation.recipientPhone : '' %></b></div>
          <% if (reservation.dimensions) { %><div><span>Dimensions</span><b><%= reservation.dimensions %></b></div><% } %>
          <% if (reservation.cargoDescription) { %><div><span>Description</span><b><%= reservation.cargoDescription %></b></div><% } %>
        <% } %>

        <div><span>Payment</span><b><%= booking.paymentStatus %></b></div>
        <% if (bookingAddons.length) { %>
          <div><span>Optional extras</span><b><%= bookingAddons.map(addon => `${addon.name || 'Add-on'}${Number(addon.quantity || 1) > 1 ? ` × ${addon.quantity}` : ''}`).join(', ') %></b></div>
          <div><span>Add-ons total</span><b><%= money(addonTotal, pricing.currency || platformConfig.defaultCurrency) %></b></div>
        <% } %>
        <div><span>Total</span><b><%= money(pricing.total || 0, pricing.currency || platformConfig.defaultCurrency) %></b></div>
        <% if (booking.bookedAt || booking.createdAt) { %><div><span>Booked</span><b><%= new Date(booking.bookedAt || booking.createdAt).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></b></div><% } %>
      </div>
      <p class="muted" style="margin:4px 0 0;font-size:12px;font-weight:780;line-height:1.6"><%= ready ? (verificationText[serviceType] || 'Show this confirmed document to the authorised service partner.') : 'Payment has not been confirmed. Inventory may be temporarily reserved internally, but no valid service document is issued until the payment provider confirms success.' %></p>
    </section>

    <section class="card" style="padding:20px;display:grid;gap:14px;text-align:center">
      <div class="badge <%= ready ? 'badgeOk' : 'badgeWarn' %>" style="margin:0 auto;width:max-content"><i class="fa-solid <%= ready ? 'fa-qrcode' : 'fa-clock' %>"></i> <%= ready ? documentLabel + ' QR' : 'Awaiting payment confirmation' %></div>
      <% if (ready && qrDataUrl) { %>
        <div style="display:flex;justify-content:center;padding:16px;background:rgba(255,255,255,.04);border:1px dashed rgba(255,183,3,.3);border-radius:18px">
          <img src="<%= qrDataUrl %>" alt="Confirmed booking QR code" style="width:180px;height:180px;border-radius:12px">
        </div>
      <% } else { %>
        <div class="qrBox" style="min-height:180px"><span class="muted" style="font-size:12px"><%= ready ? 'QR unavailable. Contact support with ' + booking.bookingRef : 'Your QR and PDF will appear automatically after successful payment confirmation.' %></span></div>
      <% } %>
      <p class="muted" style="margin:0;font-size:12px;font-weight:780;line-height:1.6"><%= ready ? (verificationText[serviceType] || 'The authorised partner validates this document against the live booking record.') : 'A browser redirect is not accepted as proof of payment. Classic Trip waits for the payment provider’s verified server callback.' %></p>
      <% if (ready && booking.publicTicketPdfUrl) { %><a class="btn btnGhost" href="<%= booking.publicTicketPdfUrl %>" style="height:44px"><i class="fa-solid fa-file-pdf"></i> Save as PDF</a><% } %>
    </section>
  </div>

  <% if (ready && legs.length) { %>
  <section class="card" style="padding:20px;margin-top:16px;display:grid;gap:16px">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <div>
        <span class="badge badgeInfo"><i class="fa-solid fa-qrcode"></i> Issued service records</span>
        <h2 style="margin:10px 0 4px;font-size:17px"><%= isBusTicket ? 'Issued tickets' : isHotelTicket ? 'Issued room vouchers' : isFlightTicket ? 'Issued e-tickets' : isTourTicket ? 'Participant vouchers' : 'Issued service vouchers' %></h2>
        <p class="muted" style="margin:0;font-size:13px;font-weight:780">Each record belongs to this paid booking and is verified against the live Classic Trip reservation.</p>
      </div>
      <span class="ticketCode"><%= legs.length %> record<%= legs.length === 1 ? '' : 's' %></span>
    </div>
    <div style="display:grid;gap:12px">
      <% legs.forEach(function(leg, index) { %>
        <article style="padding:16px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.02);display:grid;grid-template-columns:1fr auto;gap:14px;align-items:start">
          <div>
            <span class="badge" style="margin-bottom:10px"><%= leg.legType || ('Record ' + (index + 1)) %></span>
            <div class="kv" style="margin-top:8px">
              <div><span>Reference</span><b><%= leg.ticketNumber || booking.bookingRef %></b></div>
              <div><span><%= isCargoTicket ? 'Sender' : isRentalTicket ? 'Renter' : isTourTicket ? 'Participant' : 'Passenger' %></span><b><%= leg.passengerName || leg.passenger.fullName || guest.fullName || 'Customer' %></b></div>
              <div><span>Service</span><b><%= leg.serviceType || booking.serviceType || 'service' %></b></div>
              <% if (isBusTicket || isHotelTicket) { %><div><span><%= isBusTicket ? 'Seat' : 'Room' %></span><b><%= formatInventoryLabel(leg.seatNumber || leg.roomNumber || leg.passenger.seatOrRoom || passenger.seatOrRoom || '-') %></b></div><% } %>
              <div><span>Status</span><b><%= leg.status || booking.bookingStatus || 'valid' %></b></div>
              <div><span>Verification</span><b><%= leg.checkInStatus || booking.checkInStatus || 'pending' %></b></div>
            </div>
          </div>
          <div class="qrBox" style="width:120px;height:120px;min-width:120px;border-radius:14px">
            <% if (leg.qrDataUrl) { %>
              <img src="<%= leg.qrDataUrl %>" alt="Service QR" style="width:110px;height:110px;border-radius:10px">
            <% } else { %>
              <span style="font-size:11px;color:var(--muted);padding:8px;word-break:break-word"><%= leg.qrTokenPreview || booking.bookingRef %></span>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
  <% } else { %>
  <section class="card" style="padding:20px;margin-top:16px">
    <span class="badge badgeInfo" style="margin-bottom:12px"><i class="fa-solid fa-circle-info"></i> Single service document</span>
    <div class="kv">
      <div><span>Reference</span><b><%= booking.bookingRef %></b></div>
      <div><span><%= isCargoTicket ? 'Sender' : isRentalTicket ? 'Renter' : isTourTicket ? 'Participant' : 'Passenger' %></span><b><%= passenger.fullName || guest.fullName || 'Customer' %></b></div>
      <div><span>Service</span><b><%= documentLabel %></b></div>
      <div><span>Payment</span><b><%= booking.paymentStatus || 'pending' %></b></div>
      <div><span>Status</span><b><%= booking.bookingStatus || 'confirmed' %></b></div>
    </div>
  </section>
  <% } %>

</main>
<%- include('../partials/site-footer') %>
