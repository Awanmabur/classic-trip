<% const ctRoute = typeof routeDisplay === 'function' ? routeDisplay : function(origin, destination, fallback){ const from = String(origin || '').trim(); const to = String(destination || '').trim(); if(from && to) return from + ' ⇄ ' + to; return String(fallback || from || to || '').trim().replace(/\s+(?:to|→|->|↔|⇄)\s+/gi, ' ⇄ '); }; %>
<%- include('../partials/site-head', { seo, bodyClass: 'listingPreviewBody' }) %>
<%- include('../partials/site-header') %>
<%
  const safeAvailability = availability || {};
  const previewData = preview || {};
  const currency = previewData.currency || listing.currency || platformConfig.defaultCurrency;
  const customerFeeFor = (subtotal) => Math.round((Number(subtotal || 0) * Number(platformConfig.customerServiceFeePercent || 0) / 100) + Number(platformConfig.customerServiceFeeFlat || 0) + (Number(subtotal || 0) * Number(platformConfig.customerTaxPercent || 0) / 100));
  const initialBusFare = Number(safeAvailability.fare?.baseAmountPerSeat ?? listing.priceFrom ?? 0);
  const initialBusServiceFee = String(currency || '').toUpperCase() === 'UGX' && initialBusFare >= 1000 ? (initialBusFare <= 30000 ? 1000 : initialBusFare <= 100000 ? 2000 : initialBusFare <= 150000 ? 3000 : 5000) : 0;
  const serviceFee = previewData.serviceFee ?? (listing.serviceType === 'bus' ? initialBusServiceFee : customerFeeFor(listing.priceFrom || 0));
  const initialDisplayedFare = listing.serviceType === 'bus' ? initialBusFare : Number(listing.priceFrom || 0);
  const totalEstimate = previewData.totalEstimate ?? (initialDisplayedFare + serviceFee);
  const serviceIcon = previewData.serviceIcon || 'fa-ticket';
  const rawPreviewSeats = previewData.previewSeats || (safeAvailability.seats || []).slice(0, 32);
  const previewSeats = rawPreviewSeats.map((seat, seatIndex) => { const number = String(seat.seatNumber || (seatIndex + 1)); return Object.assign({}, seat, { displaySeatNumber: number, displaySeatLabel: `Seat No ${number}` }); });
  const previewRooms = previewData.previewRooms || (safeAvailability.rooms || []).slice(0, 12);
  const firstSeat = previewData.firstSeat || (previewSeats.find(seat => seat.status === 'available') || previewSeats[0] || {}).seatNumber || '';
  const firstRoom = previewData.firstRoom || (previewRooms.find(room => room.inventory > 0) || previewRooms[0] || {}).id || '';
  const firstSeatDisplay = (previewSeats.find(seat => seat.seatNumber === firstSeat) || previewSeats[0] || {}).displaySeatLabel || '';
  const selectedPreview = previewData.selectedPreview || (listing.serviceType === 'hotel' ? (previewRooms[0]?.roomType || '') : firstSeatDisplay);
  const selectedValue = listing.serviceType === 'hotel' ? firstRoom : listing.serviceType === 'bus' ? firstSeat : listing.id;
  const addons = previewData.addons || [];
  const previewSchedules = safeAvailability.schedules || [];
  const returnSchedules = safeAvailability.returnSchedules || [];
  const busRoutes = Array.isArray(listing.routes) ? listing.routes : (safeAvailability.routes || []);
  const initialRouteId = String(safeAvailability.selectedRouteId || safeAvailability.schedule?.routeId || '');
  const scheduleTicketClass = (schedule) => String(schedule?.vehicleClass || schedule?.seatMapSnapshot?.vehicleClass || '').toLowerCase() === 'vip' ? 'vip' : 'standard';
  const initialRouteSchedules = initialRouteId ? previewSchedules.filter((schedule) => String(schedule.routeId || '') === initialRouteId) : previewSchedules;
  const ticketClassesAvailable = new Set(initialRouteSchedules.map(scheduleTicketClass));
  const initialTicketClass = scheduleTicketClass(safeAvailability.schedule || initialRouteSchedules.find((schedule) => scheduleTicketClass(schedule) === 'standard') || initialRouteSchedules[0] || {});
  const defaultTicketClass = ticketClassesAvailable.has('standard') ? 'standard' : initialTicketClass;
  const initialFlowConfirmed = true;
  const initialReturnSchedules = returnSchedules;
  const routeStops = safeAvailability.stops || [];
  const selectedJourney = safeAvailability.journey || {};
  const partnerName = previewData.partnerName || listing.partner || company?.name || '';
  const supportPhone = previewData.supportPhone || company?.supportContacts?.phone || company?.supportPhone || company?.phone || '';
  const scheduleLabel = previewData.scheduleLabel || (safeAvailability.schedules || [])[0]?.departureLabel || listing.time || '';
  const ticketAccess = previewData.ticketAccess || 'Issued after confirmed payment';
  const policy = previewData.policy || (listing.bookable ? 'Booking available' : 'Booking unavailable');
  const paymentMethods = previewData.paymentMethods || [];
  const todayDate = new Date();
  const tomorrowDate = new Date(todayDate); tomorrowDate.setUTCDate(tomorrowDate.getUTCDate() + 1);
  const followingDate = new Date(tomorrowDate); followingDate.setUTCDate(followingDate.getUTCDate() + 1);
  const defaultCheckIn = tomorrowDate.toISOString().slice(0, 10);
  const defaultCheckOut = followingDate.toISOString().slice(0, 10);
%>
<main class="container listingPreviewPage" style="padding:16px 0 30px">
  <div class="modal open previewModal" id="viewModal">
    <div class="sheet">
      <div class="sheetTop">
        <div>
          <div class="badge badgeInfo" id="modalType"><i class="fa-solid <%= serviceIcon %>"></i> <%= listing.type || listing.serviceType %></div>
          <div class="sheetTitle" id="modalTitle"><%= listing.title %></div>
          <div class="sheetSub" id="modalSub"><%= [partnerName, ctRoute(listing.from, listing.to, listing.routeLabel), scheduleLabel].filter(Boolean).join(' · ') %></div>
        </div>
        <div class="sheetTopActions">
          <a class="iconbtn" title="Partner profile" href="/companies/<%= listing.companySlug %>"><i class="fa-solid fa-building"></i></a>
          <button class="iconbtn" title="Share" type="button" data-listing-action="share"><i class="fa-solid fa-share-nodes"></i></button>
          <a class="iconbtn" title="Close preview" href="/search"><i class="fa-solid fa-xmark"></i></a>
        </div>
      </div>

      <div class="sheetBody" id="sheetBody">
        <div class="visual">
          <div class="visualHero">
            <img id="modalImg" src="<%= listing.img || listing.media?.[0]?.url %>" alt="<%= listing.title %>">
            <div class="visualText">
              <h3 id="modalHeroTitle">View structure</h3>
              <p id="modalHeroSub"><%= listing.sub || 'Select available seats, rooms, units, or slots before checkout.' %></p>
            </div>
          </div>

          <% if (listing.serviceType === 'bus') { %>
            <div class="selector scheduleSelector">
              <div class="selectorTop">
                <div>
                  <b>Step 3: Route &amp; travel</b>
                  <div class="muted" style="font-size:13px;font-weight:800">Start with Ticket class first, then Journey. After that, choose the route, departure time, boarding stop, and drop-off stop.</div>
                </div>
              </div>
              <% if (previewSchedules.length) { %>
                <div class="busTicketChooser" aria-label="Bus ticket options">
                  <div class="busTicketChoiceGroup">
                    <strong>Ticket class</strong>
                    <div class="ticketChoiceGrid" role="radiogroup" aria-label="Ticket class">
                      <button class="ticketChoice <%= defaultTicketClass === 'standard' ? 'is-active' : '' %>" id="standardTicketChoice" type="button" data-listing-action="ticket-class" data-ticket-class="standard" role="radio" aria-checked="<%= defaultTicketClass === 'standard' ? 'true' : 'false' %>" aria-pressed="<%= defaultTicketClass === 'standard' ? 'true' : 'false' %>" <%= ticketClassesAvailable.has('standard') ? '' : 'disabled' %>><i class="fa-solid fa-ticket"></i><span><b>Standard Ticket</b><small id="standardTicketCount"><%= previewSchedules.filter((schedule) => scheduleTicketClass(schedule) === 'standard').length %> departure(s)</small></span></button>
                      <button class="ticketChoice <%= defaultTicketClass === 'vip' ? 'is-active' : '' %>" id="vipTicketChoice" type="button" data-listing-action="ticket-class" data-ticket-class="vip" role="radio" aria-checked="<%= defaultTicketClass === 'vip' ? 'true' : 'false' %>" aria-pressed="<%= defaultTicketClass === 'vip' ? 'true' : 'false' %>" <%= ticketClassesAvailable.has('vip') ? '' : 'disabled' %>><i class="fa-solid fa-crown"></i><span><b>VIP Ticket</b><small id="vipTicketCount"><%= previewSchedules.filter((schedule) => scheduleTicketClass(schedule) === 'vip').length %> departure(s)</small></span></button>
                    </div>
                  </div>
                  <div class="busTicketChoiceGroup">
                    <strong>Journey</strong>
                    <div class="ticketChoiceGrid" role="group" aria-label="Journey type">
                      <button class="ticketChoice is-active" id="oneWayTicketChoice" type="button" data-listing-action="trip-type" data-trip-type="one_way" aria-pressed="true"><i class="fa-solid fa-arrow-right"></i><span><b>One-way Ticket</b><small>Outbound journey only</small></span></button>
                      <button class="ticketChoice" id="returnTicketChoice" type="button" data-listing-action="trip-type" data-trip-type="round_trip" aria-pressed="false"><i class="fa-solid fa-arrow-right-arrow-left"></i><span><b>Return Ticket</b><small>Outbound and return</small></span></button>
                    </div>
                    <input type="checkbox" id="returnTripToggle" hidden aria-hidden="true">
                  </div>
                </div>
                <div class="busJourneyStepGroup" aria-labelledby="routeTravelLabel">
                  <strong id="routeTravelLabel">Route &amp; travel</strong>
                  <div class="bookingForm busJourneySelectionGrid">
                  <select class="journeyControl journeyRouteControl" id="outboundRouteSelect" aria-label="Select bus route" data-listing-action="outbound-route" required>
                    <option value="" <%= initialRouteId ? '' : 'selected' %> disabled>Select route</option>
                    <% busRoutes.forEach((route) => { const routeValue = route.routeId || route.id; const routeText = ctRoute(route.origin, route.destination, route.label || route.routeName); %>
                      <option value="<%= routeValue %>" <%= String(routeValue) === initialRouteId ? 'selected' : '' %>><%= routeText %></option>
                    <% }) %>
                  </select>
                  <select class="journeyControl journeyScheduleControl" id="outboundScheduleSelect" aria-label="Outbound travel date and time" data-listing-action="outbound-schedule" required <%= initialRouteId ? '' : 'disabled' %>>
                    <option value="" <%= safeAvailability.scheduleId ? '' : 'selected' %> disabled><%= initialRouteId ? `Select ${initialTicketClass === 'vip' ? 'VIP Ticket' : 'Standard Ticket'} date and time` : 'Select route first' %></option>
                    <% previewSchedules.filter((schedule) => !initialRouteId || String(schedule.routeId || '') === initialRouteId).forEach((schedule) => { %>
                      <option value="<%= schedule.id %>" data-route-id="<%= schedule.routeId || '' %>" data-ticket-class="<%= scheduleTicketClass(schedule) %>" <%= schedule.id === safeAvailability.scheduleId ? 'selected' : '' %>><%= scheduleTicketClass(schedule) === 'vip' ? 'VIP Ticket' : 'Standard Ticket' %> · <%= schedule.departureLabel %></option>
                    <% }) %>
                  </select>
                  <select class="journeyControl journeyBoardingControl" id="outboundOriginStopSelect" aria-label="Boarding stop" data-listing-action="outbound-journey" <%= safeAvailability.scheduleId ? '' : 'disabled' %>>
                    <% if (!routeStops.length) { %><option value="" selected disabled>Select travel time first</option><% } %>
                    <% routeStops.filter((stop) => stop.pickupAllowed !== false).forEach((stop) => { %>
                      <option value="<%= stop.id %>" data-stop-order="<%= stop.stopOrder %>" <%= stop.id === selectedJourney.originStopId ? 'selected' : '' %>>Board at: <%= stop.name %></option>
                    <% }) %>
                  </select>
                  <select class="journeyControl journeyDropoffControl" id="outboundDestinationStopSelect" aria-label="Drop-off stop" data-listing-action="outbound-journey" <%= safeAvailability.scheduleId ? '' : 'disabled' %>>
                    <% if (!routeStops.length) { %><option value="" selected disabled>Select travel time first</option><% } %>
                    <% routeStops.filter((stop) => stop.dropoffAllowed !== false).forEach((stop) => { %>
                      <option value="<%= stop.id %>" data-stop-order="<%= stop.stopOrder %>" <%= stop.id === selectedJourney.destinationStopId ? 'selected' : '' %>>Drop at: <%= stop.name %></option>
                    <% }) %>
                  </select>
                    <div class="full journeyPriceHint"><i class="fa-solid fa-route"></i> Fare updates instantly for the selected boarding and drop-off stops.</div>
                  </div>
                </div>
              <% } else { %>
                <div class="notice">No upcoming trips are scheduled for this route yet.</div>
              <% } %>
            </div>
          <% } %>

          <% if (listing.serviceType === 'hotel') { %>
            <div class="selector hotelDateSelector">
              <div class="selectorTop">
                <div>
                  <b>Choose your stay dates</b>
                  <div class="muted" style="font-size:13px;font-weight:800">Availability and price are checked for every night of your stay.</div>
                </div>
              </div>
              <div class="bookingForm" style="margin-top:10px">
                <label>Check-in<input type="date" id="hotelCheckIn" value="<%= defaultCheckIn %>" min="<%= new Date().toISOString().slice(0, 10) %>" data-listing-action="hotel-dates" required></label>
                <label>Check-out<input type="date" id="hotelCheckOut" value="<%= defaultCheckOut %>" min="<%= defaultCheckOut %>" data-listing-action="hotel-dates" required></label>
                <label>Rooms<input type="number" id="hotelRooms" value="1" min="1" max="10" inputmode="numeric" data-listing-action="hotel-guests" required></label>
                <label>Adults<input type="number" id="hotelAdults" value="1" min="1" max="40" inputmode="numeric" data-listing-action="hotel-guests" required></label>
                <label>Children<input type="number" id="hotelChildren" value="0" min="0" max="40" inputmode="numeric" data-listing-action="hotel-guests"></label>
                <div class="full journeyPriceHint" id="hotelAvailabilityHint"><i class="fa-solid fa-calendar-check"></i> Room availability and the stay total update for the selected dates.</div>
              </div>
            </div>
          <% } %>

          <div class="selector">
            <div class="selectorTop">
              <div>
                <b id="layoutTitle"><%= listing.serviceType === 'hotel' ? 'Choose your stay option' : listing.serviceType === 'bus' ? 'Choose your seats' : listing.serviceType === 'tour' ? 'Tour availability' : listing.serviceType === 'car_rental' ? 'Rental availability' : listing.serviceType === 'cargo' ? 'Cargo service details' : 'Service availability' %></b>
                <div class="muted" style="font-size:13px;font-weight:800" id="layoutHint"><%= listing.serviceType === 'bus' ? 'Select one or many available seats before continuing to payment. Taken items cannot be selected.' : listing.serviceType === 'hotel' ? 'Select an available room or stay option before continuing to payment.' : listing.serviceType === 'tour' ? 'The exact date and participant count are selected securely on the next page.' : listing.serviceType === 'car_rental' ? 'Pickup date, return date, location and driver option are selected securely on the next page.' : listing.serviceType === 'cargo' ? 'Pickup, delivery, package, weight and recipient details are entered securely on the next page.' : 'Review the service before continuing.' %></div>
              </div>
              <% if (listing.serviceType === 'bus') { %>
                <div class="legend">
                  <span class="leg"><i class="dot free"></i> Available</span>
                  <span class="leg"><i class="dot selected"></i> Selected</span>
                  <span class="leg"><i class="dot hold"></i> Held</span>
                  <span class="leg"><i class="dot taken"></i> Taken</span>
                </div>
              <% } else if (listing.serviceType === 'hotel') { %>
                <div class="legend stayOptionLegend" aria-label="Stay option status">
                  <span class="leg"><i class="dot free"></i> Available</span>
                  <span class="leg"><i class="dot selected"></i> Selected</span>
                  <span class="leg"><i class="dot taken"></i> Unavailable</span>
                </div>
              <% } %>
            </div>
            <div class="layoutBox <%= listing.serviceType === 'bus' ? 'busSeatLayoutBox' : listing.serviceType === 'hotel' ? 'stayOptionLayoutBox' : '' %>" id="layoutBox">
              <% if (listing.serviceType === 'bus') { %>
                <div class="vehicleFront">DRIVER - FRONT</div>
                <div class="seatRows" id="outboundSeatGrid"></div>
              <% } else if (listing.serviceType === 'hotel') { %>
                <div class="stayOptionGrid">
                  <% previewRooms.forEach((room, index) => { %>
                    <% const roomAvailable = Number(room.availableUnits !== undefined && room.availableUnits !== null ? room.availableUnits : room.inventory || 0); const roomSelected = room.id === firstRoom || (!firstRoom && index === 0); %>
                    <button class="stayOptionCard <%= roomAvailable <= 0 ? 'is-unavailable' : roomSelected ? 'selected' : '' %>" type="button" data-stay-option data-choice="<%= room.id %>" data-label="<%= room.roomType %>" data-price="<%= room.nightlyPrice || listing.priceFrom %>" data-capacity="<%= room.capacity || 1 %>" data-inventory="<%= roomAvailable %>" data-listing-action="select-option" aria-pressed="<%= roomSelected && roomAvailable > 0 ? 'true' : 'false' %>" <%= roomAvailable <= 0 ? 'disabled' : '' %>>
                      <span class="stayOptionIcon"><i class="fa-solid fa-bed"></i></span>
                      <span class="stayOptionCopy">
                        <strong><%= room.roomType %></strong>
                        <small><i class="fa-solid fa-user-group"></i> Up to <%= room.capacity || 1 %> guest<%= Number(room.capacity || 1) === 1 ? '' : 's' %><%= room.bedType ? ` · ${room.bedType}` : '' %></small>
                        <% if ((room.amenities || []).length) { %><small><i class="fa-solid fa-circle-check"></i> <%= room.amenities.slice(0, 2).join(' · ') %></small><% } %>
                      </span>
                      <span class="stayOptionMeta">
                        <strong><%= money(room.nightlyPrice || listing.priceFrom, currency) %></strong>
                        <small>per night</small>
                        <b data-stay-availability><%= roomAvailable > 0 ? `${roomAvailable} available` : 'Unavailable' %></b>
                      </span>
                      <span class="stayOptionCheck" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    </button>
                  <% }) %>
                </div>
                <% if (!previewRooms.length) { %><div class="notice stayOptionEmpty"><strong>No stay options are available yet.</strong> Choose another property or check back after the host publishes room inventory.</div><% } %>
              <% } else if (['tour', 'car_rental', 'cargo'].includes(listing.serviceType)) { %>
                <div class="roomGrid serviceFactGrid">
                  <% if (listing.serviceType === 'tour') { %>
                    <div class="room selected"><span>Capacity</span><small><%= listing.remainingInventory %> place<%= Number(listing.remainingInventory) === 1 ? '' : 's' %> open</small></div>
                    <div class="room selected"><span>Duration</span><small><%= listing.durationMinutes ? `${listing.durationMinutes} minutes` : 'Set by partner' %></small></div>
                    <div class="room selected"><span>Meeting</span><small><%= listing.serviceDetails?.meetingPoint || listing.address || listing.location || 'Confirmed after booking' %></small></div>
                  <% } else if (listing.serviceType === 'car_rental') { %>
                    <div class="room selected"><span>Vehicles</span><small><%= listing.remainingInventory %> available</small></div>
                    <div class="room selected"><span>Category</span><small><%= listing.vehicleCategory || 'Vehicle' %></small></div>
                    <div class="room selected"><span>Seats</span><small><%= listing.seatsCount || 'Partner specified' %></small></div>
                  <% } else { %>
                    <div class="room selected"><span>Pricing</span><small><%= listing.pricingUnit === 'per_kg' ? 'Per kilogram' : listing.pricingUnit === 'per_package' ? 'Per package' : 'Per shipment' %></small></div>
                    <div class="room selected"><span>Weight</span><small><%= listing.weightLimitKg ? `Up to ${listing.weightLimitKg} kg` : 'Quoted by shipment' %></small></div>
                    <div class="room selected"><span>Packages</span><small><%= listing.packageLimit ? `Up to ${listing.packageLimit}` : 'Partner specified' %></small></div>
                  <% } %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="sidePanel">
          <div class="summaryCard">
            <h3>Booking summary</h3>
            <div class="kv">
              <div><span>Selected</span><b id="selectedOut"><%= selectedPreview %></b></div>
              <div><span>Ticket fare</span><b id="baseOut"><%= money(initialDisplayedFare, currency) %></b></div>
              <div><span>Classic Trip discount</span><b id="discountOut"><%= money(0, currency) %></b></div>
              <div><span>Service fee</span><b id="feeOut"><%= money(serviceFee, currency) %></b></div>
              <div><span>Add-ons</span><b id="addonOut"><%= money(0, currency) %></b></div>
              <div><span>Total</span><b id="totalOut"><%= money(totalEstimate, currency) %></b></div>
            </div>
          </div>

          <div class="summaryCard">
            <h3>Optional extras</h3>
            <div class="addons" id="addons">
              <% addons.forEach(addon => { const basisLabel = (listing.serviceType === 'hotel' ? ({ per_booking: 'per booking', per_passenger: 'per guest', per_trip_leg: 'per room / night', per_passenger_per_leg: 'per guest / night' }) : ({ per_booking: 'per booking', per_passenger: 'per traveler', per_trip_leg: 'per trip leg', per_passenger_per_leg: 'per traveler / leg' }))[addon.chargeBasis] || 'per booking'; %>
                <label class="addon" data-available-for="<%= addon.availableFor || 'all' %>">
                  <input type="checkbox" value="<%= addon.id %>" data-price="<%= addon.price %>" data-charge-basis="<%= addon.chargeBasis || 'per_booking' %>" data-available-for="<%= addon.availableFor || 'all' %>" data-listing-action="addon">
                  <span class="addonIcon"><i class="fa-solid <%= addon.icon || 'fa-circle-plus' %>"></i></span>
                  <span class="addonCopy"><strong><%= addon.name %></strong><small><%= addon.description || 'Optional service supplied by the partner.' %></small></span>
                  <span class="addonPrice"><b><%= money(addon.price, addon.currency || currency) %></b><small><%= basisLabel %></small></span>
                </label>
              <% }) %>
              <% if (!addons.length) { %><div class="notice">This partner has not added optional extras for this service yet.</div><% } %>
            </div>
          </div>

          <% if (listing.serviceType === 'bus') { %>
            <div class="summaryCard multiTicketPanel">
              <div class="multiTicketTop">
                <h3>Return ticket details</h3>
                <span class="badge badgeInfo" id="ticketCountBadge">1 outbound ticket</span>
              </div>
              <p class="returnTripHelp">A return ticket books the outbound and reverse journeys in one checkout. Classic Trip shows every available published reverse departure for the selected journey; it does not require an exact matching time or the same vehicle class. Choose the return departure, select the same number of return seats, and receive a separate ticket/QR for every traveler on each leg.</p>
              <div class="bookingForm" id="returnTripFields" style="display:none">
                <select class="full" id="returnScheduleSelect" aria-label="Return schedule" data-listing-action="return-schedule">
                  <option value="" selected disabled>Select return date and time</option>
                  <% initialReturnSchedules.forEach((schedule) => { %>
                    <option value="<%= schedule.id %>" data-ticket-class="<%= scheduleTicketClass(schedule) %>" data-origin-stop-id="<%= schedule.originStopId %>" data-destination-stop-id="<%= schedule.destinationStopId %>"><%= scheduleTicketClass(schedule) === 'vip' ? 'VIP Ticket' : 'Standard Ticket' %> · <%= schedule.departureLabel %></option>
                  <% }) %>
                  <% if (!initialReturnSchedules.length) { %><option value="" disabled>No reverse trips available</option><% } %>
                </select>
                <div class="notice full" id="returnTripNotice" style="display:<%= initialReturnSchedules.length ? 'none' : 'block' %>">No bookable reverse trips are currently scheduled for this route.</div>
                <div class="full returnSeatGrid" id="returnSeatGrid"></div>
              </div>
            </div>
          <% } %>

          <div class="summaryCard">
            <h3>Partner and rules</h3>
            <div class="kv">
              <div><span>Partner</span><b><%= partnerName %></b></div>
              <div><span>Support</span><b><%= supportPhone %></b></div>
              <div><span>Ticket access</span><b><%= ticketAccess %></b></div>
              <div><span>Policy</span><b><%= policy %></b></div>
            </div>
          </div>

          <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end">
            <a class="btn btnGhost" href="/listings/<%= listing.serviceType %>/<%= listing.slug %>"><i class="fa-solid fa-rotate-left"></i> Reset</a>
            <% if (listing.bookable) { %>
              <button class="btn btnPrimary" type="button" data-listing-action="payment"><i class="fa-solid fa-arrow-right"></i> Proceed to payment</button>
            <% } else { %>
              <a class="btn btnGhost" href="/services"><i class="fa-regular fa-clock"></i> Coming soon</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<script nonce="<%= cspNonce %>">
  let activeSelection = <%- toScriptJson(selectedValue || '') %>;
  let activeSelectionLabel = <%- toScriptJson(selectedPreview || '') %>;
  let activeSelections = activeSelection ? [activeSelection] : [];
  let activeSelectionLabels = activeSelectionLabel ? [activeSelectionLabel] : [];
  let activeReturnSelections = [];
  let activeRoomTypeId = <%- toScriptJson(firstRoom || '') %>;
  let checkoutPreparePending = false;
  const outboundSchedulesData = <%- toScriptJson(previewSchedules.map((schedule) => ({ id: schedule.id, listingId: schedule.listingId, routeId: schedule.routeId, vehicleId: schedule.vehicleId, vehicleClass: scheduleTicketClass(schedule), label: schedule.departureLabel || schedule.id, departAt: schedule.departAt || '', arriveAt: schedule.arriveAt || '', basePrice: Number(schedule.basePrice || 0), currency: schedule.currency || '', stops: schedule.stops || [], journey: schedule.journey || {} }))) %>;
  const routeOptionsData = <%- toScriptJson(busRoutes.map((route) => ({ id: route.routeId || route.id, label: ctRoute(route.origin, route.destination, route.label || route.routeName), origin: route.origin || '', destination: route.destination || '' }))) %>;
  let activeRouteId = <%- toScriptJson(initialRouteId) %>;
  let returnSchedulesData = <%- toScriptJson(initialReturnSchedules.map((schedule) => ({ id: schedule.id, listingId: schedule.listingId, vehicleClass: scheduleTicketClass(schedule), originStopId: schedule.originStopId, destinationStopId: schedule.destinationStopId, label: schedule.departureLabel || schedule.id, departAt: schedule.departAt || '' }))) %>;
  let activeTicketClass = <%- toScriptJson(defaultTicketClass) %>;
