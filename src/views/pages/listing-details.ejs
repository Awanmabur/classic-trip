  function synchronizeJourneySelectors(changedId = '') {
    const originSelect = document.getElementById('outboundOriginStopSelect');
    const destinationSelect = document.getElementById('outboundDestinationStopSelect');
    if (!originSelect || !destinationSelect) return;
    const originOrder = Number(originSelect.selectedOptions?.[0]?.dataset.stopOrder || -1);
    const destinationOrder = Number(destinationSelect.selectedOptions?.[0]?.dataset.stopOrder || Number.MAX_SAFE_INTEGER);
    Array.from(destinationSelect.options).forEach((option) => {
      if (!option.value) return;
      option.disabled = Number(option.dataset.stopOrder || -1) <= originOrder;
      option.hidden = option.disabled;
    });
    if (destinationSelect.selectedOptions?.[0]?.disabled) {
      const next = Array.from(destinationSelect.options).find((option) => option.value && !option.disabled);
      destinationSelect.value = next?.value || '';
    }
    const effectiveDestinationOrder = Number(destinationSelect.selectedOptions?.[0]?.dataset.stopOrder || Number.MAX_SAFE_INTEGER);
    Array.from(originSelect.options).forEach((option) => {
      if (!option.value) return;
      option.disabled = Number(option.dataset.stopOrder || Number.MAX_SAFE_INTEGER) >= effectiveDestinationOrder;
      option.hidden = option.disabled;
    });
    if (originSelect.selectedOptions?.[0]?.disabled) {
      const candidates = Array.from(originSelect.options).filter((option) => option.value && !option.disabled);
      originSelect.value = (changedId === 'outboundDestinationStopSelect' ? candidates[candidates.length - 1] : candidates[0])?.value || '';
    }
  }
  function selectedJourneyIds(changedId = '') {
    synchronizeJourneySelectors(changedId);
    return {
      originStopId: document.getElementById('outboundOriginStopSelect')?.value || previewPricing.originStopId,
      destinationStopId: document.getElementById('outboundDestinationStopSelect')?.value || previewPricing.destinationStopId,
    };
  }
  function renderJourneyOptions(data) {
    const originSelect = document.getElementById('outboundOriginStopSelect');
    const destinationSelect = document.getElementById('outboundDestinationStopSelect');
    if (!originSelect || !destinationSelect) return;
    const stops = data.stops || [];
    const journey = data.journey || {};
    const origins = stops.filter((stop) => stop.pickupAllowed !== false);
    const destinations = stops.filter((stop) => stop.dropoffAllowed !== false);
    originSelect.innerHTML = origins.map((stop) => `<option value="${escapeHtml(stop.id)}" data-stop-order="${Number(stop.stopOrder || 0)}">Board at: ${escapeHtml(stop.name)}</option>`).join('');
    destinationSelect.innerHTML = destinations.map((stop) => `<option value="${escapeHtml(stop.id)}" data-stop-order="${Number(stop.stopOrder || 0)}">Drop at: ${escapeHtml(stop.name)}</option>`).join('');
    originSelect.value = journey.originStopId || origins[0]?.id || '';
    destinationSelect.value = journey.destinationStopId || destinations[destinations.length - 1]?.id || '';
    previewPricing.originStopId = originSelect.value;
    previewPricing.destinationStopId = destinationSelect.value;
    synchronizeJourneySelectors();
  }
  function availabilityKey(scheduleId, originStopId = '', destinationStopId = '', holdId = '') {
    return [scheduleId, originStopId, destinationStopId, holdId].map((value) => String(value || '')).join('|');
  }
  function setJourneyLoading(loading, label = '') {
    // Keep selectors usable while the previous request is aborted/replaced. The
    // preview fare is available from the dated departure immediately, so never
    // replace it with an indefinite full-width spinner.
    ['outboundOriginStopSelect', 'outboundDestinationStopSelect'].forEach((id) => {
      const control = document.getElementById(id);
      if (control) control.disabled = !!loading && control.options.length === 0;
    });
    const hint = document.querySelector('.scheduleSelector .journeyPriceHint');
    if (!hint) return;
    const fare = `<i class="fa-solid fa-route"></i> Current fare per seat: <strong>${escapeHtml(moneyPreview(previewPricing.basePrice))}</strong>`;
    hint.innerHTML = loading
      ? `${fare}. <span class="journeyLiveCheck"><i class="fa-solid fa-spinner fa-spin"></i> ${escapeHtml(label || 'Confirming live seats...')}</span>`
      : `${fare}. This price follows the selected boarding and drop-off stops.`;
  }
  async function fetchScheduleAvailability(scheduleId, originStopId = '', destinationStopId = '', holdId = '') {
    const key = availabilityKey(scheduleId, originStopId, destinationStopId, holdId);
    if (!holdId) {
      const cached = availabilityCache.get(key);
      if (cached && cached.expiresAt > Date.now()) return cached.data;
      if (cached) availabilityCache.delete(key);
    }
    if (activeAvailabilityKey === key && activeAvailabilityPromise) return activeAvailabilityPromise;
    if (activeAvailabilityRequest) activeAvailabilityRequest.abort();
    activeAvailabilityRequest = new AbortController();
    activeAvailabilityKey = key;
    const requestController = activeAvailabilityRequest;
    const timeout = setTimeout(() => {
      requestController.ctTimedOut = true;
      requestController.abort();
    }, 8000);
    const params = new URLSearchParams();
    if (originStopId) params.set('originStopId', originStopId);
    if (destinationStopId) params.set('destinationStopId', destinationStopId);
    if (holdId) params.set('holdId', holdId);
    activeAvailabilityPromise = (async () => {
      try {
        const response = await fetch(`/api/v1/bus/departures/${encodeURIComponent(scheduleId)}/availability?${params.toString()}`, {
          signal: requestController.signal,
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Unable to load seats for that departure.');
        if (!holdId) availabilityCache.set(key, { data: result, expiresAt: Date.now() + 5000 });
        return result;
      } catch (error) {
        if (requestController.ctTimedOut) throw new Error('Live seat confirmation took too long. The shown fare is the departure preview; retry the seat check.');
        throw error;
      } finally {
        clearTimeout(timeout);
        if (activeAvailabilityKey === key) {
          activeAvailabilityKey = '';
          activeAvailabilityPromise = null;
        }
      }
    })();
    return activeAvailabilityPromise;
  }
  async function refreshReturnSchedules() {
    if (!previewPricing.scheduleId || !previewPricing.originStopId || !previewPricing.destinationStopId) return [];
    const cacheKey = availabilityKey(previewPricing.scheduleId, previewPricing.originStopId, previewPricing.destinationStopId);
    const cachedReturn = returnScheduleCache.get(cacheKey);
    let result = cachedReturn && cachedReturn.expiresAt > Date.now() ? cachedReturn.data : null;
    if (cachedReturn && !result) returnScheduleCache.delete(cacheKey);
    if (!result) {
      if (activeReturnRequest) activeReturnRequest.abort();
      activeReturnRequest = new AbortController();
      const params = new URLSearchParams({ originStopId: previewPricing.originStopId, destinationStopId: previewPricing.destinationStopId });
      const response = await fetch(`/api/v1/bus/departures/${encodeURIComponent(previewPricing.scheduleId)}/returns?${params.toString()}`, {
        signal: activeReturnRequest.signal,
        headers: { Accept: 'application/json' },
      });
      result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Unable to load reverse departures.');
      returnScheduleCache.set(cacheKey, { data: result, expiresAt: Date.now() + 30000 });
    }
    const outboundSchedule = outboundSchedulesData.find((item) => String(item.id) === String(previewPricing.scheduleId)) || {};
    const outboundDepartureTime = new Date(outboundSchedule.departAt || 0).getTime();
    returnSchedulesData = (result.departures || []).filter((item) => {
      const returnTime = new Date(item.departAt || 0).getTime();
      // A return departure is an independent reverse service. It does NOT need
      // to match the outbound clock time, estimated arrival time, route-stop
      // ids, or vehicle class. If the company has a live reverse service for
      // this journey, show it. The only chronology rule is that a traveler
      // cannot return before the selected outbound service has started.
      return Number.isFinite(returnTime)
        && returnTime > Date.now()
        && (!Number.isFinite(outboundDepartureTime) || returnTime > outboundDepartureTime);
    });
    const select = document.getElementById('returnScheduleSelect');
    const notice = document.getElementById('returnTripNotice');
    if (select) {
      select.innerHTML = returnSchedulesData.length
        ? `<option value="" selected disabled>Select return date and time</option>${returnSchedulesData.map((item) => { const returnClass = normalizedTicketClass(item.vehicleClass); return `<option value="${escapeHtml(item.id)}" data-ticket-class="${escapeHtml(returnClass)}" data-origin-stop-id="${escapeHtml(item.originStopId)}" data-destination-stop-id="${escapeHtml(item.destinationStopId)}">${escapeHtml(ticketClassLabel(returnClass))} · ${escapeHtml(item.departureLabel || item.label || item.id)}</option>`; }).join('')}`
        : `<option value="" selected disabled>No future reverse trips available</option>`;
    }
    if (notice) {
      notice.textContent = returnSchedulesData.length ? '' : 'No future reverse departure is currently published for this journey.';
      notice.style.display = returnSchedulesData.length ? 'none' : 'block';
    }
    return returnSchedulesData;
  }
  function applySchedulePreview(scheduleId) {
    const schedule = outboundSchedulesData.find((item) => String(item.id) === String(scheduleId));
    if (!schedule) return false;
    if (schedule.routeId) {
      activeRouteId = String(schedule.routeId);
      const routeSelect = document.getElementById('outboundRouteSelect');
      if (routeSelect) routeSelect.value = activeRouteId;
    }
    if (Number(schedule.basePrice || 0) > 0) previewPricing.basePrice = Number(schedule.basePrice || 0);
    if (schedule.currency) previewPricing.currency = schedule.currency;
    if ((schedule.stops || []).length) {
      renderJourneyOptions({ stops: schedule.stops, journey: schedule.journey || {} });
    }
    activeSelections = [];
    activeSelectionLabels = [];
    activeSelection = '';
    activeSelectionLabel = '';
    renderOutboundSeats([]);
    refreshPreviewTotals();
    return true;
  }

  function applyOutboundAvailability(data, { refreshJourneyOptions = true } = {}) {
    previewPricing.basePrice = Number(data.fare?.baseAmountPerSeat || 0);
    previewPricing.partnerBasePrice = Number(data.fare?.partnerBaseAmountPerSeat ?? data.fare?.baseAmountPerSeat ?? 0);
    previewPricing.isMainRoute = Boolean(data.fare?.isMainRoute);
    previewPricing.currency = data.fare?.currency || previewPricing.currency;
    previewPricing.originStopId = data.journey?.originStopId || previewPricing.originStopId;
    previewPricing.destinationStopId = data.journey?.destinationStopId || previewPricing.destinationStopId;
    // Live availability may update seats and pricing, but it must never rewrite
    // the ticket class explicitly selected by the traveller.
    syncTicketChoiceState();
    currentOutboundLayout = data.schedule?.layoutName || currentOutboundLayout;
    if (refreshJourneyOptions) renderJourneyOptions(data);
    renderOutboundSeats(data.seats || [], currentOutboundLayout);
    activeSelections = [];
    activeSelectionLabels = [];
    activeSelection = '';
    activeSelectionLabel = '';
  }
  async function onOutboundScheduleChange() {
    const scheduleId = document.getElementById('outboundScheduleSelect')?.value || '';
    if (!scheduleId) {
      previewPricing.scheduleId = '';
      previewPricing.originStopId = '';
      previewPricing.destinationStopId = '';
      activeSelections = [];
      activeSelectionLabels = [];
      activeSelection = '';
      activeSelectionLabel = '';
      renderOutboundSeats([]);
      ['outboundOriginStopSelect', 'outboundDestinationStopSelect'].forEach((id) => {
        const control = document.getElementById(id);
        if (!control) return;
        control.innerHTML = '<option value="" selected disabled>Select travel time first</option>';
        control.disabled = true;
      });
      returnSchedulesData = [];
      returnPricing.scheduleId = '';
      returnPricing.originStopId = '';
      returnPricing.destinationStopId = '';
      const returnSelect = document.getElementById('returnScheduleSelect');
      if (returnSelect) returnSelect.innerHTML = `<option value="" selected disabled>Select an outbound ${escapeHtml(ticketClassLabel(activeTicketClass))} departure first</option>`;
      const returnNotice = document.getElementById('returnTripNotice');
      if (returnNotice && document.getElementById('returnTripToggle')?.checked) {
        returnNotice.textContent = `Choose an outbound ${ticketClassLabel(activeTicketClass)} departure first.`;
        returnNotice.style.display = 'block';
      }
      renderReturnSeats([]);
      refreshPreviewTotals();
      return;
    }
    const sequence = ++outboundRequestSequence;
    previewPricing.scheduleId = scheduleId;
    applySchedulePreview(scheduleId);
    setJourneyLoading(true, 'Loading live seats and confirming fare...');
    try {
      const data = await fetchScheduleAvailability(scheduleId, previewPricing.originStopId, previewPricing.destinationStopId);
      if (sequence !== outboundRequestSequence) return;
      applyOutboundAvailability(data, { refreshJourneyOptions: true });
      activeReturnSelections = [];
      renderReturnSeats([]);
      refreshPreviewTotals();
      if (document.getElementById('returnTripToggle')?.checked) {
        refreshReturnSchedules()
          .then(() => returnSchedulesData.length ? onReturnScheduleChange() : null)
          .catch((error) => notify(error.message));
      }
    } catch (error) {
      if (error.name !== 'AbortError') notify(error.message);
    } finally {
      if (sequence === outboundRequestSequence) setJourneyLoading(false);
    }
  }
  async function onOutboundJourneyChange(changedId = '') {
    const journey = selectedJourneyIds(changedId);
    if (!previewPricing.scheduleId || !journey.originStopId || !journey.destinationStopId) return;
    previewPricing.originStopId = journey.originStopId;
    previewPricing.destinationStopId = journey.destinationStopId;
    const sequence = ++outboundRequestSequence;
    setJourneyLoading(true, 'Updating fare and seats...');
    try {
      const data = await fetchScheduleAvailability(previewPricing.scheduleId, journey.originStopId, journey.destinationStopId);
      if (sequence !== outboundRequestSequence) return;
      applyOutboundAvailability(data, { refreshJourneyOptions: false });
      activeReturnSelections = [];
      renderReturnSeats([]);
      refreshPreviewTotals();
      if (document.getElementById('returnTripToggle')?.checked) {
        refreshReturnSchedules()
          .then(() => returnSchedulesData.length ? onReturnScheduleChange() : null)
          .catch((error) => notify(error.message));
      }
    } catch (error) {
      if (error.name !== 'AbortError') notify(error.message);
    } finally {
      if (sequence === outboundRequestSequence) setJourneyLoading(false);
    }
  }
  async function onReturnScheduleChange() {
    const select = document.getElementById('returnScheduleSelect');
    const scheduleId = select?.value || '';
    const option = select?.selectedOptions?.[0];
    if (!scheduleId) {
      returnPricing.scheduleId = '';
      activeReturnSelections = [];
      renderReturnSeats([]);
      refreshPreviewTotals();
      return;
    }
    try {
      returnPricing.scheduleId = scheduleId;
      returnPricing.originStopId = option?.dataset.originStopId || returnSchedulesData.find((item) => item.id === scheduleId)?.originStopId || '';
      returnPricing.destinationStopId = option?.dataset.destinationStopId || returnSchedulesData.find((item) => item.id === scheduleId)?.destinationStopId || '';
      const data = await fetchScheduleAvailability(scheduleId, returnPricing.originStopId, returnPricing.destinationStopId);
      returnPricing.basePrice = Number(data.fare?.baseAmountPerSeat || 0);
      returnPricing.partnerBasePrice = Number(data.fare?.partnerBaseAmountPerSeat ?? data.fare?.baseAmountPerSeat ?? 0);
      returnPricing.isMainRoute = Boolean(data.fare?.isMainRoute);
      activeReturnSelections = [];
      currentReturnLayout = data.schedule?.layoutName || currentReturnLayout;
      renderReturnSeats(data.seats || [], currentReturnLayout);
      refreshPreviewTotals();
    } catch (error) { notify(error.message); }
  }
  async function refreshHotelAvailability() {
    if (previewPricing.serviceType !== 'hotel') return;
    const stay = hotelStayRange();
    const params = new URLSearchParams({ checkIn: stay.checkIn, checkOut: stay.checkOut });
    const hint = document.getElementById('hotelAvailabilityHint');
    if (hint) hint.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Checking room availability for these dates...';
    const response = await fetch(`/api/v1/listings/<%= listing.id %>/availability?${params.toString()}`);
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Unable to check room availability.');
    const roomsById = new Map((result.rooms || []).map((room) => [String(room.id || room.roomTypeId), room]));
    document.querySelectorAll('[data-stay-option]').forEach((button) => {
      const room = roomsById.get(String(button.dataset.choice || ''));
      if (!room) return;
      const inventory = Math.max(0, Number(room.availableUnits ?? room.inventory ?? 0));
      button.dataset.price = String(Number(room.nightlyPrice || button.dataset.price || 0));
      button.dataset.capacity = String(Number(room.capacity || button.dataset.capacity || 1));
      button.dataset.inventory = String(inventory);
      button.disabled = inventory <= 0;
      button.classList.toggle('is-unavailable', inventory <= 0);
      const availabilityLabel = button.querySelector('[data-stay-availability]');
      if (availabilityLabel) availabilityLabel.textContent = inventory > 0 ? `${inventory} available` : 'Unavailable';
      if (button.classList.contains('selected') && inventory <= 0) button.classList.remove('selected');
      button.setAttribute('aria-pressed', button.classList.contains('selected') && inventory > 0 ? 'true' : 'false');
    });
    let selected = selectedButton();
    if (!selected || selected.disabled) {
      selected = Array.from(document.querySelectorAll('[data-stay-option]')).find((button) => !button.disabled) || null;
      document.querySelectorAll('[data-stay-option]').forEach((button) => {
        button.classList.toggle('selected', button === selected);
        button.setAttribute('aria-pressed', button === selected ? 'true' : 'false');
      });
    }
    activeSelection = selected?.dataset.choice || '';
    activeSelectionLabel = selected?.dataset.label || activeSelection;
    activeRoomTypeId = activeSelection;
    const availableCount = (result.rooms || []).reduce((sum, room) => sum + Number(room.availableUnits ?? room.inventory ?? 0), 0);
    if (hint) hint.innerHTML = availableCount
      ? `<i class="fa-solid fa-circle-check"></i> ${availableCount} room${availableCount === 1 ? '' : 's'} available for ${stay.nights} night${stay.nights === 1 ? '' : 's'}.`
      : '<i class="fa-solid fa-circle-exclamation"></i> No rooms are available for the selected dates.';
    refreshPreviewTotals();
  }

  async function onHotelDatesChange() {
    if (previewPricing.serviceType !== 'hotel') return;
    try {
      const checkIn = document.getElementById('hotelCheckIn');
      const checkOut = document.getElementById('hotelCheckOut');
      if (checkIn && checkOut) {
        const nextDay = new Date(`${checkIn.value}T00:00:00Z`);
        nextDay.setUTCDate(nextDay.getUTCDate() + 1);
        checkOut.min = nextDay.toISOString().slice(0, 10);
      }
      hotelStayRange();
      await refreshHotelAvailability();
    } catch (error) { notify(error.message); }
  }
  function onHotelGuestsChange() {
    if (previewPricing.serviceType !== 'hotel') return;
    const guests = hotelGuestCount();
    const roomCount = hotelRoomCount();
    const selectedRoom = selectedButton();
    const room = previewRoomsData.find((item) => String(item.id) === String(selectedRoom?.dataset.choice || '')) || {};
    const perRoomCapacity = Number(selectedRoom?.dataset.capacity || room.capacity || 0);
    const availableInventory = Number(selectedRoom?.dataset.inventory ?? room.availableUnits ?? room.inventory ?? 0);
    const totalCapacity = perRoomCapacity * roomCount;
    if (totalCapacity && guests.total > totalCapacity) notify(`The selected ${roomCount} room${roomCount === 1 ? '' : 's'} can accommodate up to ${totalCapacity} guest${totalCapacity === 1 ? '' : 's'}. Choose more rooms, another room type, or reduce guests.`);
    if (availableInventory && roomCount > availableInventory) notify(`Only ${availableInventory} room${availableInventory === 1 ? '' : 's'} of this type are available for the selected dates.`);
    refreshPreviewTotals();
  }

  function selectPreviewOption(button) {
    if (!button || button.disabled) return;
    if (previewPricing.serviceType === 'bus') {
      button.classList.toggle('selected');
      if (!selectedButtons().length) button.classList.add('selected');
      syncActiveSelectionFromButtons();
      // A return booking must always have the same traveler count as the
      // outbound selection. Reset the return seats whenever outbound seats
      // change so stale return inventory cannot be submitted accidentally.
      activeReturnSelections = [];
      document.querySelectorAll('[data-return-seat].selected').forEach((seatButton) => {
        seatButton.classList.remove('selected', 'holding');
      });
    } else {
      document.querySelectorAll('[data-choice]').forEach((item) => {
        item.classList.remove('selected');
        if (item.hasAttribute('aria-pressed')) item.setAttribute('aria-pressed', 'false');
      });
      button.classList.add('selected');
      if (button.hasAttribute('aria-pressed')) button.setAttribute('aria-pressed', 'true');
      activeSelection = button.dataset.choice || '';
      activeSelectionLabel = button.dataset.label || activeSelection;
    }
    if (previewPricing.serviceType === 'hotel') activeRoomTypeId = activeSelection;
    refreshPreviewTotals();
  }
  async function toggleReturnTrip() {
    const fields = document.getElementById('returnTripFields');
    const toggle = document.getElementById('returnTripToggle');
    const enabled = toggle?.checked;
    if (fields) fields.style.display = enabled ? 'grid' : 'none';
    syncTicketChoiceState();
    if (enabled && !previewPricing.scheduleId) {
      const notice = document.getElementById('returnTripNotice');
      if (notice) {
        notice.textContent = `Choose an outbound ${ticketClassLabel(activeTicketClass)} departure first, then the matching return options will appear here.`;
        notice.style.display = 'block';
      }
      notify(`Return Ticket selected. Choose the outbound ${ticketClassLabel(activeTicketClass)} date and time first.`);
      document.getElementById('outboundScheduleSelect')?.focus();
      return;
    }
    syncAddonAvailability();
    if (!enabled) {
      activeReturnSelections = [];
      renderReturnSeats([]);
      refreshPreviewTotals();
      return;
    }
    try {
      if (!returnSchedulesData.length) await refreshReturnSchedules();
      if (!returnSchedulesData.length) {
        syncAddonAvailability();
        renderReturnSeats([]);
        notify('No future reverse departure is currently published for this journey.');
        return;
      }
      await onReturnScheduleChange();
    } catch (error) { notify(error.message); }
  }
  function toggleReturnSeat(button) {
    if (!button || button.disabled) return;
    const willSelect = !button.classList.contains('selected');
    if (willSelect && activeReturnSelections.length >= activeSelections.length) {
      notify(`Select exactly ${activeSelections.length} return seat${activeSelections.length === 1 ? '' : 's'}.`);
      return;
    }
    button.classList.toggle('selected');
    activeReturnSelections = Array.from(document.querySelectorAll('[data-return-seat].selected')).map((item) => item.dataset.returnSeat).filter(Boolean);
    refreshPreviewTotals();
  }
  function setPaymentButtonBusy(busy) {
    const button = document.querySelector('[data-listing-action="payment"]');
    if (!button) return;
    if (!button.dataset.defaultHtml) button.dataset.defaultHtml = button.innerHTML;
    button.disabled = Boolean(busy);
    button.setAttribute('aria-busy', busy ? 'true' : 'false');
    button.innerHTML = busy
      ? '<i class="fa-solid fa-spinner fa-spin"></i> Opening secure checkout…'
      : button.dataset.defaultHtml;
  }

  async function refreshAfterCheckoutConflict(code) {
    if (previewPricing.serviceType !== 'bus' || !previewPricing.scheduleId) return;
    if (!['seat_unavailable', 'inventory_incomplete', 'hold_expired', 'booking_draft_expired'].includes(String(code || ''))) return;
    try {
      const data = await fetchScheduleAvailability(previewPricing.scheduleId, previewPricing.originStopId, previewPricing.destinationStopId);
      applyOutboundAvailability(data, { refreshJourneyOptions: false });
      activeReturnSelections = [];
      renderReturnSeats([]);
      refreshPreviewTotals();
    } catch (_) {}
  }

  async function goPaymentPage() {
    if (checkoutPreparePending) return;
    const ref = <%- toScriptJson(referralCode || '') %>;
    if (previewPricing.serviceType === 'bus') syncActiveSelectionFromButtons();
    const selected = previewPricing.serviceType === 'hotel' ? '' : activeSelection;
    const roomTypeId = previewPricing.serviceType === 'hotel' ? activeRoomTypeId : '';
    if (previewPricing.serviceType === 'hotel') {
      try { hotelStayRange(); } catch (error) { notify(error.message); return; }
      const selectedRoom = selectedButton();
      const roomCount = hotelRoomCount();
      const guests = hotelGuestCount();
      const inventory = Number(selectedRoom?.dataset.inventory || 0);
      const capacity = Number(selectedRoom?.dataset.capacity || 0) * roomCount;
      if (inventory && roomCount > inventory) { notify(`Only ${inventory} room${inventory === 1 ? '' : 's'} of this type are available.`); return; }
      if (capacity && guests.total > capacity) { notify(`The selected rooms can accommodate up to ${capacity} guests.`); return; }
    }
    if (previewPricing.serviceType === 'bus' && !previewPricing.scheduleId) {
      notify('Select your travel date and time first.');
      document.getElementById('outboundScheduleSelect')?.focus();
      return;
    }
    if (!activeSelection) {
      notify('Select an available option first.');
      return;
    }
    const hasReturn = previewPricing.serviceType === 'bus' && document.getElementById('returnTripToggle')?.checked;
    if (hasReturn && !returnPricing.scheduleId) {
      notify('Select the return travel date and time.');
      document.getElementById('returnScheduleSelect')?.focus();
      return;
    }
    if (hasReturn && activeReturnSelections.length !== activeSelections.length) {
      notify(`Select ${activeSelections.length} return seat${activeSelections.length === 1 ? '' : 's'} before continuing.`);
      return;
    }

    if (previewPricing.serviceType === 'bus') {
      const payload = {
        ref,
        scheduleId: previewPricing.scheduleId,
        selectedSeats: activeSelections,
        passengerCount: activeSelections.length,
        originStopId: previewPricing.originStopId,
        destinationStopId: previewPricing.destinationStopId,
        addons: activeAddons().map((addon) => addon.id),
      };
      if (hasReturn) {
        Object.assign(payload, {
          returnScheduleId: returnPricing.scheduleId,
          returnSeats: activeReturnSelections,
          returnOriginStopId: returnPricing.originStopId,
          returnDestinationStopId: returnPricing.destinationStopId,
        });
      }
      checkoutPreparePending = true;
      setPaymentButtonBusy(true);
      try {
        const response = await fetch('/book/bus/<%= listing.slug %>/prepare', {
          method: 'POST',
          headers: jsonHeaders(),
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          const error = new Error(result.error || 'Unable to open secure checkout.');
          error.code = result.code || '';
          error.status = response.status;
          throw error;
        }
        if (!result.redirectUrl) throw new Error('Secure checkout could not be opened. Please try again.');
        window.location.assign(result.redirectUrl);
      } catch (error) {
        await refreshAfterCheckoutConflict(error.code);
        notify(error.message || 'Unable to open secure checkout.');
      } finally {
        checkoutPreparePending = false;
        setPaymentButtonBusy(false);
      }
      return;
    }

    const params = new URLSearchParams();
    if (ref) params.set('ref', ref);
    if (roomTypeId) params.set('roomTypeId', roomTypeId);
    if (previewPricing.serviceType === 'hotel') {
      const stay = hotelStayRange();
      const guests = hotelGuestCount();
      params.set('checkIn', stay.checkIn);
      params.set('checkOut', stay.checkOut);
      params.set('roomCount', String(hotelRoomCount()));
      params.set('adults', String(guests.adults));
      params.set('children', String(guests.children));
    }
    if (selected) params.set('selected', selected);
    activeAddons().forEach((addon) => params.append('addons', addon.id));
    const query = params.toString();
    window.location.href = `/book/<%= listing.serviceType %>/<%= listing.slug %>${query ? '?' + query : ''}`;
  }
  document.addEventListener('click', (event) => {
    const trigger = event.target.closest('[data-listing-action]');
    if (!trigger) return;
    const actions = {
      share: () => sharePreviewListing(event),
      'select-option': () => selectPreviewOption(trigger),
      'return-seat': () => toggleReturnSeat(trigger),
      'ticket-class': () => setTicketClass(trigger.dataset.ticketClass),
      'trip-type': () => setTripType(trigger.dataset.tripType),
      payment: () => goPaymentPage(),
    };
    actions[trigger.dataset.listingAction]?.();
  });
  document.addEventListener('change', (event) => {
    const actions = {
      'outbound-route': () => onOutboundRouteChange(),
      'outbound-schedule': () => onOutboundScheduleChange(),
      'outbound-journey': () => {
        clearTimeout(outboundJourneyDebounce);
        const changedId = event.target.id;
        outboundJourneyDebounce = setTimeout(() => onOutboundJourneyChange(changedId), 180);
      },
      addon: () => togglePreviewAddon(),
      'return-toggle': () => toggleReturnTrip(),
      'return-schedule': () => onReturnScheduleChange(),
      'hotel-dates': () => onHotelDatesChange(),
      'hotel-guests': () => onHotelGuestsChange(),
    };
    actions[event.target.dataset.listingAction]?.();
  });
  Object.assign(window, { sharePreviewListing, togglePreviewAddon, selectPreviewOption, onOutboundRouteChange, onOutboundScheduleChange, onOutboundJourneyChange, onReturnScheduleChange, setTicketClass, setTripType, toggleReturnTrip, toggleReturnSeat, goPaymentPage });
  if (previewPricing.serviceType === 'bus') {
    syncRouteTicketClasses();
    syncTicketChoiceState();
    syncRouteStepAvailability();
    if (previewPricing.scheduleId) {
      renderOutboundSeats(initialPreviewSeats, currentOutboundLayout);
      syncActiveSelectionFromButtons();
    } else {
      renderOutboundSeats([]);
      document.querySelector('.ticketChoice[data-ticket-class]:not(:disabled)')?.focus({ preventScroll: true });
    }
  }
  syncAddonAvailability();
  refreshPreviewTotals();
  if (previewPricing.serviceType === 'hotel') refreshHotelAvailability().catch((error) => notify(error.message));
</script>
<%- include('../partials/site-footer') %>
