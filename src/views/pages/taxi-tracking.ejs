<%- include('../partials/site-head', { seo }) %>
<%- include('../partials/site-header') %>
<%
  const locationLabel = (value, fallback = 'Not set') => {
    if (!value) return fallback;
    if (typeof value === 'string') return value || fallback;
    return value.label || value.name || value.address || value.city || fallback;
  };
  const dateTimeLabel = (value, fallback = 'Immediate dispatch') => {
    if (!value) return fallback;
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString('en-GB', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
  };
  const rideStatus = tracking ? String(tracking.status || 'confirmed').replaceAll('_', ' ') : '';
%>
<main class="container" style="padding:18px 0 34px">
  <section class="card heroCard" style="margin-bottom:16px">
    <span class="badge badgeInfo"><i class="fa-solid fa-location-dot"></i> Secure ride tracking</span>
    <h1 class="heroTitle" style="margin:10px 0 6px;font-size:clamp(24px,4vw,36px)"><%= bookingRef %></h1>
    <p class="heroSub" style="margin:0">Driver, vehicle, live status and pickup PIN are protected by your booking contact or access code.</p>
  </section>

  <% if (!tracking) { %>
    <section class="card" style="max-width:760px;margin:0 auto;padding:22px">
      <h2 style="margin:0 0 6px;font-size:20px">Verify your ride</h2>
      <p class="muted" style="margin:0 0 18px">Enter the email or phone used for the booking, or the tracking access code shown on your confirmation.</p>
      <% if (lookupError) { %><div class="alert alertError" style="margin-bottom:14px"><%= lookupError %></div><% } %>
      <form method="get" action="/rides/<%= encodeURIComponent(bookingRef) %>/tracking" class="formGrid">
        <label class="field"><span>Booking email or phone</span><input name="contact" value="<%= contact %>" autocomplete="email" placeholder="Email or phone"></label>
        <label class="field"><span>Access code</span><input name="accessCode" value="<%= accessCode %>" autocomplete="one-time-code" placeholder="Booking access code"></label>
        <div class="actions" style="grid-column:1/-1;margin-top:4px"><button class="btn btnPrimary" type="submit"><i class="fa-solid fa-shield-halved"></i> Open ride tracking</button><a class="btn btnGhost" href="/tickets"><i class="fa-solid fa-ticket"></i> Find booking</a></div>
      </form>
    </section>
  <% } else { %>
    <section class="detailGrid">
      <div class="card" style="padding:22px;display:grid;gap:16px">
        <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap">
          <div><span class="badge badgeOk"><i class="fa-solid fa-taxi"></i> Ride verified</span><h2 style="margin:10px 0 0;font-size:22px"><%= locationLabel(tracking.pickup) %> &rarr; <%= locationLabel(tracking.destination) %></h2></div>
          <span class="ticketCode"><%= rideStatus %></span>
        </div>
        <div class="kv">
          <div><span>Booking reference</span><b><%= tracking.bookingRef %></b></div>
          <div><span>Ride type</span><b><%= String(tracking.rideType || 'immediate').replaceAll('_', ' ') %></b></div>
          <div><span>Pickup</span><b><%= locationLabel(tracking.pickup) %></b></div>
          <div><span>Destination</span><b><%= locationLabel(tracking.destination) %></b></div>
          <div><span>Pickup time</span><b><%= dateTimeLabel(tracking.scheduledAt) %></b></div>
          <div><span>Vehicle class</span><b><%= tracking.vehicleClass || 'Economy' %></b></div>
          <div><span>Fare</span><b><%= money(tracking.finalFare || tracking.quotedFare || 0, tracking.currency || platformConfig.defaultCurrency) %></b></div>
          <div><span>Status</span><b><%= rideStatus %></b></div>
        </div>
        <% if (tracking.pickupPin) { %>
          <div class="ticketPaper" style="padding:18px">
            <span class="badge badgeWarn"><i class="fa-solid fa-key"></i> Pickup PIN</span>
            <div style="font-size:34px;font-weight:950;letter-spacing:8px;margin-top:10px"><%= tracking.pickupPin %></div>
            <p class="muted" style="margin:8px 0 0">Confirm the vehicle and driver first. Give this PIN only to the assigned driver when you are ready to begin the ride.</p>
          </div>
        <% } else { %>
          <p class="muted" style="margin:0">The pickup PIN becomes available after a driver is assigned and approaches the pickup location.</p>
        <% } %>
      </div>

      <aside class="card" style="padding:22px;display:grid;gap:16px">
        <div><span class="badge badgeInfo"><i class="fa-solid fa-id-card"></i> Assignment</span></div>
        <% if (tracking.driver) { %>
          <div class="kv">
            <div><span>Driver</span><b><%= tracking.driver.name %></b></div>
            <div><span>Driver contact</span><b><%= tracking.driver.phoneMasked || 'Protected' %></b></div>
          </div>
        <% } else { %><p class="muted" style="margin:0">The dispatch engine is finding an eligible verified driver.</p><% } %>
        <% if (tracking.vehicle) { %>
          <div class="kv">
            <div><span>Vehicle</span><b><%= [tracking.vehicle.make, tracking.vehicle.model].filter(Boolean).join(' ') || tracking.vehicle.vehicleClass || 'Assigned vehicle' %></b></div>
            <div><span>Registration</span><b><%= tracking.vehicle.registrationNumber || 'Not provided' %></b></div>
            <div><span>Color</span><b><%= tracking.vehicle.color || 'Not provided' %></b></div>
          </div>
        <% } %>
        <% if (tracking.location && tracking.location.latitude && tracking.location.longitude) { %>
          <div class="ticketPaper" style="padding:16px">
            <b>Latest driver position</b>
            <p class="muted" style="margin:6px 0 0"><%= Number(tracking.location.latitude).toFixed(5) %>, <%= Number(tracking.location.longitude).toFixed(5) %><% if (tracking.location.lastSeenAt) { %> · updated <%= dateTimeLabel(tracking.location.lastSeenAt, 'recently') %><% } %></p>
          </div>
        <% } %>
        <div class="actions"><a class="btn btnGhost" href="/tickets/<%= encodeURIComponent(tracking.bookingRef) %>?accessCode=<%= encodeURIComponent(accessCode) %>"><i class="fa-solid fa-ticket"></i> Ride confirmation</a><a class="btn btnGhost" href="/support"><i class="fa-solid fa-headset"></i> Safety or support</a></div>
      </aside>
    </section>
  <% } %>
</main>
<%- include('../partials/site-footer') %>
