<%- include('../partials/site-head', { seo }) %>
<%- include('../partials/site-header') %>
<main class="container supportPage">
  <section class="card heroCard supportHero">
    <span class="badge badgeInfo"><i class="fa-solid fa-headset" aria-hidden="true"></i> Classic Trip support</span>
    <h1 class="heroTitle">Travel confidently. We are ready to help.</h1>
    <p class="heroSub">Get assistance with bus, hotel, flight-agent or local-mobility bookings, payments, tickets, changes, refunds and partner enquiries. Include a booking reference when available so the team can respond faster.</p>
    <div class="actions heroActionsRow">
      <a class="btn btnPrimary" href="/tickets"><i class="fa-solid fa-ticket" aria-hidden="true"></i> Find my ticket</a>
      <a class="btn btnGhost" href="/how-it-works"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> How Classic Trip works</a>
    </div>
  </section>

  <% if (typeof submitted !== 'undefined' && submitted) { %><div class="travelMessage show success" role="status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Your support request has been received. Keep your booking reference available for follow-up.</div><% } %>

  <section class="supportGrid">
    <article class="supportCard">
      <div class="sectionHead">
        <div>
          <span class="supportEyebrow">Send a secure request</span>
          <h2>Tell us what happened</h2>
          <p class="muted">Do not include passwords, card PINs, mobile-money PINs or full identity-document numbers.</p>
        </div>
      </div>
      <form action="/support" method="post" class="supportForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="formGrid two">
          <div class="field">
            <label for="supportFullName">Your name</label>
            <input id="supportFullName" name="fullName" autocomplete="name" placeholder="Full name" maxlength="120" required>
          </div>
          <div class="field">
            <label for="supportContact">Email or phone</label>
            <input id="supportContact" name="contact" autocomplete="email" placeholder="Email or phone number" maxlength="180" required>
          </div>
        </div>
        <div class="formGrid two">
          <div class="field">
            <label for="supportBookingRef">Booking reference <span class="muted">(optional)</span></label>
            <input id="supportBookingRef" name="bookingRef" placeholder="For example CT-BUS-1042" maxlength="100">
          </div>
          <div class="field">
            <label for="supportCategory">Topic</label>
            <select id="supportCategory" name="category" required>
              <option value="Booking issue">Booking issue</option>
              <option value="Bus journey">Bus journey</option>
              <option value="Hotel stay">Hotel stay</option>
              <option value="Flight booking">Flight booking</option>
              <option value="Local ride or boda">Local ride or boda</option>
              <option value="Refund request">Refund request</option>
              <option value="Ticket not received">Ticket not received</option>
              <option value="Payment issue">Payment issue</option>
              <option value="Safety concern">Safety concern</option>
              <option value="Partner inquiry">Partner inquiry</option>
              <option value="Promoter inquiry">Promoter inquiry</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="supportMessage">Message</label>
          <textarea id="supportMessage" name="message" rows="5" minlength="10" maxlength="3000" placeholder="Describe the issue, what you expected, and the help you need." required></textarea>
        </div>
        <button class="btn btnPrimary" type="submit"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Send support request</button>
      </form>
    </article>

    <aside class="supportAside">
      <article class="supportCard supportContactCard">
        <span class="supportEyebrow">Contact options</span>
        <h3>Support that follows your trip</h3>
        <div class="supportContactList">
          <div class="supportContactItem"><i class="fa-solid fa-envelope" aria-hidden="true"></i><div><strong>Email</strong><br><a href="mailto:support@classictrip.com">support@classictrip.com</a></div></div>
          <div class="supportContactItem"><i class="fa-solid fa-clock" aria-hidden="true"></i><div><strong>Service hours</strong><br>Monday–Saturday, 7:00–21:00 EAT</div></div>
          <div class="supportContactItem"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i><div><strong>Standard response</strong><br>Within 24 hours; safety reports are prioritised.</div></div>
          <div class="supportContactItem"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><div><strong>Urgent ride safety</strong><br>Use the Safety Help action on the protected ride-tracking page.</div></div>
        </div>
      </article>

      <article class="supportCard supportLinkCard">
        <span class="supportEyebrow">Quick self-service</span>
        <div class="supportLinks">
          <a class="btn btnGhost" href="/tickets"><i class="fa-solid fa-ticket" aria-hidden="true"></i> Find ticket or voucher</a>
          <a class="btn btnGhost" href="/account"><i class="fa-regular fa-user" aria-hidden="true"></i> My bookings</a>
          <a class="btn btnGhost" href="/terms#refunds"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Cancellation and refund policy</a>
          <a class="btn btnGhost" href="/how-it-works"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Booking guide</a>
        </div>
      </article>
    </aside>
  </section>
</main>
<%- include('../partials/site-footer') %>
