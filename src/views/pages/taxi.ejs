<%- include('../partials/site-head', { seo }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/css/pages/travel-booking.css?v=20260726-mobility-final-1">
<link rel="stylesheet" href="/css/accessibility-safe.css?v=20260726-reference-ui-1">
<%- include('../partials/site-header') %>
<main class="container travelPage" id="taxiBookingApp">
  <section class="card heroCard mobilityHero">
    <div class="heroTop">
      <div>
        <span class="badge badgeInfo"><i class="fa-solid fa-motorcycle"></i> Safe local mobility</span>
        <h1 class="heroTitle">Request a verified boda or car in a few taps.</h1>
        <p class="heroSub">Book everyday journeys, home-to-office trips, airport transfers, district travel and scheduled intercity rides with an upfront platform price.</p>
      </div>
      <div class="secureNote"><i class="fa-solid fa-shield-halved"></i><span>Drivers and vehicles are verified before dispatch. Your payment, live location and pickup PIN remain protected.</span></div>
    </div>
  </section>

  <div class="travelShell safeRideShell">
    <section class="travelStack">
      <div class="travelPanel safeRidePanel">
        <div class="travelPanelHead">
          <div><h2>Where are you going?</h2><p class="muted">Choose a trusted place, landmark or your current GPS location.</p></div>
          <span class="badge badgeOk"><i class="fa-solid fa-circle-check"></i> Upfront price</span>
        </div>

        <div class="shortcutRow safeRideShortcuts" aria-label="Saved places">
          <button class="travelChip" type="button" data-ride-shortcut="current"><i class="fa-solid fa-location-crosshairs"></i><span>Current</span></button>
          <button class="travelChip" type="button" data-ride-shortcut="home"><i class="fa-solid fa-house"></i><span>Home</span></button>
          <button class="travelChip" type="button" data-ride-shortcut="work"><i class="fa-solid fa-building"></i><span>Work</span></button>
          <button class="travelChip" type="button" data-ride-shortcut="airport"><i class="fa-solid fa-plane"></i><span>Airport</span></button>
        </div>

        <form id="taxiQuoteForm" class="travelForm" autocomplete="off">
          <div class="safeRideRouteFields">
            <div class="travelField full placeField" data-place-field="pickup">
              <label for="pickupSearch">Pickup</label>
              <div class="travelControl safeRideControl"><i class="fa-solid fa-circle-dot"></i><input id="pickupSearch" placeholder="Current location, home or office" required aria-autocomplete="list"><button class="inputIconBtn" type="button" data-current-pickup title="Use current location" aria-label="Use current location"><i class="fa-solid fa-location-crosshairs"></i></button></div>
              <div class="placeSuggestions hidden" id="pickupSuggestions" role="listbox"></div>
            </div>
            <div class="travelField full placeField" data-place-field="destination">
              <label for="destinationSearch">Destination</label>
              <div class="travelControl safeRideControl"><i class="fa-solid fa-location-dot"></i><input id="destinationSearch" placeholder="Airport, office, stay, town or district" required aria-autocomplete="list"></div>
              <div class="placeSuggestions hidden" id="destinationSuggestions" role="listbox"></div>
            </div>
          </div>

          <input type="hidden" id="pickupPlaceId"><input type="hidden" id="pickupLatitude"><input type="hidden" id="pickupLongitude"><input type="hidden" id="pickupCity"><input type="hidden" id="pickupDistrict"><input type="hidden" id="pickupCountry"><input type="hidden" id="pickupCountryCode">
          <input type="hidden" id="destinationPlaceId"><input type="hidden" id="destinationLatitude"><input type="hidden" id="destinationLongitude"><input type="hidden" id="destinationCity"><input type="hidden" id="destinationDistrict"><input type="hidden" id="destinationCountry"><input type="hidden" id="destinationCountryCode">

          <div class="tripTypeRow safeRideTiming" role="group" aria-label="Pickup time">
            <button class="travelChip active" type="button" data-ride-time="now"><i class="fa-solid fa-bolt"></i> Ride now</button>
            <button class="travelChip" type="button" data-ride-time="scheduled"><i class="fa-regular fa-clock"></i> Schedule</button>
          </div>
          <div class="travelField full hidden" id="scheduledRideField"><label for="scheduledPickupAt">Pickup date and time</label><div class="travelControl"><i class="fa-regular fa-calendar-check"></i><input id="scheduledPickupAt" type="datetime-local"></div></div>

          <details class="rideDetails">
            <summary><i class="fa-solid fa-sliders"></i> Passengers, luggage and stops</summary>
            <div class="rideDetailsBody">
              <div class="travelFormGrid two compactGrid">
                <div class="travelField"><label for="passengerCount">Passengers</label><div class="travelControl"><i class="fa-solid fa-user-group"></i><input id="passengerCount" type="number" min="1" max="20" value="1"></div></div>
              </div>
              <div class="rideStopsHead"><div><b>Optional stops</b><span>Add up to four stops in the order you will visit them.</span></div><button class="btn btnGhost btnCompact" type="button" id="addRideStop"><i class="fa-solid fa-plus"></i> Add stop</button></div>
              <div class="rideStopsList" id="rideStopsList"></div>
            </div>
          </details>

          <div class="travelActions safeRideAction"><button class="btn btnPrimary" type="submit"><i class="fa-solid fa-arrow-right"></i> Find a ride</button><span class="locationStatus" id="taxiLocationStatus">Your location is used only when you allow it.</span></div>
          <div class="travelMessage" id="taxiMessage" role="status" aria-live="polite"></div>
        </form>
      </div>

      <div class="travelPanel hidden" id="taxiQuotesPanel">
        <div class="travelPanelHead"><div><h2>Choose your ride</h2><p class="muted" id="taxiQuoteSummary"></p></div><span class="badge badgeInfo" id="taxiQuoteCount">0 rides</span></div>
        <div class="quoteList safeRideQuotes" id="taxiQuotes"></div>
      </div>
    </section>

    <aside class="travelStack">
      <div class="travelPanel sticky safeRideSummary">
        <div class="liveMapFrame">
          <div id="taxiMap" class="liveMap" role="region" aria-label="Pickup and destination map"></div>
          <div class="mapStatus" id="taxiMapStatus"><i class="fa-solid fa-map-location-dot"></i><span>Choose pickup and destination to preview your route.</span></div>
        </div>
        <div class="routeSummaryList">
          <div class="routeSummaryItem"><span class="routeDot pickupDot"></span><div><b id="routePickupLabel">Pickup</b><span id="routePickupMeta">Choose your starting point</span></div></div>
          <div class="routeSummaryItem"><span class="routeDot destinationDot"></span><div><b id="routeDestinationLabel">Destination</b><span id="routeDestinationMeta">Choose where you are going</span></div></div>
        </div>
        <div class="trackingGrid safeRideMetrics"><div class="trackingMetric"><b id="routeDistance">—</b><span>Road distance</span></div><div class="trackingMetric"><b id="routeDuration">—</b><span>Estimated time</span></div></div>
      </div>
      <div class="travelPanel"><h3>Ride safely</h3><div class="timeline safeRideSafety"><div class="timelineItem"><span class="timelineMark"></span><div><b>Match the driver and vehicle</b><span>Check the registration and driver details before boarding.</span></div></div><div class="timelineItem"><span class="timelineMark"></span><div><b>Share the pickup PIN only after arrival</b><span>The PIN confirms that the correct passenger was collected.</span></div></div><div class="timelineItem"><span class="timelineMark"></span><div><b>No roadside fare negotiation</b><span>The accepted fare is locked by the platform before payment.</span></div></div><div class="timelineItem"><span class="timelineMark"></span><div><b>Safety support is audited</b><span>Customers and drivers can report a ride issue from the protected trip page.</span></div></div></div></div>
    </aside>
  </div>
</main>
<script nonce="<%= cspNonce %>" id="taxiPageBootstrap" type="application/json"><%- toScriptJson({ query: initialQuery, map: mapConfig }) %></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" defer></script>
<script src="/js/taxi.js?v=1.6.48" defer></script>
<%- include('../partials/site-footer') %>
