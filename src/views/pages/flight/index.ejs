<%- include('../../partials/site-head', { seo }) %>
<%- include('../../partials/site-header') %>
<main class="container searchHero">
  <section class="card heroCard">
    <div class="heroTop">
      <div>
        <span class="badge badgeInfo"><i class="fa-solid fa-plane-departure"></i> Flights</span>
        <h1 class="heroTitle">Search verified flights across East Africa.</h1>
        <p class="heroSub">Compare fare families, baggage, change rules and live seats. Payment does not become a confirmed flight until the airline order and tickets are issued.</p>
      </div>
      <form class="card searchBox" action="/flights" method="get">
        <div class="formGrid">
          <div class="field"><label>From airport</label><div class="control"><i class="fa-solid fa-plane-departure"></i><input name="origin" list="airportList" value="<%= query.origin || '' %>" placeholder="EBB or Entebbe" required></div></div>
          <div class="field"><label>To airport</label><div class="control"><i class="fa-solid fa-plane-arrival"></i><input name="destination" list="airportList" value="<%= query.destination || '' %>" placeholder="NBO or Nairobi" required></div></div>
          <div class="field"><label>Departure</label><div class="control"><i class="fa-regular fa-calendar"></i><input name="date" type="date" min="<%= today %>" value="<%= query.date || today %>" required></div></div>
          <div class="field"><label>Travelers</label><div class="control"><i class="fa-solid fa-users"></i><input name="passengers" type="number" min="1" max="9" value="<%= query.passengers || 1 %>" required></div></div>
          <div class="field"><label>Cabin</label><div class="control"><i class="fa-solid fa-chair"></i><select name="cabinClass"><option value="">All cabins</option><option value="economy" <%= query.cabinClass === 'economy' ? 'selected' : '' %>>Economy</option><option value="premium_economy" <%= query.cabinClass === 'premium_economy' ? 'selected' : '' %>>Premium economy</option><option value="business" <%= query.cabinClass === 'business' ? 'selected' : '' %>>Business</option><option value="first" <%= query.cabinClass === 'first' ? 'selected' : '' %>>First</option></select></div></div>
          <div class="field"><label>Sort</label><div class="control"><i class="fa-solid fa-arrow-down-wide-short"></i><select name="sort"><option value="soonest" <%= query.sort !== 'cheapest' ? 'selected' : '' %>>Soonest</option><option value="cheapest" <%= query.sort === 'cheapest' ? 'selected' : '' %>>Cheapest</option></select></div></div>
        </div>
        <button class="btn btnPrimary" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search flights</button>
      </form>
      <datalist id="airportList"><% airports.forEach(function(airport){ %><option value="<%= airport.iataCode %>"><%= airport.city %> — <%= airport.name %>, <%= airport.country %></option><% }) %></datalist>
    </div>
    <div class="stats">
      <div class="stat"><b><%= search.total || 0 %></b><span>Matching fares</span></div>
      <div class="stat"><b><%= airports.length %></b><span>Configured airports</span></div>
      <div class="stat"><b>15 min</b><span>Payment seat hold</span></div>
      <div class="stat"><b>Secure</b><span>Ticket issuance</span></div>
    </div>
  </section>
</main>

<main class="container" style="padding:0 0 30px">
  <% if (query.origin && query.destination && query.date) { %>
    <div class="sectionHead"><div><h2><%= search.total || 0 %> flight options</h2><p><%= search.origin ? `${search.origin.city} (${search.origin.iataCode})` : query.origin %> to <%= search.destination ? `${search.destination.city} (${search.destination.iataCode})` : query.destination %></p></div><span class="badge badgeInfo"><i class="fa-solid fa-user-group"></i> <%= search.passengerCount || query.passengers || 1 %> traveler(s)</span></div>
    <div class="gridCards searchResultsGrid">
      <% (search.results || []).forEach(function(result){ %>
        <article class="listing card">
          <div class="listingMedia"><img src="<%= result.listing?.media?.[0]?.url || '/images/logo-symbol-128.png' %>" alt="<%= result.airline %>"><span class="badge badgeInfo listingBadge"><i class="fa-solid fa-plane"></i> <%= result.flightNumber %></span></div>
          <div class="listingBody">
            <div class="listingTop"><div><h3><%= result.airline %></h3><p><%= result.fareName %> · <%= String(result.cabinClass).replaceAll('_',' ') %></p></div><strong><%= money(result.pricing.total, result.pricing.currency) %></strong></div>
            <div class="routeLine"><b><%= result.origin.iataCode %></b><span><%= new Date(result.departureAt).toLocaleString('en-UG') %></span><i class="fa-solid fa-arrow-right-long"></i><b><%= result.destination.iataCode %></b><span><%= new Date(result.arrivalAt).toLocaleString('en-UG') %></span></div>
            <div class="chips">
              <span class="chip"><i class="fa-solid fa-suitcase"></i> <%= result.baggage.checkedKg %>kg checked</span>
              <span class="chip"><i class="fa-solid fa-rotate-left"></i> <%= result.refundable ? 'Refundable' : 'Non-refundable' %></span>
              <span class="chip"><i class="fa-solid fa-chair"></i> <%= result.availableSeats %> seats left</span>
            </div>
            <div class="actions"><a class="btn btnPrimary" href="/flights/<%= encodeURIComponent(result.scheduleId) %>/<%= encodeURIComponent(result.fareId) %>?passengers=<%= result.passengerCount %>" <%= result.bookable ? '' : 'aria-disabled="true"' %>><i class="fa-solid fa-arrow-right"></i> Choose flight</a></div>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (!(search.results || []).length) { %><div class="empty">No published flight inventory matched this route and date. Try another airport or day.</div><% } %>
  <% } else { %>
    <section class="section"><div class="sectionHead"><div><h2>How flight booking works</h2><p>Every step is verified by the backend before the next step opens.</p></div></div><div class="gridCards"><div class="stat"><b>1</b><span>Search dated schedules</span></div><div class="stat"><b>2</b><span>Choose fare and seat</span></div><div class="stat"><b>3</b><span>Enter travel documents</span></div><div class="stat"><b>4</b><span>Pay and receive ticket</span></div></div></section>
  <% } %>
</main>
<%- include('../../partials/site-footer') %>
