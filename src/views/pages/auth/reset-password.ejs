<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/images/favicon-48.png" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <meta name="theme-color" content="#070a12" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="stylesheet" href="/css/pwa.css?v=1.6.86" />
  <title><%= seo?.title || 'Reset password | Classic Trip' %></title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>" />
  <script src="/js/csrf.js?v=20260722-3" defer></script>
  <style>
    :root{font-family:Inter,system-ui,sans-serif;color:#f8fafc;background:#070a12}
    body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px}
    .card{width:min(460px,100%);border:1px solid rgba(255,255,255,.12);border-radius:24px;background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.04));box-shadow:0 24px 80px rgba(0,0,0,.4);padding:22px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:900;margin-bottom:20px}
    .mark{width:42px;height:42px;object-fit:contain;display:block}
    h1{font-size:26px;margin:0 0 6px}
    p{color:#a8b3c7;margin:0 0 18px;font-weight:700}
    form{display:grid;gap:12px}
    label{font-size:12px;color:#cbd5e1;font-weight:900}
    .control{display:flex;align-items:center;gap:10px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);border-radius:999px;padding:0 12px;height:50px}
    .control input{width:100%;border:0;outline:0;background:transparent;color:#fff;font:inherit;font-weight:800}
    button,.btn{height:48px;border:0;border-radius:999px;background:#1d4ed8;color:white;font-weight:950;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;cursor:pointer}
    .btn{background:rgba(255,255,255,.08);margin-top:8px}
  </style>
  <link rel="stylesheet" href="/css/accessibility-safe.css?v=20260726-reference-ui-1">
  <link rel="stylesheet" href="/css/completion-fixes.css?v=1.6.86">
  <script src="/js/page-actions.js" defer></script>
  <script src="/js/pwa.js?v=20260727-3" defer></script>
  <script src="/js/external-styles-idle.js?v=1.6.86" data-styles="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" defer></script>
</head>
<body class="standalonePage">
  <%- include('../../partials/site-flash') %>
  <main class="card">
    <div class="brand"><img class="mark" src="/images/logo-symbol-128.png" alt="Classic Trip"><span>Classic Trip</span></div>
    <h1>Reset password</h1>
    <p>Create a new password for your Classic Trip account.</p>
    <form action="/reset-password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
      <input type="hidden" name="_ct_bot" value="<%= botProof || '' %>"><div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;opacity:0"><label>Leave this field empty<input type="text" name="_ct_hp" value="" tabindex="-1" autocomplete="off"></label></div>
      <input type="hidden" name="token" value="<%= token %>">
      <label for="resetPassword">New password</label>
      <div class="control"><i class="fa-solid fa-lock"></i><input id="resetPassword" name="password" type="password" minlength="8" maxlength="72" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}" required autocomplete="new-password"></div>
      <label for="resetPasswordConfirm">Confirm password</label>
      <div class="control"><i class="fa-solid fa-lock"></i><input id="resetPasswordConfirm" name="confirmPassword" type="password" minlength="8" maxlength="72" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}" required autocomplete="new-password"></div>
      <button type="submit"><i class="fa-solid fa-key"></i> Save new password</button>
    </form>
    <a class="btn" href="/login"><i class="fa-solid fa-arrow-left"></i> Back to login</a>
  </main>
  <%- include('../../partials/contact-hub') %>
  <script src="/js/contact-hub.js?v=1.6.86" defer></script>
</body>
</html>
