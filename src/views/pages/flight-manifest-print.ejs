<%- include('../partials/site-head', { seo }) %>
<% const manifestBase = accessBase || '/company/flights'; const ticketUpdatesAllowed = canUpdateTickets !== false; %>
<main class="container" style="padding:24px 0 40px">
  <section class="card" style="padding:20px">
    <div class="sectionHead">
      <div>
        <span class="badge badgeInfo"><i class="fa-solid fa-plane"></i> Flight manifest</span>
        <h1 style="margin:10px 0 4px"><%= schedule.flightNumber %> · <%= origin?.iataCode || '' %> to <%= destination?.iataCode || '' %></h1>
        <p class="muted"><%= new Date(schedule.departureAt).toLocaleString() %> · <%= rows.length %> ticketed passenger<%= rows.length === 1 ? '' : 's' %></p>
      </div>
      <div class="actions noPrint">
        <a class="btn" href="<%= manifestBase %>/schedules/<%= encodeURIComponent(schedule.id) %>/manifest.csv"><i class="fa-solid fa-file-csv"></i> CSV</a>
        <a class="btn" href="<%= manifestBase %>/schedules/<%= encodeURIComponent(schedule.id) %>/manifest.pdf"><i class="fa-solid fa-file-pdf"></i> PDF</a>
        <button class="btn btnBlue" type="button" id="printFlightManifest"><i class="fa-solid fa-print"></i> Print</button>
      </div>
    </div>
    <div class="tableWrap" style="margin-top:16px">
      <table>
        <thead><tr><th>#</th><th>Traveler</th><th>Ticket</th><th>Booking</th><th>Type</th><th>Document</th><th>Nationality</th><th>Seat</th><th>Cabin</th><th>Status</th><th>Phone</th><th class="noPrint">Operation</th></tr></thead>
        <tbody>
          <% rows.forEach(function(row, index){ %>
            <%
              const ticketActions = [];
              if (row.status === 'issued' && ['published','delayed','boarding'].includes(schedule.status)) ticketActions.push('checked_in');
              if (row.status === 'checked_in' && schedule.status === 'boarding') ticketActions.push('boarded');
              if (['issued','checked_in'].includes(row.status) && ['departed','arrived'].includes(schedule.status)) ticketActions.push('no_show');
              if (row.status === 'boarded' && schedule.status === 'arrived') ticketActions.push('flown');
            %>
            <tr>
              <td><%= index + 1 %></td><td><strong><%= row.travelerName %></strong></td><td><%= row.ticketNumber %></td><td><%= row.bookingRef %></td><td><%= row.passengerType %></td><td><%= row.documentNumber || '-' %></td><td><%= row.nationality || '-' %></td><td><%= row.seatNumber || '-' %></td><td><%= row.cabinClass || '-' %></td><td><span class="badge <%= ['flown','boarded','checked_in'].includes(row.status) ? 'badgeOk' : 'badgeInfo' %>"><%= row.status %></span></td><td><%= row.contactPhone || '-' %></td>
              <td class="noPrint"><% if(ticketUpdatesAllowed && ticketActions.length){ %><form method="post" action="<%= manifestBase %>/tickets/<%= encodeURIComponent(row.ticketNumber) %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="scheduleId" value="<%= schedule.id %>"><input type="hidden" name="next" value="<%= manifestBase %>/schedules/<%= encodeURIComponent(schedule.id) %>/manifest"><select name="status" required><% ticketActions.forEach(function(action){ %><option value="<%= action %>"><%= action.replaceAll('_',' ') %></option><% }) %></select><button class="tinyBtn" type="submit"><i class="fa-solid fa-arrow-right"></i></button></form><% } else { %><span class="muted">—</span><% } %></td>
            </tr>
          <% }) %>
          <% if (!rows.length) { %><tr><td colspan="12" class="empty">No ticketed passengers are available for this flight.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
<script src="/js/flight-manifest.js" defer></script>
<%- include('../partials/site-footer') %>
