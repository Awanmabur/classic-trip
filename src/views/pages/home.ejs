<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/images/favicon-48.png" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Classic Trip" />
  <%
    const homeTitle = seo?.title || 'Classic Trip | Buses, Stays, Airbnb, Flights, Taxi, Tours, Car Rentals and Cargo';
    const homeDescription = seo?.description || 'Plan and book verified buses, stays and Airbnb-style homes, agent-supported flights, local rides, tours, car rentals and cargo services across East Africa from one secure platform.';
    const homeCanonical = `${String(siteUrl || '').replace(/\/+$/, '') || ''}/`;
    const homeSchema = {
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'TravelAgency', name: 'Classic Trip', url: homeCanonical, areaServed: ['Uganda','Kenya','Rwanda','Tanzania','South Sudan','Burundi','Somalia','Democratic Republic of the Congo'] },
        { '@type': 'WebSite', name: 'Classic Trip', url: homeCanonical, potentialAction: { '@type': 'SearchAction', target: `${String(siteUrl || '').replace(/\/+$/, '')}/search?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
        { '@type': 'WebPage', name: homeTitle, description: homeDescription, url: homeCanonical },
      ],
    };
  %>
  <title><%= homeTitle %></title>
  <meta name="description" content="<%= homeDescription %>" />
  <meta name="csrf-token" content="<%= csrfToken || '' %>" />
  <meta name="theme-color" content="#070a12" />
  <script nonce="<%= cspNonce %>">try{const t=localStorage.getItem('classicTripTheme')||localStorage.getItem('ct-theme')||localStorage.getItem('ct_auth_theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch(_){}</script>
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href="<%= homeCanonical %>" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="stylesheet" href="/css/pwa.css?v=1.4.7" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable public summary" />
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="AI-readable public catalog" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= homeTitle %>" />
  <meta property="og:description" content="<%= homeDescription %>" />
  <meta property="og:url" content="<%= homeCanonical %>" />
  <meta name="twitter:card" content="summary" />
  <script nonce="<%= cspNonce %>" type="application/ld+json"><%- toScriptJson(homeSchema) %></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <link rel="stylesheet" href="/css/pages/home.css?v=1.4.6">
  <link rel="stylesheet" href="/css/four-service-ui.css?v=20260726-reference-merge-1">
    <script src="/js/csrf.js?v=20260722-3" defer></script>
  <script src="/js/page-actions.js" defer></script>
  <script src="/js/notifications.js" defer></script>
  <link rel="stylesheet" href="/css/completion-fixes.css?v=1.4.7">
  <link rel="stylesheet" href="/css/accessibility-safe.css?v=20260726-reference-ui-1">
</head>
<body class="homePage" data-user-id="<%= currentUser?.id || '' %>">
  <header class="nav">
    <div class="navIn">
      <a class="brand" href="/"><img class="mark" src="/images/logo-symbol-128.png" alt="Classic Trip"><span>Classic Trip</span></a>
      <nav class="navLinks" id="navLinks">
        <a href="/" class="active">Home</a><a href="/search?serviceType=bus">Buses</a><a href="/stays">Stays</a><a href="/flights">Flights</a><a href="/taxi">Local taxi</a><a href="#ads">Promotions</a><a href="/blogs">Blogs</a><a href="/booking">My bookings</a>
      </nav>
      <div class="navActions">
        <button class="iconbtn" id="themeBtn" title="Toggle theme"><i class="fa-solid fa-moon" id="themeIcon"></i></button>
        <button class="iconbtn" id="menuBtn"><i class="fa-solid fa-bars"></i></button>
        <% if (currentUser) { %><a class="btn btnGhost" href="<%= dashboardUrl %>"><i class="fa-regular fa-user"></i> <%= (currentUser.fullName || currentUser.name || 'Account').split(' ')[0] %></a><% } else { %><a class="btn btnGhost login" href="/login"><i class="fa-regular fa-user"></i> Login</a><% } %>
        <% if (currentUser) { %><form method="POST" action="/logout" style="display:contents"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btnPrimary" type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</button></form><% } else { %><a class="btn btnPrimary" href="/login"><i class="fa-solid fa-right-to-bracket"></i> Start</a><% } %>
      </div>
    </div>
  </header>

  <%- include('../partials/site-flash') %>

  <div class="drawer" id="drawer">
    <div class="drawerPanel">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
        <div class="brand"><img class="mark" src="/images/logo-symbol-128.png" alt="Classic Trip"><span>Classic Trip</span></div>
        <button class="iconbtn" id="closeDrawer"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <% if (currentUser) { %>
        <a class="drawerProfile" href="<%= dashboardUrl %>">
          <span class="drawerProfileAvatar"><i class="fa-solid fa-user"></i></span>
          <span class="drawerProfileText"><b><%= currentUser.fullName || currentUser.name || 'Account' %></b><span class="muted">View dashboard</span></span>
          <i class="fa-solid fa-chevron-right"></i>
        </a>
      <% } else { %>
        <a class="drawerProfile" href="/login">
          <span class="drawerProfileAvatar"><i class="fa-regular fa-user"></i></span>
          <span class="drawerProfileText"><b>Login / Sign up</b><span class="muted">Access your bookings & account</span></span>
          <i class="fa-solid fa-chevron-right"></i>
        </a>
      <% } %>
      <div class="drawerLinks">
        <a href="/">Home</a><a href="/search">Search</a><a href="#ads">Promotions</a><a href="/blogs">Blogs</a><a href="/saved">Saved</a><a href="/booking">My bookings</a><a href="<%= currentUser ? dashboardUrl : '/login' %>"><%= currentUser ? 'Dashboard / profile' : 'Login / sign up' %></a>
      </div>
      <div class="drawerFilters" id="drawerFilters" aria-label="Marketplace categories and route filters"></div>
      <% if (currentUser) { %><button class="btn btnPrimary" type="button" data-home-action="scroll-section" data-section-id="bus" data-close-drawer="true"><i class="fa-solid fa-bolt"></i> Start booking</button><% } else { %><a class="btn btnPrimary" href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign in to start</a><% } %>
    </div>
  </div>

  <nav class="bottomNav" id="siteBottomNav">
    <button type="button" data-home-action="navigate" data-url="/" class="active" title="Home"><i class="fa-solid fa-house"></i><span>Home</span></button>
    <button type="button" data-home-action="navigate" data-url="/search" title="Search"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></button>
    <button type="button" data-home-action="navigate" data-url="/tickets" title="Tickets"><i class="fa-solid fa-ticket"></i><span>Tickets</span></button>
    <button type="button" data-home-action="navigate" data-url="/saved" title="Saved"><i class="fa-regular fa-heart"></i><span>Saved</span></button>
    <button type="button" data-home-action="drawer-toggle" title="Menu"><i class="fa-regular fa-user"></i><span>Profile</span></button>
  </nav>

  <main>
    <section class="container hero" id="home">
      <div class="card heroCard">
        <div class="heroTop">
          <div>
            <div class="chips heroBadgesTop">
              <span class="chip active"><i class="fa-solid fa-shield-halved"></i> Secure checkout</span>
              <span class="chip"><i class="fa-solid fa-clock"></i> <%= platformConfig.holdMinutes %> min hold</span>
              <span class="chip"><i class="fa-solid fa-users"></i> Promoter links</span>
              <span class="chip"><i class="fa-solid fa-building"></i> Partner dashboards</span>
            </div>
            <h1 class="heroTitle"><span class="keepLine">Move, stay and fly</span> with confidence.</h1>
            <p class="heroSub">Compare verified transport, stays, Airbnb-style homes, tours, rentals and cargo options, book with transparent pricing, and manage every reservation from one trusted East African travel platform.</p>
          </div>

          <div class="card searchBox">
            <div class="tabs" id="searchTabs" role="tablist" aria-label="Choose a service to search">
              <button type="button" class="tab active" data-type="bus" data-service-tab="bus" role="tab" aria-controls="busSearchPanel" aria-selected="true"><i class="fa-solid fa-bus"></i> Bus</button>
              <button type="button" class="tab" data-type="hotel" data-service-tab="hotel" role="tab" aria-controls="staySearchPanel" aria-selected="false"><i class="fa-solid fa-house"></i> Stays</button>
              <button type="button" class="tab" data-type="flight" data-service-tab="flight" role="tab" aria-controls="flightSearchPanel" aria-selected="false"><i class="fa-solid fa-plane"></i> Flight</button>
              <button type="button" class="tab" data-type="local_transport" data-service-tab="local_transport" role="tab" aria-controls="taxiSearchPanel" aria-selected="false"><i class="fa-solid fa-taxi"></i> Local taxi</button>
              <button type="button" class="tab" data-type="tour" data-service-tab="tour" role="tab" aria-controls="tourSearchPanel" aria-selected="false"><i class="fa-solid fa-map-location-dot"></i> Tours</button>
              <button type="button" class="tab" data-type="car_rental" data-service-tab="car_rental" role="tab" aria-controls="rentalSearchPanel" aria-selected="false"><i class="fa-solid fa-car-side"></i> Car rental</button>
              <button type="button" class="tab" data-type="cargo" data-service-tab="cargo" role="tab" aria-controls="cargoSearchPanel" aria-selected="false"><i class="fa-solid fa-box"></i> Cargo</button>
            </div>
            <div class="serviceSearchPanels" id="serviceSearchPanels" aria-live="polite">
              <div id="busSearchPanel" class="formGrid serviceSearchPanel active" data-search-panel="bus" role="tabpanel" aria-label="Bus search fields">
                <div class="field"><label for="busFromInput">From</label><div class="control"><i class="fa-solid fa-location-dot"></i><input id="busFromInput" data-search-param="origin" placeholder="Departure city or terminal" autocomplete="off"></div></div>
                <div class="field"><label for="busToInput">To</label><div class="control"><i class="fa-solid fa-location-dot"></i><input id="busToInput" data-search-param="destination" placeholder="Arrival city or terminal" autocomplete="off"></div></div>
                <div class="field"><label for="busDateInput">Departure date</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="busDateInput" data-search-param="date"></div></div>
                <div class="field"><label for="busPassengersInput">Passengers / seats</label><div class="control"><i class="fa-solid fa-user-group"></i><select id="busPassengersInput" data-search-param="passengers"><option value="1">1 passenger</option><option value="2">2 passengers</option><option value="3">3 passengers</option><option value="4">4 passengers</option><option value="5">5 passengers</option><option value="6">6 passengers</option></select></div></div>
              </div>

              <div id="staySearchPanel" class="formGrid serviceSearchPanel" data-search-panel="hotel" role="tabpanel" aria-label="Stay search fields" hidden>
                <div class="field"><label for="stayCityInput">Destination</label><div class="control"><i class="fa-solid fa-location-dot"></i><input id="stayCityInput" data-search-param="city" placeholder="City, area or property" autocomplete="off"></div></div>
                <div class="field"><label for="stayTypeInput">Stay type</label><div class="control"><i class="fa-solid fa-house"></i><select id="stayTypeInput" data-search-param="stayType"><option value="">All stays</option><option value="hotel">Hotel</option><option value="apartment">Apartment</option><option value="entire_home">Entire home</option><option value="private_room">Private room</option><option value="villa">Villa</option></select></div></div>
                <div class="field"><label for="stayCheckInInput">Check-in</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="stayCheckInInput" data-search-param="checkIn"></div></div>
                <div class="field"><label for="stayCheckOutInput">Check-out</label><div class="control"><i class="fa-regular fa-calendar-check"></i><input type="date" id="stayCheckOutInput" data-search-param="checkOut"></div></div>
                <div class="field"><label for="stayGuestsInput">Guests</label><div class="control"><i class="fa-solid fa-user-group"></i><select id="stayGuestsInput" data-search-param="guests"><option value="1">1 guest</option><option value="2">2 guests</option><option value="3">3 guests</option><option value="4">4 guests</option><option value="5">5 guests</option><option value="6">6 guests</option></select></div></div>
                <div class="field"><label for="stayRoomsInput">Rooms</label><div class="control"><i class="fa-solid fa-door-open"></i><select id="stayRoomsInput" data-search-param="rooms"><option value="1">1 room</option><option value="2">2 rooms</option><option value="3">3 rooms</option><option value="4">4 rooms</option></select></div></div>
              </div>

              <div id="flightSearchPanel" class="formGrid serviceSearchPanel" data-search-panel="flight" role="tabpanel" aria-label="Flight search fields" hidden>
                <div class="field"><label for="flightFromInput">From airport</label><div class="control"><i class="fa-solid fa-plane-departure"></i><input id="flightFromInput" data-search-param="origin" placeholder="Airport code or city" autocomplete="off"></div></div>
                <div class="field"><label for="flightToInput">To airport</label><div class="control"><i class="fa-solid fa-plane-arrival"></i><input id="flightToInput" data-search-param="destination" placeholder="Airport code or city" autocomplete="off"></div></div>
                <div class="field"><label for="flightDepartInput">Departure</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="flightDepartInput" data-search-param="departureDate"></div></div>
                <div class="field"><label for="flightReturnInput">Return (optional)</label><div class="control"><i class="fa-regular fa-calendar-check"></i><input type="date" id="flightReturnInput" data-search-param="returnDate"></div></div>
                <div class="field"><label for="flightTravelersInput">Travelers</label><div class="control"><i class="fa-solid fa-user-group"></i><select id="flightTravelersInput" data-search-param="adults"><option value="1">1 traveler</option><option value="2">2 travelers</option><option value="3">3 travelers</option><option value="4">4 travelers</option><option value="5">5 travelers</option><option value="6">6 travelers</option></select></div></div>
                <div class="field"><label for="flightCabinInput">Cabin</label><div class="control"><i class="fa-solid fa-couch"></i><select id="flightCabinInput" data-search-param="cabinClass"><option value="economy">Economy</option><option value="premium_economy">Premium economy</option><option value="business">Business</option><option value="first">First</option></select></div></div>
              </div>

              <div id="taxiSearchPanel" class="formGrid serviceSearchPanel" data-search-panel="local_transport" role="tabpanel" aria-label="Local taxi search fields" hidden>
                <div class="field"><label for="taxiPickupInput">Pickup</label><div class="control"><i class="fa-solid fa-location-crosshairs"></i><input id="taxiPickupInput" data-search-param="origin" placeholder="Pickup address" autocomplete="street-address"></div></div>
                <div class="field"><label for="taxiDestinationInput">Destination</label><div class="control"><i class="fa-solid fa-location-dot"></i><input id="taxiDestinationInput" data-search-param="destination" placeholder="Destination address" autocomplete="off"></div></div>
                <div class="field"><label for="taxiDateInput">Pickup date</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="taxiDateInput" data-search-param="pickupDate"></div></div>
                <div class="field"><label for="taxiTimeInput">Pickup time</label><div class="control"><i class="fa-regular fa-clock"></i><input type="time" id="taxiTimeInput" data-search-param="pickupTime"></div></div>
                <div class="field"><label for="taxiPassengersInput">Passengers</label><div class="control"><i class="fa-solid fa-user-group"></i><select id="taxiPassengersInput" data-search-param="passengers"><option value="1">1 passenger</option><option value="2">2 passengers</option><option value="3">3 passengers</option><option value="4">4 passengers</option><option value="5">5 passengers</option><option value="6">6 passengers</option></select></div></div>
                <div class="field"><label for="taxiRideTypeInput">Ride type</label><div class="control"><i class="fa-solid fa-car-side"></i><select id="taxiRideTypeInput" data-search-param="rideType"><option value="">Any available ride</option><option value="car">Car</option><option value="boda">Boda</option><option value="van">Van</option><option value="airport">Airport transfer</option></select></div></div>
              </div>

              <div id="tourSearchPanel" class="formGrid serviceSearchPanel" data-search-panel="tour" role="tabpanel" aria-label="Tour search fields" hidden>
                <div class="field"><label for="tourCityInput">Destination</label><div class="control"><i class="fa-solid fa-map-location-dot"></i><input id="tourCityInput" data-search-param="city" placeholder="City, park or attraction" autocomplete="off"></div></div>
                <div class="field"><label for="tourCategoryInput">Tour type</label><div class="control"><i class="fa-solid fa-compass"></i><select id="tourCategoryInput" data-search-param="category"><option value="">All tours</option><option value="safari">Safari</option><option value="city">City tour</option><option value="culture">Culture</option><option value="adventure">Adventure</option><option value="nature">Nature</option></select></div></div>
                <div class="field"><label for="tourDateInput">Activity date</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="tourDateInput" data-search-param="date"></div></div>
                <div class="field"><label for="tourParticipantsInput">Participants</label><div class="control"><i class="fa-solid fa-user-group"></i><select id="tourParticipantsInput" data-search-param="participants"><option value="1">1 participant</option><option value="2">2 participants</option><option value="3">3 participants</option><option value="4">4 participants</option><option value="5">5 participants</option><option value="6">6 participants</option></select></div></div>
              </div>

              <div id="rentalSearchPanel" class="formGrid serviceSearchPanel" data-search-panel="car_rental" role="tabpanel" aria-label="Car rental search fields" hidden>
                <div class="field"><label for="rentalPickupInput">Pickup location</label><div class="control"><i class="fa-solid fa-location-dot"></i><input id="rentalPickupInput" data-search-param="origin" placeholder="City, airport or branch" autocomplete="off"></div></div>
                <div class="field"><label for="rentalReturnLocationInput">Return location</label><div class="control"><i class="fa-solid fa-flag-checkered"></i><input id="rentalReturnLocationInput" data-search-param="destination" placeholder="Same or different location" autocomplete="off"></div></div>
                <div class="field"><label for="rentalPickupDateInput">Pickup date</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="rentalPickupDateInput" data-search-param="pickupDate"></div></div>
                <div class="field"><label for="rentalReturnDateInput">Return date</label><div class="control"><i class="fa-regular fa-calendar-check"></i><input type="date" id="rentalReturnDateInput" data-search-param="returnDate"></div></div>
                <div class="field"><label for="rentalVehicleInput">Vehicle type</label><div class="control"><i class="fa-solid fa-car-side"></i><select id="rentalVehicleInput" data-search-param="vehicleType"><option value="">Any vehicle</option><option value="economy">Economy</option><option value="suv">SUV</option><option value="van">Van</option><option value="luxury">Luxury</option><option value="pickup">Pickup</option></select></div></div>
                <div class="field"><label for="rentalDriverInput">Driver</label><div class="control"><i class="fa-solid fa-id-card"></i><select id="rentalDriverInput" data-search-param="driverOption"><option value="self_drive">Self-drive</option><option value="with_driver">With driver</option></select></div></div>
              </div>

              <div id="cargoSearchPanel" class="formGrid serviceSearchPanel" data-search-panel="cargo" role="tabpanel" aria-label="Cargo search fields" hidden>
                <div class="field"><label for="cargoPickupInput">Pickup location</label><div class="control"><i class="fa-solid fa-box"></i><input id="cargoPickupInput" data-search-param="origin" placeholder="Pickup city or address" autocomplete="off"></div></div>
                <div class="field"><label for="cargoDeliveryInput">Delivery location</label><div class="control"><i class="fa-solid fa-truck-fast"></i><input id="cargoDeliveryInput" data-search-param="destination" placeholder="Delivery city or address" autocomplete="off"></div></div>
                <div class="field"><label for="cargoDateInput">Shipping date</label><div class="control"><i class="fa-regular fa-calendar"></i><input type="date" id="cargoDateInput" data-search-param="date"></div></div>
                <div class="field"><label for="cargoTypeInput">Cargo type</label><div class="control"><i class="fa-solid fa-boxes-stacked"></i><select id="cargoTypeInput" data-search-param="cargoType"><option value="parcel">Parcel</option><option value="documents">Documents</option><option value="general_goods">General goods</option><option value="fragile">Fragile goods</option><option value="bulk">Bulk cargo</option></select></div></div>
                <div class="field"><label for="cargoWeightInput">Approx. weight</label><div class="control"><i class="fa-solid fa-weight-hanging"></i><input type="number" id="cargoWeightInput" data-search-param="weightKg" min="0.1" step="0.1" placeholder="Weight in kg"></div></div>
                <div class="field"><label for="cargoPackagesInput">Packages</label><div class="control"><i class="fa-solid fa-cubes"></i><select id="cargoPackagesInput" data-search-param="packages"><option value="1">1 package</option><option value="2">2 packages</option><option value="3">3 packages</option><option value="4">4 packages</option><option value="5">5+ packages</option></select></div></div>
              </div>
            </div>
            <div style="display:flex;gap:10px;justify-content:space-between;flex-wrap:wrap">
              <button type="button" class="btn btnGhost" id="smartSearchBtn" data-service-search-submit="smart"><i class="fa-solid fa-wand-magic-sparkles"></i> Smart bus search</button>
              <button type="button" class="btn btnBlue" id="primarySearchBtn" data-service-search-submit="primary"><i class="fa-solid fa-magnifying-glass"></i> Search buses</button>
            </div>
          </div>
        </div>
        <div class="stats">
          <div class="stat"><b><%= bootstrap.heroStats.totalServices %></b><span>Marketplace services</span></div>
          <div class="stat"><b><%= bootstrap.heroStats.liveRoutes %></b><span>Live routes</span></div>
          <div class="stat"><b><%= bootstrap.heroStats.verifiedPartners %></b><span>Verified partners</span></div>
          <div class="stat"><b><%= bootstrap.heroStats.bookableInventory %></b><span>Bookable now</span></div>
          <div class="stat"><b><%= bootstrap.heroStats.availableNow || 0 %></b><span>Seats / rooms / rides open</span></div>
          <div class="stat"><b><%= bootstrap.heroStats.departuresNext24h || 0 %></b><span>Next 24h departures</span></div>
          <div class="stat"><b><%= platformConfig.holdMinutes %> min</b><span>Inventory hold timer</span></div>
          <div class="stat"><b><%= platformConfig.supportedCurrencies.length %></b><span>Supported currencies</span></div>
        </div>
      </div>
    </section>

    <div class="container layout">
      <aside class="card side">
        <div>
          <div class="sideTitle">Categories</div>
          <div class="muted" style="font-size:13px;font-weight:800">Filter marketplace listings</div>
        </div>
        <div class="sideNav" id="categoryFilters">
          <button class="btn btnGhost active" data-home-action="filter-cards" data-filter="all"><i class="fa-solid fa-border-all"></i> All</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="bus"><i class="fa-solid fa-bus"></i> Bus</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="hotel"><i class="fa-solid fa-house"></i> Stays</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="flight"><i class="fa-solid fa-plane"></i> Flight</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="local_transport"><i class="fa-solid fa-taxi"></i> Local taxi</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="tour"><i class="fa-solid fa-map-location-dot"></i> Tours</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="car_rental"><i class="fa-solid fa-car-side"></i> Car rentals</button>
          <button class="btn btnGhost" data-home-action="filter-cards" data-filter="cargo"><i class="fa-solid fa-boxes-stacked"></i> Cargo</button>
          <a class="btn btnGhost" href="/airbnb"><i class="fa-solid fa-house-chimney"></i> Airbnb homes</a>
        </div>
        <div>
          <div class="sideTitle">Country routes</div>
          <div class="muted" style="font-size:12px;font-weight:760;margin:2px 0 8px">Filter by corridor, for example Kenya ⇄ Uganda.</div>
          <div class="routeFilters" id="routeFilters">
            <button class="btn btnGhost active" data-home-action="filter-route" data-filter="all"><i class="fa-solid fa-earth-africa"></i> All East Africa</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ug-ke">Uganda ⇄ Kenya</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ug-tz">Uganda ⇄ Tanzania</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ug-rw">Uganda ⇄ Rwanda</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ug-bi">Uganda ⇄ Burundi</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ug-ss">Uganda ⇄ South Sudan</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ke-tz">Kenya ⇄ Tanzania</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ke-rw">Kenya ⇄ Rwanda</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ke-ug">Kenya ⇄ Uganda</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="tz-rw">Tanzania ⇄ Rwanda</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="tz-bi">Tanzania ⇄ Burundi</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="rw-bi">Rwanda ⇄ Burundi</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="rw-drc">Rwanda ⇄ DR Congo</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ss-et">South Sudan ⇄ Ethiopia</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="et-so">Ethiopia ⇄ Somalia</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="et-dj">Ethiopia ⇄ Djibouti</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="et-er">Ethiopia ⇄ Eritrea</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="regional">Regional / international</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ug-local">Uganda local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ke-local">Kenya local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="tz-local">Tanzania local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="rw-local">Rwanda local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="bi-local">Burundi local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="ss-local">South Sudan local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="et-local">Ethiopia local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="so-local">Somalia local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="dj-local">Djibouti local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="er-local">Eritrea local</button>
            <button class="btn btnGhost" data-home-action="filter-route" data-filter="drc-local">DR Congo local</button>
          </div>
        </div>
        <div class="summaryCard">
          <h3>Tenant model</h3>
          <p class="muted" style="margin:0;font-size:12px;font-weight:760">Each partner controls listings, layouts, prices, policies, staff and payouts.</p>
        </div>
      </aside>

      <div>
        <section class="section" id="bus">
          <div class="sectionHead"><div><h2>Featured buses</h2><p>Dynamic seat layout: 2+2, 2+1, VIP, sleeper, or custom partner structure.</p></div><span class="badge badgeInfo"><i class="fa-solid fa-chair"></i> Seat selection</span></div>
          <% var initialBusListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'bus' || item.group === 'bus'); }).slice(0, 6); %>
          <div class="gridCards" id="cards">
            <% if (initialBusListings.length) { initialBusListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="bus"><strong>No published bus services yet</strong><p class="muted">Published departures will appear here automatically.</p></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-bus" data-home-action="show-more" data-group="bus"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>

        <section class="section" id="hotel">
          <div class="sectionHead"><div><h2>Stays, homes, apartments & rooms</h2><p>Book verified hotels or Airbnb-style entire homes, villas, cottages, apartments, homestays, private rooms and shared rooms with dated availability.</p></div><span class="badge badgeOk"><i class="fa-solid fa-door-open"></i> Room selection</span></div>
          <% var initialHotelListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'hotel' || item.group === 'hotel'); }).slice(0, 6); %>
          <div class="gridCards" id="hotelCards">
            <% if (initialHotelListings.length) { initialHotelListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="hotel"><strong>No published stays yet</strong><p class="muted">Verified hotels, apartments, homes and rooms with dated inventory will appear here automatically.</p></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-hotel" data-home-action="show-more" data-group="hotel"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>


        <section class="section" id="flight">
          <div class="sectionHead"><div><h2>Flights across East Africa</h2><p>Search dated departures, compare fare families and baggage, choose seats and receive e-tickets.</p></div><a class="btn btnGhost" href="/flights"><i class="fa-solid fa-plane-departure"></i> Search flights</a></div>
          <% var initialFlightListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'flight' || item.group === 'flight'); }).slice(0, 6); %>
          <div class="gridCards" id="flightCards">
            <% if (initialFlightListings.length) { initialFlightListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="flight"><strong>No published flights yet</strong><p class="muted">Airline departures with live inventory and published fares will appear here automatically.</p><a class="btn btnGhost" href="/flights">Open flight search</a></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-flight" data-home-action="show-more" data-group="flight"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>

        <section class="section" id="local-transport">
          <div class="sectionHead"><div><h2>Local taxi, airport & intercity rides</h2><p>Ride now or schedule home, work, stay, airport, district, national and corporate trips.</p></div><a class="btn btnGhost" href="/taxi"><i class="fa-solid fa-location-crosshairs"></i> Book a ride</a></div>
          <% var initialTaxiListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'local_transport' || item.group === 'local_transport'); }).slice(0, 6); %>
          <div class="gridCards" id="taxiCards">
            <% if (initialTaxiListings.length) { initialTaxiListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="local_transport"><strong>No published local ride providers yet</strong><p class="muted">Verified mobility partners with approved vehicles and drivers will appear here automatically. Pricing and dispatch remain controlled by the platform.</p><a class="btn btnGhost" href="/taxi">Request a local ride</a></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-local-transport" data-home-action="show-more" data-group="local_transport"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>

        <section class="section" id="tour">
          <div class="sectionHead"><div><h2>Tours, activities & destination experiences</h2><p>Book verified guides, attractions, excursions and local experiences with published dates and live participant capacity.</p></div><a class="btn btnGhost" href="/tours"><i class="fa-solid fa-map-location-dot"></i> Explore tours</a></div>
          <% var initialTourListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'tour' || item.group === 'tour'); }).slice(0, 6); %>
          <div class="gridCards" id="tourCards">
            <% if (initialTourListings.length) { initialTourListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="tour"><strong>No published tours yet</strong><p class="muted">Verified tour operators can publish activities, dates, prices and participant capacity from their partner dashboard.</p><a class="btn btnGhost" href="/register?role=partner#partner">Become a tour partner</a></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-tour" data-home-action="show-more" data-group="tour"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>

        <section class="section" id="car-rental">
          <div class="sectionHead"><div><h2>Car rentals for every journey</h2><p>Reserve verified self-drive or chauffeured vehicles with clear per-day pricing, pickup and return details, and live fleet availability.</p></div><a class="btn btnGhost" href="/car-rentals"><i class="fa-solid fa-car-side"></i> Find a rental</a></div>
          <% var initialRentalListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'car_rental' || item.group === 'car_rental'); }).slice(0, 6); %>
          <div class="gridCards" id="rentalCards">
            <% if (initialRentalListings.length) { initialRentalListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="car_rental"><strong>No published rental vehicles yet</strong><p class="muted">Verified rental partners can publish vehicles, daily prices, pickup locations and availability from their dashboard.</p><a class="btn btnGhost" href="/register?role=partner#partner">Become a rental partner</a></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-car-rental" data-home-action="show-more" data-group="car_rental"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>

        <section class="section" id="cargo">
          <div class="sectionHead"><div><h2>Cargo, parcels & freight</h2><p>Book verified pickup and delivery services for documents, parcels and freight with shipment weight, package, recipient and handling details.</p></div><a class="btn btnGhost" href="/cargo"><i class="fa-solid fa-box"></i> Send cargo</a></div>
          <% var initialCargoListings = (bootstrap.listings || []).filter(function(item) { return item && (item.serviceType === 'cargo' || item.group === 'cargo'); }).slice(0, 6); %>
          <div class="gridCards" id="cargoCards">
            <% if (initialCargoListings.length) { initialCargoListings.forEach(function(item) { %><%- include('../partials/listing-card', { listing: item }) %><% }); } else { %>
              <div class="card marketplaceEmptyCard" data-home-empty="cargo"><strong>No published cargo services yet</strong><p class="muted">Verified logistics partners can publish service areas, weight limits, pricing and pickup instructions from their dashboard.</p><a class="btn btnGhost" href="/register?role=partner#partner">Become a cargo partner</a></div>
            <% } %>
          </div>
          <div class="moreRow"><button class="btn btnGhost moreBtn" id="more-cargo" data-home-action="show-more" data-group="cargo"><i class="fa-solid fa-plus"></i> More</button></div>
        </section>

      <% if (comingSoonServiceTypes && comingSoonServiceTypes.length) { %>
      <section class="section" id="coming-soon">
        <div class="sectionHead"><div><h2>More marketplace services are coming</h2><p>They remain part of Classic Trip while each workflow is built with its own inventory, pricing, verification and operations.</p></div><a class="btn btnGhost" href="/services#coming-soon">View roadmap</a></div>
        <div class="gridCards">
          <% comingSoonServiceTypes.forEach(function(key){ var service = serviceCatalog[key]; %>
            <article class="listing card" style="padding:14px"><span class="badge badgeInfo"><i class="fa-solid <%= service.icon %>"></i> Coming soon</span><h3 style="margin:10px 0 5px"><%= service.label %></h3><p class="muted" style="margin:0"><%= service.description %></p></article>
          <% }) %>
        </div>
      </section>
      <% } %>
      <section class="section" id="ads">
          <div class="sectionHead">
            <div>
              <h2>Ads & promoted listings</h2>
              <p>Partners can promote any published bus, stay, Airbnb-style home, flight, local taxi, tour, car-rental or cargo listing so it appears higher in search and selected homepage placements.</p>
            </div>
            <span class="badge badgeWarn"><i class="fa-solid fa-bullhorn"></i> Partner growth</span>
          </div>
          <div class="pageIntro">
            <div>
              <h3>Promotion center</h3>
              <p>Approved campaigns linked to published services appear here from the database.</p>
            </div>
            <% if (currentUser?.role === 'company_admin') { %><a class="btn btnPrimary" href="/company/promotions"><i class="fa-solid fa-plus"></i> Promote listing</a><% } else { %><a class="btn btnGhost" href="/register?role=partner#partner"><i class="fa-solid fa-building"></i> Become a partner</a><% } %>
          </div>
          <div class="gridCards" id="adsCards">
<% var sponsored = (bootstrap.listings || []).filter(function(l) { return l.isSponsored; }).slice(0, 4); %>
<% if (sponsored.length) { sponsored.forEach(function(l) { var svcIcon = l.serviceType === 'hotel' ? 'fa-hotel' : l.serviceType === 'flight' ? 'fa-plane' : l.serviceType === 'local_transport' ? 'fa-taxi' : l.serviceType === 'tour' ? 'fa-map-location-dot' : l.serviceType === 'car_rental' ? 'fa-car-side' : l.serviceType === 'cargo' ? 'fa-box' : 'fa-bus'; %>
            <article class="promoCard">
              <div class="promoIcon"><i class="fa-solid <%= svcIcon %>"></i></div>
              <span class="badge badgeWarn" style="width:max-content;margin-bottom:8px"><i class="fa-solid fa-star"></i> Promoted</span>
              <h3><%= l.title %></h3>
              <p><%= l.partner || l.companyName || '' %><% if (l.routeLabel || l.origin) { %> &bull; <%= l.routeLabel || l.origin %><% } %></p>
              <a class="btn btnGhost" href="<%= l.url %>"><i class="fa-regular fa-eye"></i> View listing</a>
            </article>
<% }); } else { %>
            <div class="card" data-home-empty="promotions" style="padding:20px"><strong>No active promotions yet</strong><p class="muted" style="margin:6px 0 0">Approved campaigns linked to published listings will appear here.</p></div>
<% } %>
          </div>
        </section>

        <section class="section" id="blogs">
          <div class="sectionHead">
            <div>
              <h2>Travel blogs & guides</h2>
              <p>Helpful content for routes, border travel, stays and homes, airport tips, partner promotions and customer education.</p>
            </div>
            <span class="badge badgeInfo"><i class="fa-regular fa-newspaper"></i> Travel stories</span>
          </div>
          <div class="pageIntro">
            <div>
              <h3>Content that helps customers book with confidence</h3>
              <p>Published articles appear here from the content database.</p>
            </div>
            <% if (currentUser?.role === 'super_admin') { %><a class="btn btnGhost" href="/admin/blogs"><i class="fa-solid fa-pen-nib"></i> Write blog</a><% } %>
          </div>
          <div class="gridCards" id="blogCards">
<% if (bootstrap.blogs && bootstrap.blogs.length) { bootstrap.blogs.forEach(function(post) { var badgeCls = (post.tag||'').toLowerCase().includes('hotel') ? 'badgeOk' : (post.tag||'').toLowerCase().includes('promo') ? 'badgeWarn' : (post.tag||'').toLowerCase().includes('book') ? 'badgeHot' : 'badgeInfo'; %>
            <article class="promoCard blogCard">
              <div class="blogImage">
                <% if (post.image) { %><img src="<%= post.image %>" alt="<%= post.imageAlt || post.title %>"><% } else { %><div style="height:160px;background:var(--soft)"></div><% } %>
                <span class="badge <%= badgeCls %> blogTag"><%= post.tag || 'Guide' %></span>
                <div class="blogIconActions">
                  <a class="miniIcon" href="<%= post.url %>" title="Read"><i class="fa-regular fa-eye"></i></a>
                  <button class="miniIcon" title="Share" data-t="<%= post.title %>" data-u="<%= post.url %>" data-home-action="share-dataset"><i class="fa-solid fa-share-nodes"></i></button>
                </div>
              </div>
              <div class="blogBody">
                <h3><%= post.title %></h3>
                <div class="blogMeta"><% if (post.publishedAt) { %><span><i class="fa-regular fa-calendar"></i> <%= new Date(post.publishedAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %></span><% } %></div>
                <p><%= post.excerpt %></p>
                <div class="blogActions"><a class="btn btnGhost" href="<%= post.url %>"><i class="fa-regular fa-eye"></i> Read more</a></div>
              </div>
            </article>
<% }); } else { %>
            <div class="card" data-home-empty="blogs" style="padding:20px"><strong>No published articles yet</strong><p class="muted" style="margin:6px 0 0">Articles created and published by the Super Admin will appear here.</p></div>
<% } %>
          </div>
        </section>

      </div>
    </div>
  </main>

  <footer class="siteFooter">
    <div class="footerGrid">
      <div class="footerBrand">
        <div class="brand"><img class="mark" src="/images/logo-symbol-128.png" alt="Classic Trip"><span>Classic Trip</span></div>
        <p>Classic Trip brings verified buses, stays and Airbnb-style homes, flights, local rides, tours, car rentals and cargo into one secure East Africa marketplace.</p>
        <span><i class="fa-solid fa-shield-halved"></i> Secure checkout</span>
        <span><i class="fa-solid fa-clock"></i> <%= platformConfig.holdMinutes %> minute inventory holds</span>
        <span><i class="fa-solid fa-headset"></i> Customer support</span>
      </div>

      <div class="footerCol">
        <h3>Book & manage</h3>
        <a href="/search?serviceType=bus"><i class="fa-solid fa-bus"></i> Buses</a>
        <a href="/stays"><i class="fa-solid fa-house"></i> Stays</a>
        <a href="/flights"><i class="fa-solid fa-plane"></i> Flights</a>
        <a href="/taxi"><i class="fa-solid fa-motorcycle"></i> Boda & car rides</a>
        <a href="/tours"><i class="fa-solid fa-map-location-dot"></i> Tours & activities</a>
        <a href="/car-rentals"><i class="fa-solid fa-car-side"></i> Car rentals</a>
        <a href="/cargo"><i class="fa-solid fa-boxes-stacked"></i> Cargo & parcels</a>
        <a href="/tickets"><i class="fa-solid fa-ticket"></i> Find my ticket</a>
        <a href="/booking"><i class="fa-solid fa-bookmark"></i> My bookings</a>
        <a href="/saved"><i class="fa-regular fa-heart"></i> Saved trips</a>
        <% if (currentUser) { %><a href="<%= dashboardUrl %>"><i class="fa-regular fa-user"></i> My account</a><% } else { %><a href="/login"><i class="fa-regular fa-user"></i> Login / Sign up</a><% } %>
      </div>

      <div class="footerCol">
        <h3>Partners & promoters</h3>
        <a href="/register?role=partner#partner"><i class="fa-solid fa-store"></i> Become a partner</a>
        <a href="/promoters"><i class="fa-solid fa-users"></i> Promoter program</a>
        <a href="/companies"><i class="fa-solid fa-building"></i> Browse partners</a>
        <a href="/company/dashboard"><i class="fa-solid fa-chart-line"></i> Partner dashboard</a>
        <a href="/partner-commission"><i class="fa-solid fa-percent"></i> Commission model</a>
      </div>

      <div class="footerCol">
        <h3>Legal & help</h3>
        <a href="/how-it-works"><i class="fa-solid fa-circle-info"></i> About Classic Trip</a>
        <a href="/terms"><i class="fa-solid fa-file-contract"></i> Terms & conditions</a>
        <a href="/privacy"><i class="fa-solid fa-user-shield"></i> Privacy policy</a>
        <a href="/terms#refunds"><i class="fa-solid fa-rotate-left"></i> Refund policy</a>
        <a href="/terms#cancellation"><i class="fa-solid fa-triangle-exclamation"></i> Cancellation rules</a>
        <a href="/support"><i class="fa-solid fa-envelope"></i> Contact support</a>
      </div>
    </div>
    <div class="footerBottom">
      <span>&copy; <%= new Date().getFullYear() %> Classic Trip. Marketplace for East Africa bookings.</span>
      <span>Secure payments • Transparent pricing • Partner payouts • Ticket access</span>
    </div>
  </footer>


  <div class="toast" id="toast">Ready</div>

  <script id="classicTripBootstrap" type="application/json" nonce="<%= cspNonce %>"><%- toScriptJson({ ...(bootstrap || {}), platformConfig: platformConfig || {} }) %></script>
  <script src="/js/mobile-navigation.js?v=20260727-1" defer></script>
  <script src="/js/pwa.js?v=20260727-final-speed-1" defer></script>
  <script src="/js/home-service-search.js?v=1.4.7" defer></script>
  <script src="/js/home.js?v=1.4.7" defer></script>
</body>
</html>

