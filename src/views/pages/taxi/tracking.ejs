<%- include('../../partials/site-head', { seo }) %>
<%- include('../../partials/site-header') %>
<main class="container" style="padding:16px 0 30px">
  <section class="sheet">
    <div class="sheetTop"><div><span class="badge badgeInfo"><i class="fa-solid fa-location-dot"></i> Private ride tracking</span><div class="sheetTitle"><%= tracking.rideRef %></div><div class="sheetSub"><%= tracking.stops?.[0]?.address || '' %> → <%= tracking.stops?.[tracking.stops.length - 1]?.address || '' %></div></div><span class="badge <%= tracking.status === 'completed' ? 'badgeOk' : 'badgeInfo' %>"><%= String(tracking.status).replaceAll('_',' ') %></span></div>
    <div class="directPaymentGrid">
      <div class="summaryCard"><h3>Ride status</h3><div class="row"><span>Pickup time</span><b><%= new Date(tracking.requestedPickupAt).toLocaleString('en-UG') %></b></div><div class="row"><span>Driver</span><b><%= tracking.driver?.fullName || 'Searching for an eligible driver' %></b></div><div class="row"><span>Vehicle</span><b><%= tracking.vehicle ? `${tracking.vehicle.color || ''} ${tracking.vehicle.make} ${tracking.vehicle.modelName} · ${tracking.vehicle.registrationNumber}` : 'Not assigned yet' %></b></div><% if (pickupPin) { %><div class="notice"><strong>Pickup PIN:</strong> <%= pickupPin %>. Give this PIN only after you meet the correct driver and vehicle.</div><% } %><% if (tracking.driverLocation?.coordinates) { %><div class="row"><span>Latest location</span><b><%= tracking.driverLocation.coordinates.latitude %>, <%= tracking.driverLocation.coordinates.longitude %></b></div><div class="row"><span>Updated</span><b><%= tracking.driverLocation.recordedAt ? new Date(tracking.driverLocation.recordedAt).toLocaleString('en-UG') : '-' %></b></div><% } %><div class="actions" style="margin-top:12px"><a class="btn btnGhost" href="/taxi/rides/<%= encodeURIComponent(tracking.rideRef) %>?token=<%= encodeURIComponent(trackingToken) %>"><i class="fa-solid fa-rotate"></i> Refresh status</a><a class="btn btnPrimary" href="/tickets/<%= encodeURIComponent(tracking.bookingRef) %>"><i class="fa-solid fa-receipt"></i> Booking details</a></div></div>
      <div class="summaryCard"><h3>Ride timeline</h3><% (tracking.events || []).forEach(function(event){ %><div class="row"><span><%= new Date(event.occurredAt).toLocaleString('en-UG') %></span><b><%= String(event.eventType).replaceAll('_',' ') %><% if (event.note) { %><br><small><%= event.note %></small><% } %></b></div><% }) %><% if (!(tracking.events || []).length) { %><div class="empty">The ride timeline will appear here.</div><% } %></div>
    </div>
  </section>
</main>
<%- include('../../partials/site-footer') %>
