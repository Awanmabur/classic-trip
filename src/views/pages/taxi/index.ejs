<%- include('../../partials/site-head', { seo }) %>
<%- include('../../partials/site-header') %>
<%
  const taxiForm = form || {};
  const knownLocations = [];
  (airports || []).forEach(function(row){
    if (Number.isFinite(Number(row.latitude)) && Number.isFinite(Number(row.longitude))) knownLocations.push({
      key: `airport:${row.id}`, label: `${row.iataCode} · ${row.name}, ${row.city}`, address: `${row.name}, ${row.city}, ${row.country}`,
      latitude: Number(row.latitude), longitude: Number(row.longitude), kind: 'Airport'
    });
  });
  (zones || []).forEach(function(row){
    if (Number.isFinite(Number(row.center?.latitude)) && Number.isFinite(Number(row.center?.longitude))) knownLocations.push({
      key: `zone:${row.id}`, label: `${row.name} · ${row.cityOrDistrict}`, address: `${row.name}, ${row.cityOrDistrict}, ${row.country}`,
      latitude: Number(row.center.latitude), longitude: Number(row.center.longitude), kind: 'Service area'
    });
  });
%>
<main class="container searchHero">
  <section class="card heroCard">
    <div class="heroTop">
      <div>
        <span class="badge badgeInfo"><i class="fa-solid fa-taxi"></i> Local taxi</span>
        <h1 class="heroTitle">Book home-to-airport, office, district and intercity rides.</h1>
        <p class="heroSub">Choose an immediate or scheduled ride. Classic Trip verifies the operator, service zone, fare rule, vehicle capacity, insurance, driver safety status and payment before dispatch.</p>
      </div>
      <form class="card searchBox" action="/taxi/quote" method="post" id="taxiQuoteForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <div class="formGrid">
          <div class="field"><label>Taxi provider</label><div class="control"><i class="fa-solid fa-building"></i><select name="listingId" required><option value="">Choose service</option><% (listings || []).forEach(function(listing){ %><option value="<%= listing.id %>" <%= taxiForm.listingId === listing.id ? 'selected' : '' %>><%= listing.title %> · <%= listing.city || listing.country || '' %></option><% }) %></select></div></div>
          <div class="field"><label>Ride type</label><div class="control"><i class="fa-solid fa-route"></i><select name="serviceType" id="taxiServiceType" required><% [['immediate','Immediate ride'],['scheduled','Scheduled ride'],['airport_transfer','Airport transfer'],['intercity','Intercity / district'],['hourly','Hourly hire']].forEach(function(item){ %><option value="<%= item[0] %>" <%= (taxiForm.serviceType || 'immediate') === item[0] ? 'selected' : '' %>><%= item[1] %></option><% }) %></select></div></div>
          <div class="field"><label>Vehicle class</label><div class="control"><i class="fa-solid fa-car-side"></i><select name="vehicleClass" required><% [['boda','Boda'],['economy','Economy'],['comfort','Comfort'],['premium','Premium'],['suv','SUV'],['van','Van'],['minibus','Minibus']].forEach(function(item){ %><option value="<%= item[0] %>" <%= (taxiForm.vehicleClass || 'economy') === item[0] ? 'selected' : '' %>><%= item[1] %></option><% }) %></select></div></div>
          <div class="field"><label>Pickup time</label><div class="control"><i class="fa-regular fa-clock"></i><input name="requestedPickupAt" id="taxiPickupAt" type="datetime-local" min="<%= minSchedule %>" value="<%= taxiForm.requestedPickupAt || '' %>"></div></div>

          <div class="field"><label>Passengers</label><div class="control"><i class="fa-solid fa-users"></i><input name="passengerCount" type="number" min="1" max="30" value="<%= taxiForm.passengerCount || 1 %>" required></div></div>
          <div class="field"><label>Luggage pieces</label><div class="control"><i class="fa-solid fa-suitcase-rolling"></i><input name="luggageCount" type="number" min="0" max="50" value="<%= taxiForm.luggageCount || 0 %>" required></div></div>
          <div class="field"><label>Child seats</label><div class="control"><i class="fa-solid fa-baby-carriage"></i><input name="childSeatCount" type="number" min="0" max="10" value="<%= taxiForm.childSeatCount || 0 %>"></div></div>
          <div class="field"><label>Accessibility</label><div class="control"><i class="fa-solid fa-wheelchair"></i><select name="wheelchairRequired"><option value="false" <%= String(taxiForm.wheelchairRequired || 'false') !== 'true' ? 'selected' : '' %>>Standard vehicle</option><option value="true" <%= String(taxiForm.wheelchairRequired || '') === 'true' ? 'selected' : '' %>>Wheelchair-accessible vehicle</option></select></div></div>

          <div class="field"><label>Pickup known location</label><div class="control"><i class="fa-solid fa-map-pin"></i><select id="pickupPreset"><option value="">Use current location or enter manually</option><% knownLocations.forEach(function(location){ %><option value="<%= location.key %>" data-address="<%= location.address %>" data-latitude="<%= location.latitude %>" data-longitude="<%= location.longitude %>"><%= location.kind %> · <%= location.label %></option><% }) %></select></div></div>
          <div class="field"><label>Destination known location</label><div class="control"><i class="fa-solid fa-map-location-dot"></i><select id="destinationPreset"><option value="">Choose an airport/area or enter manually</option><% knownLocations.forEach(function(location){ %><option value="<%= location.key %>" data-address="<%= location.address %>" data-latitude="<%= location.latitude %>" data-longitude="<%= location.longitude %>"><%= location.kind %> · <%= location.label %></option><% }) %></select></div></div>
          <div class="field"><label>Pickup address</label><div class="control"><i class="fa-solid fa-location-dot"></i><input name="pickupAddress" id="pickupAddress" value="<%= taxiForm.pickupAddress || '' %>" placeholder="Home, hotel, office or airport" required></div></div>
          <div class="field"><label>Destination</label><div class="control"><i class="fa-solid fa-location-arrow"></i><input name="destinationAddress" id="destinationAddress" value="<%= taxiForm.destinationAddress || '' %>" placeholder="Airport, office, district or town" required></div></div>
        </div>

        <div class="actions">
          <button class="btn btnGhost" id="useCurrentPickup" type="button"><i class="fa-solid fa-location-crosshairs"></i> Use current pickup</button>
          <button class="btn btnGhost" id="useCurrentDestination" type="button"><i class="fa-solid fa-location-crosshairs"></i> Use current destination</button>
        </div>

        <details class="notice" style="margin-top:12px" <%= taxiForm.pickupLatitude || taxiForm.destinationLatitude ? 'open' : '' %>>
          <summary><strong>Map coordinates</strong> — filled automatically by current location or a saved airport/service area</summary>
          <p style="margin:8px 0">For an address outside the saved locations, enter coordinates from your map application. The backend uses them for service-zone enforcement and server-side distance pricing.</p>
          <div class="formGrid">
            <div class="field"><label>Pickup latitude</label><div class="control"><i class="fa-solid fa-map-pin"></i><input name="pickupLatitude" id="pickupLatitude" type="number" min="-90" max="90" step="any" value="<%= taxiForm.pickupLatitude || '' %>" required></div></div>
            <div class="field"><label>Pickup longitude</label><div class="control"><i class="fa-solid fa-map-pin"></i><input name="pickupLongitude" id="pickupLongitude" type="number" min="-180" max="180" step="any" value="<%= taxiForm.pickupLongitude || '' %>" required></div></div>
            <div class="field"><label>Destination latitude</label><div class="control"><i class="fa-solid fa-map-location-dot"></i><input name="destinationLatitude" id="destinationLatitude" type="number" min="-90" max="90" step="any" value="<%= taxiForm.destinationLatitude || '' %>" required></div></div>
            <div class="field"><label>Destination longitude</label><div class="control"><i class="fa-solid fa-map-location-dot"></i><input name="destinationLongitude" id="destinationLongitude" type="number" min="-180" max="180" step="any" value="<%= taxiForm.destinationLongitude || '' %>" required></div></div>
          </div>
        </details>
        <div class="field" style="margin-top:12px"><label>Accessibility or vehicle notes</label><div class="control"><i class="fa-solid fa-clipboard-list"></i><input name="accessibilityNotes" maxlength="500" value="<%= taxiForm.accessibilityNotes || '' %>" placeholder="Wheelchair dimensions, child-seat age, oversized luggage, gate or office access"></div></div>
        <div class="actions" style="justify-content:flex-end"><button class="btn btnPrimary" type="submit"><i class="fa-solid fa-calculator"></i> Get verified fare quote</button></div>
      </form>
    </div>
    <div class="stats"><div class="stat"><b>Immediate</b><span>Paid rides enter dispatch</span></div><div class="stat"><b>Scheduled</b><span>Airport and office pickup</span></div><div class="stat"><b>Safe</b><span>Verified driver and pickup PIN</span></div><div class="stat"><b>Live</b><span>Private driver tracking</span></div></div>
  </section>
</main>

<main class="container" style="padding:0 0 30px">
  <% if (quote) { %>
    <section class="sheet directPaymentSheet">
      <div class="sheetTop"><div><span class="badge badgeOk"><i class="fa-solid fa-circle-check"></i> Signed fare quote</span><div class="sheetTitle"><%= quote.provider.name %> · <%= String(quote.vehicleClass).replaceAll('_',' ') %></div><div class="sheetSub"><%= quote.stops[0].address %> → <%= quote.stops[quote.stops.length - 1].address %></div></div><span class="badge badgeInfo"><%= quote.distanceKm %> km · about <%= quote.durationMinutes %> min</span></div>
      <div class="directPaymentGrid">
        <div class="summaryCard"><h3>Fare and vehicle requirements</h3><div class="row"><span>Passengers</span><b><%= quote.requirements?.passengerCount || 1 %></b></div><div class="row"><span>Luggage</span><b><%= quote.requirements?.luggageCount || 0 %> pieces</b></div><div class="row"><span>Accessibility</span><b><%= quote.requirements?.wheelchairRequired ? 'Wheelchair vehicle' : 'Standard' %></b></div><div class="row"><span>Base fare</span><b><%= money(quote.breakdown.base, quote.pricing.currency) %></b></div><div class="row"><span>Distance</span><b><%= money(quote.breakdown.distanceCharge, quote.pricing.currency) %></b></div><div class="row"><span>Estimated time</span><b><%= money(quote.breakdown.timeCharge, quote.pricing.currency) %></b></div><div class="row"><span>Booking / surcharges</span><b><%= money(quote.pricing.fees, quote.pricing.currency) %></b></div><div class="row total"><span>Total estimate</span><b><%= money(quote.pricing.total, quote.pricing.currency) %></b></div><div class="notice">This quote is signed and expires in ten minutes. Passenger capacity, luggage capacity, accessibility, zone and price are recalculated before payment.</div></div>
        <form class="summaryCard" action="/bookings/taxi" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="quoteToken" value="<%= quote.quoteToken %>"><h3>Rider and payment contact</h3><div class="bookingForm"><input name="contactName" placeholder="Rider full name" required><input name="phone" placeholder="Phone / WhatsApp" required><input class="full" type="email" name="email" placeholder="Email for receipt and ride access" required><textarea class="full" name="pickupInstructions" placeholder="Pickup instructions, landmark, office, hotel gate or terminal"></textarea></div><button class="btn btnPrimary" type="submit" style="width:100%;margin-top:14px"><i class="fa-solid fa-lock"></i> Confirm and pay</button><div class="notice" style="margin-top:10px">Only a trusted payment callback activates dispatch. Classic Trip then provides a private tracking token and pickup PIN.</div></form>
      </div>
    </section>
  <% } else if (!(listings || []).length) { %><div class="empty">No verified taxi operator has published a complete zone, fare, compliant vehicle and driver workflow yet.</div><% } %>
</main>
<script nonce="<%= cspNonce %>">
(function(){
  const rideType=document.getElementById('taxiServiceType');
  const pickupAt=document.getElementById('taxiPickupAt');
  function syncPickup(){if(!rideType||!pickupAt)return;pickupAt.required=rideType.value!=='immediate';pickupAt.closest('.field')?.classList.toggle('muted',rideType.value==='immediate');}
  rideType?.addEventListener('change',syncPickup);syncPickup();

  function applyPreset(selectId,addressId,latId,lngId){
    const select=document.getElementById(selectId);
    select?.addEventListener('change',()=>{const option=select.selectedOptions?.[0];if(!option?.dataset.latitude)return;document.getElementById(addressId).value=option.dataset.address||option.textContent.trim();document.getElementById(latId).value=option.dataset.latitude;document.getElementById(lngId).value=option.dataset.longitude;});
  }
  applyPreset('pickupPreset','pickupAddress','pickupLatitude','pickupLongitude');
  applyPreset('destinationPreset','destinationAddress','destinationLatitude','destinationLongitude');

  function useCurrent(prefix){
    if(!navigator.geolocation){alert('Location is not available in this browser.');return;}
    navigator.geolocation.getCurrentPosition((position)=>{document.getElementById(prefix+'Latitude').value=position.coords.latitude;document.getElementById(prefix+'Longitude').value=position.coords.longitude;},()=>alert('Location permission was not granted.'),{enableHighAccuracy:true,timeout:10000,maximumAge:30000});
  }
  document.getElementById('useCurrentPickup')?.addEventListener('click',()=>useCurrent('pickup'));
  document.getElementById('useCurrentDestination')?.addEventListener('click',()=>useCurrent('destination'));
})();
</script>
<%- include('../../partials/site-footer') %>
