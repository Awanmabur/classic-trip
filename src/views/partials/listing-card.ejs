<%
  const listingType = String(listing.serviceType || listing.type || listing.group || 'service').toLowerCase();
  const isBusListing = listingType === 'bus';
  const isHotelListing = listingType === 'hotel';
  const isFlightListing = listingType === 'flight';
  const isTaxiListing = listingType === 'local_transport';
  const isTourListing = listingType === 'tour';
  const isRentalListing = listingType === 'car_rental';
  const isCargoListing = listingType === 'cargo';
  const listingIdentifier = listing.slug || listing.id || listing.publicId || '';
  const listingHref = listing.url || `/listings/${listingType}/${listingIdentifier}`;
  const bookingHref = isFlightListing ? `/flights?listingId=${encodeURIComponent(listing.id || listingIdentifier)}` : isTaxiListing ? `/taxi?listingId=${encodeURIComponent(listing.id || listingIdentifier)}` : (listing.bookingUrl || listingHref);
  const listingImage = listing.img || listing.image || listing.media?.[0]?.url || '';
  const listingPartner = listing.partner || listing.companyName || 'Service partner';
  const listingRoute = listing.routeLabel || [listing.from, listing.to].filter(Boolean).join(' → ');
  const stayTypeLabels = {hotel:'Hotel',lodge:'Lodge',resort:'Resort',guest_house:'Guest house',serviced_apartment:'Serviced apartment',apartment:'Apartment',entire_home:'Entire home',private_room:'Private room',shared_room:'Shared room',villa:'Villa',cottage:'Cottage',cabin:'Cabin',bungalow:'Bungalow',homestay:'Homestay',holiday_home:'Holiday home',farm_stay:'Farm stay',bed_and_breakfast:'Bed & breakfast',hostel:'Hostel',camp:'Camp'};
  const stayTypeLabel = isHotelListing ? (stayTypeLabels[String(listing.stayType || listing.type || '').toLowerCase()] || 'Stay') : '';
  const listingPlace = (isBusListing || isFlightListing || isCargoListing) ? (listingRoute || listing.location || (isCargoListing ? 'Pickup and delivery area' : 'Route information')) : (listing.location || listing.city || listingRoute || (isTaxiListing ? 'Service zone' : isTourListing ? 'Tour location' : isRentalListing ? 'Pickup location' : 'Property location'));
  const listingDescription = listing.sub || listing.shortDescription || listing.description || (isBusListing ? 'Public bus service with live departure and seat availability.' : isHotelListing ? 'Verified stay, Airbnb-style home or room with dated availability and secure booking.' : isFlightListing ? 'Published flight offer with baggage, seat options and verified agent support.' : isTaxiListing ? 'Verified boda and car rides with upfront platform pricing and automatic dispatch.' : isTourListing ? 'Guided experience with live participant capacity and secure booking.' : isRentalListing ? 'Verified rental vehicle with dated availability, self-drive or driver options.' : isCargoListing ? 'Secure pickup and delivery service for parcels, documents and freight.' : 'Verified travel service.');
  const listingAmount = Number(listing.priceFrom ?? listing.price ?? 0);
  const listingRating = Number(listing.ratingAverage || listing.rating || 0);
  const listingRatingLabel = listingRating > 0 ? listingRating.toFixed(1) : 'New';
  const listingIcon = isBusListing ? 'fa-bus' : isHotelListing ? 'fa-hotel' : isFlightListing ? 'fa-plane' : isTaxiListing ? 'fa-taxi' : isTourListing ? 'fa-map-location-dot' : isRentalListing ? 'fa-car-side' : isCargoListing ? 'fa-boxes-stacked' : 'fa-ticket';
  const listingTypeLabel = listing.typeLabel || (isBusListing ? 'Bus' : isHotelListing ? stayTypeLabel : isFlightListing ? 'Flight' : isTaxiListing ? 'Local ride' : isTourListing ? 'Tour' : isRentalListing ? 'Car rental' : isCargoListing ? 'Cargo' : 'Service');
  const remaining = Number(listing.remainingInventory ?? listing.availability);
  const numericAvailabilityApplies = !isTaxiListing && !isCargoListing;
  const availabilityText = listing.isSponsored ? 'Sponsored' : listing.bookable ? (numericAvailabilityApplies && Number.isFinite(remaining) ? `${remaining} available` : 'Available') : remaining <= 0 && numericAvailabilityApplies ? 'No inventory' : 'View service';
  const availabilityClass = listing.isSponsored ? 'promo' : listing.bookable ? 'available' : remaining <= 0 && numericAvailabilityApplies ? 'full' : 'promo';
  const availabilityIcon = listing.isSponsored ? 'fa-bullhorn' : listing.bookable ? 'fa-circle-check' : remaining <= 0 && numericAvailabilityApplies ? 'fa-circle-xmark' : 'fa-clock';
  const priceUnit = isBusListing ? 'Fare by stops' : isHotelListing ? `Starting price · per available night${stayTypeLabel ? ` · ${stayTypeLabel}` : ''}` : isFlightListing ? 'Starting airfare · live dated departure' : isTaxiListing ? 'Estimated fare · request an exact quote' : isTourListing ? 'Starting price · per participant' : isRentalListing ? 'Starting price · per rental day' : isCargoListing ? (listing.pricingUnit === 'per_kg' ? 'Starting price · per kilogram' : listing.pricingUnit === 'per_package' ? 'Starting price · per package' : 'Starting price · per shipment') : 'Starting price';
%>
<article class="listing marketplaceListingCard <%= isBusListing ? 'referenceBusCard' : '' %>" data-id="<%= listing.id || listingIdentifier %>" data-group="<%= listing.group || listingType %>" data-service-type="<%= listingType %>" data-stay-type="<%= listing.stayType || '' %>" data-corridor="<%= listing.corridor || 'regional' %>">
  <a class="listingThumbLink" href="<%= listingHref %>" aria-label="View <%= listing.title || 'service' %>">
    <div class="thumb">
      <% if (listingImage) { %><img src="<%= listingImage %>" alt="<%= listing.title || 'Service image' %>" loading="lazy" decoding="async"><% } else { %><div class="listingImageEmpty"><i class="fa-solid fa-image"></i></div><% } %>
      <div class="thumbBadges"><span class="badge badgeOk"><i class="fa-solid fa-star"></i> <%= listingRatingLabel %></span><span class="badge badgeInfo"><i class="fa-solid <%= listingIcon %>"></i> <%= listingTypeLabel %></span></div>
    </div>
  </a>
  <div class="cornerBadge <%= availabilityClass %>"><i class="fa-solid <%= availabilityIcon %>"></i> <%= availabilityText %></div>
  <div class="listingBody">
    <h3 class="listingTitle"><a href="<%= listingHref %>"><%= listing.title || 'Untitled service' %></a></h3>
    <div class="meta">
      <span><i class="fa-solid <%= (isBusListing || isFlightListing || isCargoListing) ? 'fa-route' : 'fa-location-dot' %>"></i> <%= listingPlace %></span>
      <span><i class="fa-solid fa-building"></i> <%= listingPartner %></span>
    </div>
    <p class="desc"><%= listingDescription %></p>
    <div class="priceRow">
      <div><div class="price"><%= listingAmount > 0 ? money(listingAmount, listing.currency) : 'Price pending' %></div><div class="small"><%= listing.bookable ? priceUnit : 'Open service details' %></div></div>
      <div class="actions"><a class="btn btnGhost" href="<%= listingHref %>"><i class="fa-regular fa-eye"></i> View</a><% if (listing.bookable) { %><a class="btn btnPrimary" href="<%= bookingHref %>"><i class="fa-solid fa-ticket"></i> Book</a><% } %></div>
    </div>
  </div>
</article>
