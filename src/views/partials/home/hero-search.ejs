<% const dbOptions = searchOptions || {}; const selectedServiceType = String(query?.serviceType || '').toLowerCase(); const isBusSearch = selectedServiceType === 'bus'; const generalOptions = isBusSearch ? (dbOptions.bus || dbOptions.all || {}) : (dbOptions.all || {}); %>
<form class="card searchBox" action="/search" method="get" data-search-form data-marketplace-db-search-form>
  <div class="formGrid">
    <div class="field"><label for="marketplaceOrigin">From / city</label><div class="control"><i class="fa-solid fa-location-dot"></i><select id="marketplaceOrigin" name="origin" data-marketplace-origin><option value="">Any origin</option><% (generalOptions.origins || []).forEach((value) => { %><option value="<%= value %>" <%= query?.origin === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div></div>
    <div class="field"><label for="marketplaceDestination">To / destination</label><div class="control"><i class="fa-solid fa-route"></i><select id="marketplaceDestination" name="destination" data-marketplace-destination><option value="">Any destination</option><% (generalOptions.destinations || []).forEach((value) => { %><option value="<%= value %>" <%= query?.destination === value ? 'selected' : '' %>><%= value %></option><% }) %></select></div></div>
    <div class="field"><label for="marketplaceService">Service</label><div class="control"><i class="fa-solid fa-ticket"></i><select id="marketplaceService" name="serviceType" class="selectLike" data-marketplace-service><option value="">All</option><% (categories || []).forEach(c => { %><option value="<%= c.key %>" <%= query?.serviceType === c.key ? 'selected' : '' %>><%= c.label %></option><% }) %></select></div></div>
    <div class="field"><label for="marketplaceDate">Date</label><div class="control"><i class="fa-regular fa-calendar"></i><input id="marketplaceDate" name="date" type="date" value="<%= query?.date || '' %>"></div></div>
    <div class="field"><label for="marketplaceAvailability">Availability</label><div class="control"><i class="fa-solid fa-circle-check"></i><select id="marketplaceAvailability" name="available" class="selectLike"><option value="">Any</option><option value="true" <%= query?.available === 'true' ? 'selected' : '' %>>Open inventory</option></select></div></div>
    <div class="field"><label for="marketplaceSort">Sort</label><div class="control"><i class="fa-solid fa-arrow-down-wide-short"></i><select id="marketplaceSort" name="sort" class="selectLike"><option value="recommended" <%= query?.sort === 'recommended' || !query?.sort ? 'selected' : '' %>>Recommended</option><option value="soonest" <%= query?.sort === 'soonest' ? 'selected' : '' %>>Soonest</option><option value="cheapest" <%= query?.sort === 'cheapest' ? 'selected' : '' %>>Cheapest</option><option value="availability" <%= query?.sort === 'availability' ? 'selected' : '' %>>Most open</option></select></div></div>
  </div>
  <script type="application/json" nonce="<%= cspNonce %>" data-marketplace-db-search-json><%- toScriptJson({ all: dbOptions.all || {}, bus: dbOptions.bus || {} }) %></script>
  <button class="btn btnPrimary" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
</form>
