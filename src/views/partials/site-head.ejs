<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/images/favicon-48.png" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Classic Trip" />
  <meta name="google-site-verification" content="5AkPJ6UuBW2UZKN7GCwKm8wFoPtwD9Dq307vomL9MTI" />
  <%
    const pageSeo = (typeof seo !== 'undefined' && seo) ? seo : {};
    const cfg = (typeof seoConfig !== 'undefined' && seoConfig) ? seoConfig : {};
    const appLabel = (typeof appName !== 'undefined' && appName) ? appName : 'Classic Trip';
    const requestPath = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
    const rootUrl = String(cfg.siteUrl || '').replace(/\/+$/, '');
    const canonicalPath = pageSeo.canonicalPath || requestPath || '/';
    const canonicalUrl = pageSeo.canonicalUrl || (rootUrl ? `${rootUrl}${canonicalPath === '/' ? '/' : canonicalPath}` : canonicalPath);
    const title = pageSeo.title || cfg.defaultTitle || appLabel;
    const description = pageSeo.description || cfg.defaultDescription || 'Classic Trip multi-service travel marketplace across East Africa.';
    const defaultImage = rootUrl ? `${rootUrl}/images/launch-lockup-512.png` : '/images/launch-lockup-512.png';
    const imageUrl = pageSeo.image || cfg.defaultImage || defaultImage;
    const imageAlt = pageSeo.imageAlt || `${appLabel} travel marketplace`;
    const organizationSchema = {
      '@type': 'TravelAgency',
      '@id': `${rootUrl || canonicalUrl}#organization`,
      name: appLabel,
      url: rootUrl || canonicalUrl,
      logo: defaultImage,
      image: imageUrl,
      areaServed: ['Uganda','Kenya','Rwanda','Tanzania','South Sudan','Burundi','Somalia','Democratic Republic of the Congo'],
    };
    const websiteSchema = {
      '@type': 'WebSite',
      '@id': `${rootUrl || canonicalUrl}#website`,
      name: appLabel,
      url: rootUrl || canonicalUrl,
      publisher: { '@id': `${rootUrl || canonicalUrl}#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${rootUrl || ''}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    };
    const suppliedSchemas = Array.isArray(pageSeo.schema) ? pageSeo.schema : [pageSeo.schema || { '@type': 'WebPage', name: title, description, url: canonicalUrl }];
    const normalizedSchemas = suppliedSchemas.filter(Boolean).map((item) => {
      const clean = item['@context'] ? Object.fromEntries(Object.entries(item).filter(([key]) => key !== '@context')) : { ...item };
      if (!clean.url && ['WebPage','CollectionPage','Service','TravelAgency','BlogPosting'].includes(String(clean['@type'] || ''))) clean.url = canonicalUrl;
      return clean;
    });
    const breadcrumbItems = Array.isArray(pageSeo.breadcrumbs) ? pageSeo.breadcrumbs.filter((item) => item && item.name) : [];
    const breadcrumbSchema = breadcrumbItems.length > 1 ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: /^https?:\/\//i.test(String(item.url || '')) ? item.url : `${rootUrl || ''}${String(item.url || canonicalPath).startsWith('/') ? String(item.url || canonicalPath) : `/${item.url || canonicalPath}`}`,
      })),
    } : null;
    const schema = { '@context': 'https://schema.org', '@graph': [organizationSchema, websiteSchema, ...normalizedSchemas, ...(breadcrumbSchema ? [breadcrumbSchema] : [])] };
    const schemaJson = toScriptJson(schema);
  %>
  <title><%= title %></title>
  <meta name="description" content="<%= description %>" />
  <meta name="author" content="Classic Technologies" />
  <meta name="application-name" content="<%= appLabel %>" />
  <link rel="canonical" href="<%= canonicalUrl %>" />
  <meta name="robots" content="<%= pageSeo.robots || 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' %>" />
  <% if (cfg.googleSiteVerification) { %><meta name="google-site-verification" content="<%= cfg.googleSiteVerification %>" /><% } %>
  <% if (cfg.bingSiteVerification) { %><meta name="msvalidate.01" content="<%= cfg.bingSiteVerification %>" /><% } %>
  <meta property="og:site_name" content="<%= appLabel %>" />
  <meta property="og:locale" content="en_UG" />
  <meta property="og:type" content="<%= pageSeo.type || 'website' %>" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= description %>" />
  <meta property="og:url" content="<%= canonicalUrl %>" />
  <meta property="og:image" content="<%= imageUrl %>" />
  <meta property="og:image:alt" content="<%= imageAlt %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="<%= description %>" />
  <meta name="twitter:image" content="<%= imageUrl %>" />
  <meta name="twitter:image:alt" content="<%= imageAlt %>" />
  <meta name="theme-color" content="#070a12" />
  <script nonce="<%= cspNonce %>">try{const t=localStorage.getItem('classicTripTheme')||localStorage.getItem('ct-theme')||localStorage.getItem('ct_auth_theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch(_){}</script>
  <meta name="csrf-token" content="<%= csrfToken || '' %>" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable public summary" />
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="AI-readable public catalog" />
  <link rel="alternate" type="application/json" href="/ai-index.json" title="AI-readable public catalog JSON" />
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
  <link rel="stylesheet" href="/css/pwa.css?v=1.6.38" />
  <link rel="stylesheet" href="/css/pages/home.css?v=1.6.38">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages/search.css">
  <link rel="stylesheet" href="/css/pages/booking.css">
  <link rel="stylesheet" href="/css/four-service-ui.css?v=20260726-reference-merge-1">
  <script nonce="<%= cspNonce %>" type="application/ld+json"><%- schemaJson %></script>
  <script src="/js/csrf.js?v=20260722-3" defer></script>
  <script src="/js/page-actions.js" defer></script>
  <script src="/js/mobile-navigation.js?v=20260727-1" defer></script>
  <script src="/js/pwa.js?v=20260727-final-speed-1" defer></script>
  <link rel="stylesheet" href="/css/completion-fixes.css?v=1.6.38">
  <link rel="stylesheet" href="/css/marketing-responsive.css?v=20260727-1">
  <link rel="stylesheet" href="/css/accessibility-safe.css?v=20260726-reference-ui-1">
  <script src="/js/external-styles-idle.js?v=1.6.38" data-styles="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" defer></script>
</head>
<body class="sitePage<%= (typeof bodyClass !== 'undefined' && bodyClass) ? ` ${String(bodyClass).replace(/[^a-zA-Z0-9_-]/g, '')}` : '' %>">
<%- include('site-flash') %>
