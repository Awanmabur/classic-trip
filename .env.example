APP_NAME=Classic Trip
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
SITE_URL=http://localhost:5000

MONGO_URI=mongodb://127.0.0.1:27017/classic-trip
# Recommended for Atlas URIs that do not include a database path.
MONGO_DB_NAME=classic-trip
# Production requires a MongoDB replica set or Atlas cluster; standalone MongoDB is rejected.
MONGO_TRANSACTIONS=true
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_POOL_SIZE=24
MONGO_MAX_CONNECTING=4
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=2500
MONGO_SERVER_SELECTION_TIMEOUT_MS=4000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=15000
MONGO_QUERY_MAX_TIME_MS=5000
MONGO_CONNECT_RETRY_ATTEMPTS=5
MONGO_CONNECT_RETRY_DELAY_MS=750
# Atlas supports IPv4; this avoids slow/broken IPv6 selection on some Windows networks.
MONGO_IP_FAMILY=4
# Keep runtime index building off. Run `npm run db:indexes` once after model/index changes.
MONGO_AUTO_INDEX=false
# Recommended in production. Redis removes sessions, login counters and shared
# request rate limits from the MongoDB connection pool.
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
REDIS_PREFIX=classic-trip:
REDIS_CONNECT_TIMEOUT_MS=4000
SESSION_SECRET=change_this_to_a_long_random_secret
# Temporarily disabled. Set true later to require authenticator MFA for all platform admins.
PLATFORM_MFA_ENABLED=false
MFA_ENCRYPTION_KEY=change_this_to_a_different_long_random_secret
MFA_SESSION_MAX_AGE_MINUTES=720

# Performance caches. Successful writes invalidate them automatically.
DASHBOARD_SNAPSHOT_TTL_MS=60000
DASHBOARD_SNAPSHOT_STALE_MS=1800000
DASHBOARD_DB_READ_CONCURRENCY=8
MONGO_READ_QUEUE_TIMEOUT_MS=1200
MONGO_READ_CONCURRENCY=10
HOME_CACHE_TTL_MS=300000
HOME_CACHE_STALE_MS=1800000
HOME_VIEW_CACHE_TTL_MS=60000
HOME_VIEW_CACHE_STALE_MS=600000

# Development terminal stays quiet by default. Enable only when diagnosing a slow route.
LOG_LEVEL=warn
LOG_SLOW_REQUESTS=false
SLOW_REQUEST_THRESHOLD_MS=2000

SUPER_ADMIN_EMAIL=superadmin@classictrip.com
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_admin_password
SUPER_ADMIN_NAME=Classic Trip Super Admin
# Must be different from every partner, promoter, staff, driver and customer phone.
SUPER_ADMIN_PHONE=+256700000001

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=classic-trip
MAX_UPLOAD_SIZE_MB=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Configure one live payment provider. Pesapal is the default integration.
PAYMENT_PROVIDER=pesapal
PAYMENT_WEBHOOK_SECRET=change_this_webhook_secret
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:5000/booking/payment/callback
PAYMENT_IPN_URL=http://localhost:5000/api/webhooks/payments

PESAPAL_API_URL=https://pay.pesapal.com/v3/api
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=http://localhost:5000/booking/payment/callback
PESAPAL_IPN_URL=http://localhost:5000/api/webhooks/payments
PESAPAL_IPN_ID=
PESAPAL_WEBHOOK_SECRET=
PESAPAL_NOTIFICATION_TYPE=POST

MTN_MOMO_API_URL=
MTN_MOMO_REFUND_URL=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_WEBHOOK_SECRET=

AIRTEL_MONEY_API_URL=
AIRTEL_MONEY_REFUND_URL=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_CALLBACK_URL=
AIRTEL_MONEY_WEBHOOK_SECRET=

FLUTTERWAVE_API_URL=
FLUTTERWAVE_REFUND_URL=
FLUTTERWAVE_API_KEY=
FLUTTERWAVE_CALLBACK_URL=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_API_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_REFUND_URL=https://api.paystack.co/refund
PAYSTACK_API_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_WEBHOOK_SECRET=

DPO_API_URL=
DPO_REFUND_URL=
DPO_API_KEY=
DPO_CALLBACK_URL=
DPO_WEBHOOK_SECRET=



# Real local-mobility maps and road routing.
# Use a production-grade OSRM/Valhalla/Mapbox-compatible routing service in production.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_DEFAULT_LATITUDE=0.3476
MAP_DEFAULT_LONGITUDE=32.5825
MAP_DEFAULT_ZOOM=12
TAXI_ROUTING_API_URL=https://router.project-osrm.org
TAXI_ROUTING_PROFILE=driving
TAXI_ROUTING_TIMEOUT_MS=8000
TAXI_REQUIRE_LIVE_ROUTING=false

EMAIL_FROM=no-reply@classictrip.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=Classic Trip

WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_URL=
WHATSAPP_FROM=Classic Trip

PUSH_ENABLED=true
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:support@classictrip.com

SEO_DEFAULT_TITLE=Classic Trip | East Africa travel marketplace
SEO_DEFAULT_DESCRIPTION=Book verified buses, hotels, flights and local taxi rides across East Africa with Classic Trip.
SEO_DEFAULT_IMAGE=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SEO_ALLOW_AI_SEARCH=true
SEO_ALLOW_AI_TRAINING=false
INDEXNOW_KEY=
SEO_EXTRA_URLS=

ENABLE_JOBS=false
JOB_PROCESS_OUTBOX=*/10 * * * * *
JOB_CLEANUP_EXPIRED_LOCKS=*/5 * * * *
JOB_EXPIRE_PAYMENT_INTENTS=*/5 * * * *
JOB_RELEASE_COMMISSION=*/10 * * * *
JOB_BOOKING_REMINDERS=*/15 * * * *
JOB_EXPIRE_PROMOTIONS=*/30 * * * *
JOB_DISPATCH_TAXI_RIDES=* * * * *
JOB_EXPIRE_FLIGHT_HOLDS=*/2 * * * *
JOB_PAYOUT_REPORTS=0 6 * * *
JOB_MATERIALIZE_SCHEDULES=*/15 * * * *
JOB_PURGE_ARCHIVED_RECORDS=30 4 * * *

# Keep true for one-service/local deployments. Set false only when a separate worker service runs.
RUN_BACKGROUND_WORKER=true
# Set true only when this web process has no dedicated worker. Keep false for Render/separate-worker deployments.
WEB_ROLLING_FALLBACK=false

# Fast shared/public listing preview cache
LISTING_SNAPSHOT_TTL_MS=300000
LISTING_SNAPSHOT_STALE_MS=1800000

# Background worker circuit breakers
JOB_MAX_RUN_MS=45000
OUTBOX_BATCH_SIZE=8
