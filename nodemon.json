{
  "watch": ["src", "public"],
  "ext": "js,ejs,json,css",
  "ignore": [
    "src/seeds/**",
    "src/**/*.test.js",
    "tests/**",
    "scripts/**",
    "public/uploads/**",
    "public/generated/**",
    "logs/**"
  ],
  "delay": 350,
  "legacyWatch": true,
  "quiet": true,
  "signal": "SIGTERM",
  "restartable": "rs"
}
